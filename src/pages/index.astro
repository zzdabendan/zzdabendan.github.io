---
import BaseLayout from '../layouts/BaseLayout.astro';

// 关于页摘要
const aboutSummary = [
	{ label: '意向岗位', value: 'xxx' },
	{ label: '意向城市', value: '南昌' },
	{ label: '期望薪资', value: '￥9999' },
	{ label: '求职类型', value: '全职' },
];
const workCount = 5;
const eduSchool = '江西信息应用职业技术学院';

// 感悟页摘要（最新一条）
const latestReflection = {
	date: '2026/09/07',
	day: '周一',
	weather: '晴',
	insight: '向前走。阿巴阿巴',
};
const reflectionCount = 23;

// 计划页摘要
const planPhases = [
	{ phase: '短期', goal: '每天做好基础饮食与肌肉运动' },
	{ phase: '中期', goal: '坚持 30 天，观察身体指数变化' },
	{ phase: '长期', goal: '坚持到质变，身材明显改善' },
];

// 物品页摘要
const financeSummary = [
	{ label: '欠款', value: '￥0' },
	{ label: '月收入', value: '￥4100' },
	{ label: '存款', value: '￥2331' },
];
const itemCategories = ['随身物品', '出行物品', '收纳物品', '家具物品'];

// 知识库页摘要
const kbArticles = [
	{ title: 'Astro 框架基础', category: '前端' },
	{ title: 'Git 版本管理入门', category: '工具' },
	{ title: 'Linux 网络基础', category: '运维' },
];
---

<BaseLayout title="ZZ · 个人成长志" description="从历史中借智，在当下解决问题">
	<!-- 半屏英雄区：左头像，右今日提问 -->
	<section class="hero">
		<div class="hero-avatar">
			<img src="/avatar.svg" alt="个人头像" class="avatar-img" width="200" height="200" />
			<p>这里是个人形象</p>
		</div>
		<div class="hero-question">
			<h2>今天该做什么？</h2>
			<p>每一天，解决一个真实的生活问题</p>
			<p id="now-time" class="hero-time"></p>
		</div>
	</section>

	<!-- 三栏内容展示 -->
	<section class="cards">
		<!-- 左栏：关于 -->
		<a href="/about" class="card">
			<div class="card-head">
				<span class="card-icon">关于</span>
				<span class="card-arrow">→</span>
			</div>
			<dl class="card-list">
				{aboutSummary.map((item) => (
					<div class="card-list-row">
						<dt>{item.label}</dt>
						<dd>{item.value}</dd>
					</div>
				))}
			</dl>
			<p class="card-meta">{workCount} 段工作经历 · {eduSchool}</p>
		</a>

		<!-- 中栏：感悟 -->
		<a href="/reflections" class="card">
			<div class="card-head">
				<span class="card-icon">感悟</span>
				<span class="card-arrow">→</span>
			</div>
			<div class="card-date">{latestReflection.date} {latestReflection.day} · {latestReflection.weather}</div>
			<p class="card-insight">{latestReflection.insight}</p>
			<p class="card-meta">共 {reflectionCount} 条感悟记录</p>
		</a>

		<!-- 右栏：计划 -->
		<a href="/plan" class="card">
			<div class="card-head">
				<span class="card-icon">计划</span>
				<span class="card-arrow">→</span>
			</div>
			<ul class="card-phases">
				{planPhases.map((p) => (
					<li>
						<span class="phase-tag">{p.phase}</span>
						<span class="phase-goal">{p.goal}</span>
					</li>
				))}
			</ul>
			<p class="card-meta">当前主题：运动</p>
		</a>

		<!-- 物品（第二行，占一半宽） -->
		<a href="/items" class="card card-wide">
			<div class="card-head">
				<span class="card-icon">物品</span>
				<span class="card-arrow">→</span>
			</div>
			<dl class="card-list">
				{financeSummary.map((item) => (
					<div class="card-list-row">
						<dt>{item.label}</dt>
						<dd>{item.value}</dd>
					</div>
				))}
			</dl>
			<div class="tag-row">
				{itemCategories.map((c) => (
					<span class="mini-tag">{c}</span>
				))}
			</div>
			<p class="card-meta">4 类物品 · 含财务记录</p>
		</a>

		<!-- 知识库（第二行，占一半宽） -->
		<a href="/kb" class="card card-wide">
			<div class="card-head">
				<span class="card-icon">知识库</span>
				<span class="card-arrow">→</span>
			</div>
			<ul class="article-mini">
				{kbArticles.map((a) => (
					<li>
						<span class="mini-cat">{a.category}</span>
						<span class="article-title">{a.title}</span>
					</li>
				))}
			</ul>
			<p class="card-meta">共 5 篇文章 · 4 个分类</p>
		</a>
	</section>
</BaseLayout>

<style is:global>
	.container { --content-width: 1100px; }
</style>

<style>
	/* ===== 半屏英雄区（全宽通栏） ===== */
	.hero {
		position: relative;
		width: 100vw;
		margin-left: calc(-50vw + 50%);
		margin-top: -48px;
		height: 50vh;
		min-height: 340px;
		background: #f9fafb;
		border-bottom: 1px solid var(--line);
		display: flex;
	}

	.hero-avatar {
		width: 60%;
		height: 100%;
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		gap: 16px;
	}

	.avatar-img {
		width: 200px;
		height: 200px;
		border-radius: 50%;
	}

	.hero-avatar p {
		font-size: 14px;
		color: var(--muted);
	}

	.hero-question {
		width: 40%;
		height: 100%;
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		text-align: center;
		padding: 0 24px;
	}

	.hero-question h2 {
		font-size: 32px;
		font-weight: 700;
		color: #111111;
	}

	.hero-question p {
		font-size: 14px;
		color: var(--muted);
		margin-top: 8px;
	}

	.hero-time {
		font-family: 'Courier New', monospace;
		font-size: 15px;
		color: #111111;
	}

	/* ===== 内容卡片：6 列网格，前 3 个各占 2 列，后 2 个各占 3 列 ===== */
	.cards {
		display: grid;
		grid-template-columns: repeat(6, 1fr);
		gap: 48px;
		padding-top: 56px;
		padding-bottom: 24px;
	}

	.card:nth-child(-n+3) {
		grid-column: span 2;
	}

	.card-wide {
		grid-column: span 3;
	}

	.card {
		display: flex;
		flex-direction: column;
	}

	.card-head {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		margin-bottom: 16px;
		padding-bottom: 10px;
		border-bottom: 1px solid var(--line);
	}

	.card-icon {
		font-size: 18px;
		font-weight: 700;
		color: #111111;
	}

	.card-arrow {
		font-size: 16px;
		color: #bbbbbb;
		transition: transform 0.2s, color 0.2s;
	}

	.card:hover .card-arrow {
		transform: translateX(4px);
		color: #111111;
	}

	.card:hover .card-icon {
		text-decoration: underline;
		text-underline-offset: 4px;
	}

	/* 关于栏 */
	.card-list {
		margin: 0 0 12px;
	}

	.card-list-row {
		display: flex;
		justify-content: space-between;
		font-size: 14px;
		padding: 3px 0;
	}

	.card-list-row dt {
		color: var(--muted);
	}

	.card-list-row dd {
		font-weight: 600;
		color: #333333;
	}

	/* 感悟栏 */
	.card-date {
		font-size: 13px;
		color: var(--muted);
		margin-bottom: 8px;
	}

	.card-insight {
		font-size: 15px;
		line-height: 1.7;
		margin-bottom: 12px;
		flex-grow: 1;
		color: #444444;
	}

	/* 计划栏 */
	.card-phases {
		list-style: none;
		padding: 0;
		margin: 0 0 12px;
	}

	.card-phases li {
		display: flex;
		gap: 8px;
		align-items: baseline;
		font-size: 14px;
		padding: 4px 0;
	}

	.phase-tag {
		flex-shrink: 0;
		padding: 1px 8px;
		border: 1px solid #cccccc;
		border-radius: 2px;
		color: #555555;
		font-size: 12px;
		font-weight: 600;
	}

	.phase-goal {
		color: #444444;
	}

	.card-meta {
		font-size: 13px;
		color: var(--muted);
		margin-top: auto;
		padding-top: 12px;
		border-top: 1px dashed var(--line);
	}

	/* 物品标签组 */
	.tag-row {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
		margin-bottom: 12px;
	}

	.mini-tag {
		padding: 2px 8px;
		border: 1px solid #cccccc;
		border-radius: 2px;
		font-size: 12px;
		color: #555555;
	}

	/* 知识库文章小列表 */
	.article-mini {
		list-style: none;
		padding: 0;
		margin: 0 0 12px;
		flex-grow: 1;
	}

	.article-mini li {
		display: flex;
		align-items: baseline;
		gap: 8px;
		padding: 5px 0;
		font-size: 14px;
	}

	.mini-cat {
		flex-shrink: 0;
		padding: 1px 6px;
		border: 1px solid #dddddd;
		border-radius: 2px;
		font-size: 11px;
		color: #888888;
	}

	.article-title {
		color: #444444;
	}

	@media (max-width: 900px) {
		.hero {
			height: auto;
			min-height: 0;
			flex-direction: column;
			padding: 48px 20px;
			gap: 24px;
		}

		.hero-avatar,
		.hero-question {
			width: 100%;
			height: auto;
		}

		.avatar-img {
			width: 140px;
			height: 140px;
		}

		.hero-question h2 {
			font-size: 24px;
		}

		.cards {
			grid-template-columns: 1fr;
			gap: 40px;
		}

		.card:nth-child(-n+3),
		.card-wide {
			grid-column: span 1;
		}
	}
</style>

<script>
	// 实时显示当前时间，每分钟更新
	function updateTime() {
		const el = document.getElementById('now-time');
		if (!el) return;
		const now = new Date();
		const y = now.getFullYear();
		const m = String(now.getMonth() + 1).padStart(2, '0');
		const d = String(now.getDate()).padStart(2, '0');
		const days = ['日', '一', '二', '三', '四', '五', '六'];
		const w = days[now.getDay()];
		const h = String(now.getHours()).padStart(2, '0');
		const min = String(now.getMinutes()).padStart(2, '0');
		el.textContent = `${y}-${m}-${d} 周${w} ${h}:${min}`;
	}
	updateTime();
	setInterval(updateTime, 60000);
</script>
