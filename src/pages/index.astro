---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="欢迎" description="邹兆廷的个人主页">
	<!-- 英雄区两栏：左头像，中时间+提问（首页特有） -->
	<section class="hero">
		<div class="hero-avatar">
			<img src="/avatar.svg" alt="个人头像" class="avatar-img" width="240" height="240" />
		</div>
		<div class="hero-question">
			<div class="title-row">
				<p id="now-time" class="hero-time"></p>
				<h2>是否存在一件事，让所有人都开心</h2>
			</div>
			<div class="search-box">
				<input
					type="text"
					id="deepseek-input"
					class="search-input"
					placeholder="每一天，解决一个真实的生活问题"
				/>
				<button class="search-btn" onclick="goDeepSeek()">提问</button>
			</div>
		</div>
	</section>

	<!-- 能量链独立一栏：三条链横排并排 -->
	<section class="energy-rail">
		<div class="energy-group">
			<p class="energy-domain">个人</p>
			<div class="energy-chain">
				<span>自律</span><span>信任</span><span>职位</span><span>资本</span><span>传播</span><span>权力</span>
			</div>
			<p class="energy-note">每级换一种杠杆，本质是能调动多少人的时间与能量</p>
		</div>
		<div class="energy-group">
			<p class="energy-domain">国家间</p>
			<div class="energy-chain">
				<span>徒手</span><span>石器</span><span>铁器</span><span>热武器</span><span>机械化</span><span>智能化</span>
			</div>
			<p class="energy-note">每跨一级近乎碾压，本质是能量投送 × 信息控制</p>
		</div>
		<div class="energy-group">
			<p class="energy-domain">自然界</p>
			<div class="energy-chain">
				<span>太阳能</span><span>植物固定</span><span>食草动物</span><span>食肉动物</span><span>顶级捕食者</span>
			</div>
			<p class="energy-note">每级损失 90%，残骸由分解者回收循环</p>
		</div>
	</section>

	<!-- 需求阶梯：按年龄段逐行排列，读法自低龄向高龄 -->
	<section class="need-rail">
		<div class="need-inner">
			<p class="energy-domain">需求</p>
			<ul class="need-list">
				<li>10 岁以内的孩子，需要有人理解</li>
				<li>10-20 岁的孩子，需要认同</li>
				<li>20-30 岁的孩子，需要机会</li>
				<li>30-40 岁的人，需要肯定和赞美</li>
				<li>40-50 岁的人，需要尊敬</li>
				<li>50-60 岁的人，需要晚辈的敬佩</li>
				<li>60 岁以上的人，需要晚辈的崇拜</li>
			</ul>
		</div>
	</section>
</BaseLayout>

<style>
	/* ===== 英雄区（全宽通栏，首页特有） ===== */
	.hero {
		width: 100vw;
		margin-left: calc(-50vw + 50%);
		margin-top: -48px;
		margin-bottom: -48px;
		min-height: calc(100vh - 112px);
		display: flex;
	}

	.hero-avatar {
		flex: 1;
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		padding: 24px 0;
	}

	.avatar-img {
		width: 240px;
		height: 240px;
		border-radius: 50%;
	}

	/* 能量链独立一栏：三条链横排并排，放在 hero 下方；通栏突破 720px 容器 */
	.energy-rail {
		width: 100vw;
		margin-left: calc(-50vw + 50%);
		display: flex;
		justify-content: center;
		gap: 60px;
		padding: 24px 40px 48px;
		flex-wrap: wrap;
	}

	.energy-group {
		flex: 1;
		min-width: 220px;
		max-width: 340px;
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 8px;
	}

	/* 领域标签：标明链条所属层面 */
	.energy-domain {
		font-size: 11px;
		color: #9ca3af;
		letter-spacing: 0.3em;
		margin: 0;
	}

	/* DOM 从低到高书写，row 保持左低右高 */
	.energy-chain {
		display: flex;
		flex-direction: row;
		align-items: center;
		flex-wrap: wrap;
		gap: 6px 0;
	}

	.energy-chain span {
		font-size: 13px;
		color: #333333;
		line-height: 1.6;
	}

	/* 每层文字前的向右箭头 */
	.energy-chain span::before {
		content: "→";
		color: #c0c4cc;
		margin-right: 6px;
	}

	.energy-note {
		font-size: 12px;
		line-height: 1.6;
		color: var(--muted);
		margin: 0;
	}

	/* 需求阶梯：与能量链同宽对齐，逐行读 */
	.need-rail {
		width: 100vw;
		margin-left: calc(-50vw + 50%);
		display: flex;
		justify-content: center;
		padding: 0 40px 64px;
	}

	.need-inner {
		width: 100%;
		max-width: 720px;
		display: flex;
		flex-direction: column;
		gap: 12px;
	}

	.need-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
	}

	.need-list li {
		font-size: 14px;
		line-height: 1.7;
		color: #333333;
		padding: 8px 0;
		border-bottom: 1px dashed var(--line);
	}

	.need-list li:last-child {
		border-bottom: none;
	}

	.hero-question {
		flex: 1;
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		padding: 0 24px;
	}

	/* 时间与标题同一行，样式一致 */
	.title-row {
		display: flex;
		align-items: center;
		gap: 16px;
		flex-wrap: wrap;
	}

	.hero-question h2,
	.hero-time {
		font-size: 32px;
		font-weight: 700;
		color: #111111;
		margin: 0;
		border-bottom: none;
		padding-bottom: 0;
	}

	/* 搜索输入框 */
	.search-box {
		display: flex;
		gap: 8px;
		margin-top: 16px;
		width: 100%;
		max-width: 320px;
	}

	.search-input {
		flex: 1;
		padding: 10px 14px;
		font-size: 14px;
		border: 1px solid var(--line);
		border-radius: 6px;
		background: #ffffff;
		outline: none;
		transition: border-color 0.15s;
	}

	.search-input:focus {
		border-color: #9ca3af;
	}

	.search-input::placeholder {
		color: #9ca3af;
	}

	.search-btn {
		padding: 10px 20px;
		font-size: 14px;
		font-weight: 500;
		color: #ffffff;
		background: #111111;
		border: none;
		border-radius: 6px;
		cursor: pointer;
		transition: background 0.15s;
		white-space: nowrap;
	}

	.search-btn:hover {
		background: #333333;
	}

	@media (max-width: 900px) {
		.hero {
			min-height: 0;
			flex-direction: column;
			padding: 48px 20px;
			gap: 24px;
		}

		.hero-avatar,
		.hero-question {
			width: 100%;
		}

		/* 手机端：三条能量链改为上下堆叠 */
		.energy-rail {
			flex-direction: column;
			gap: 24px;
			padding: 0 20px 32px;
		}

		.energy-group {
			min-width: 0;
			max-width: none;
		}

		.need-rail {
			padding: 0 20px 48px;
		}

		.avatar-img {
			width: 140px;
			height: 140px;
		}

		.hero-question h2,
		.hero-time {
			font-size: 24px;
		}
	}
</style>

<script is:inline>
	// 实时显示当前时间，每分钟更新
	function updateTime() {
		const el = document.getElementById('now-time');
		if (!el) return;
		const now = new Date();
		const y = now.getFullYear();
		const m = String(now.getMonth() + 1).padStart(2, '0');
		const d = String(now.getDate()).padStart(2, '0');
		const days = ['日', '一', '二', '三', '四', '五', '六'];
		const w = days[now.getDay()];
		const h = String(now.getHours()).padStart(2, '0');
		const min = String(now.getMinutes()).padStart(2, '0');
		el.textContent = `${y}-${m}-${d} 周${w} ${h}:${min}`;
	}

	// 跳转 DeepSeek 搜索
	function goDeepSeek() {
		const input = document.getElementById('deepseek-input');
		const q = input.value.trim();
		if (!q) return;
		window.open(`https://www.deepseek.com/search?q=${encodeURIComponent(q)}`, '_blank');
		input.value = '';
	}

	window.addEventListener('DOMContentLoaded', () => {
		updateTime();
		setInterval(updateTime, 60000);

		// 回车触发搜索
		const input = document.getElementById('deepseek-input');
		if (input) {
			input.addEventListener('keydown', (e) => {
				if (e.key === 'Enter') goDeepSeek();
			});
		}
	});
</script>
