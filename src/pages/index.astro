---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="欢迎" description="邹兆廷的个人主页" bare>
	<!-- 英雄区两栏：左头像，中时间+提问（首页特有） -->
	<section class="hero">
		<div class="hero-avatar">
			<img src="/avatar.svg" alt="个人头像" class="avatar-img" width="240" height="240" />
		</div>
		<div class="hero-question">
			<div class="title-row">
				<h2>你好 ^_^</h2>
			</div>
		</div>
	</section>

	<!-- 能量链独立一栏：三条链各占一行居中 -->
	<section class="energy-rail">
		<div class="energy-group">
			<p class="energy-line"><span class="energy-key">个人层</span>：自律 → 信任 → 职位 → 资本 → 传播 → 权力</p>
			<p class="energy-desc">每级换一种杠杆，本质是能调动多少人的时间与能量</p>
		</div>
		<div class="energy-group">
			<p class="energy-line"><span class="energy-key">国家间</span>：徒手 → 石器 → 铁器 → 热武器 → 机械化 → 智能化</p>
			<p class="energy-desc">每跨一级近乎碾压，本质是能量投送 × 信息控制</p>
		</div>
		<div class="energy-group">
			<p class="energy-line"><span class="energy-key">自然界</span>：太阳能 → 植物固定 → 食草动物 → 食肉动物 → 顶级捕食者</p>
			<p class="energy-desc">每级损失 90%，残骸由分解者回收循环</p>
		</div>
	</section>

	<!-- 手上的牌：个人资本的三张牌 -->
	<section class="hand-rail">
		<div class="hand-grid">
			<div class="hand-card">
				<p class="hand-head">银牌 · 能力</p>
				<p class="hand-desc">能独立交付出来的东西：手艺、经验、拿得出手的产出。</p>
			</div>
			<div class="hand-card">
				<p class="hand-head">金牌 · 人脉</p>
				<p class="hand-desc">能调动的人：不是认识多少，而是多少人愿意为你出手。</p>
			</div>
			<div class="hand-card">
				<p class="hand-head">王牌 · 思维</p>
				<p class="hand-desc">看清一件事的方式：同样一副牌，决定怎么打、先出哪张。</p>
				<p class="hand-desc">智慧，知日，日知，彗星，心。</p>
			</div>
		</div>
	</section>

	<!-- 漩涡：中心一点，外围一圈漩涡，单独一行收尾 -->
	<section class="swirl-rail" aria-hidden="true">
		<svg class="swirl" viewBox="0 0 120 120" role="presentation" focusable="false">
			<circle class="swirl-dot" cx="60" cy="60" r="4.5" />
			<path class="swirl-line" d="M67.5 60.0L67.9 61.4L68.0 62.9L67.8 64.5L67.3 66.1L66.4 67.7L65.2 69.1L63.8 70.3L62.0 71.3L60.0 72.0L57.8 72.3L55.6 72.2L53.3 71.7L51.0 70.7L48.9 69.3L47.0 67.5L45.5 65.3L44.3 62.8L43.5 60.0L43.3 57.1L43.6 54.0L44.5 51.0L45.9 48.1L47.8 45.5L50.3 43.2L53.2 41.3L56.5 39.9L60.0 39.1L63.7 38.9L67.5 39.4L71.2 40.6L74.7 42.4L77.9 44.9L80.7 48.0L82.9 51.7L84.5 55.7L85.4 60.0L85.5 64.5L84.8 69.0L83.3 73.4L81.0 77.6L77.9 81.4L74.2 84.6L69.9 87.1L65.1 88.9L60.0 89.9L54.7 89.9L49.4 89.0L44.3 87.2L39.5 84.4L35.2 80.8L31.5 76.4L28.6 71.4L26.7 65.9L25.6 60.0L25.7 53.9L26.8 47.9L29.0 42.1L32.2 36.6L36.3 31.8L41.3 27.7L47.1 24.4L53.3 22.2L60.0 21.2L66.8 21.3L73.6 22.6L80.2 25.1L86.2 28.7L91.7 33.4L96.2 39.1L99.8 45.5L102.2 52.6L103.3 60.0" />
			<path class="swirl-line" d="M67.5 60.0L67.9 61.4L68.0 62.9L67.8 64.5L67.3 66.1L66.4 67.7L65.2 69.1L63.8 70.3L62.0 71.3L60.0 72.0L57.8 72.3L55.6 72.2L53.3 71.7L51.0 70.7L48.9 69.3L47.0 67.5L45.5 65.3L44.3 62.8L43.5 60.0L43.3 57.1L43.6 54.0L44.5 51.0L45.9 48.1L47.8 45.5L50.3 43.2L53.2 41.3L56.5 39.9L60.0 39.1L63.7 38.9L67.5 39.4L71.2 40.6L74.7 42.4L77.9 44.9L80.7 48.0L82.9 51.7L84.5 55.7L85.4 60.0L85.5 64.5L84.8 69.0L83.3 73.4L81.0 77.6L77.9 81.4L74.2 84.6L69.9 87.1L65.1 88.9L60.0 89.9L54.7 89.9L49.4 89.0L44.3 87.2L39.5 84.4L35.2 80.8L31.5 76.4L28.6 71.4L26.7 65.9L25.6 60.0L25.7 53.9L26.8 47.9L29.0 42.1L32.2 36.6L36.3 31.8L41.3 27.7L47.1 24.4L53.3 22.2L60.0 21.2L66.8 21.3L73.6 22.6L80.2 25.1L86.2 28.7L91.7 33.4L96.2 39.1L99.8 45.5L102.2 52.6L103.3 60.0" transform="rotate(180 60 60)" />
		</svg>
	</section>
</BaseLayout>

<style>
	/* ===== 英雄区（全宽通栏，首页特有） ===== */
	.hero {
		position: relative;
		width: 100vw;
		margin-left: calc(-50vw + 50%);
		margin-top: -48px;
		height: min(58svh, 640px);
		min-height: 420px;
		overflow: hidden;
		display: flex;
	}

	/* 头像铺满整个英雄区，作为全屏背景 */
	.hero-avatar {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
	}

	.avatar-img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: contain;
		border-radius: 0;
		/* 缩小整体，避免人形过大 */
		transform: translateX(-5%) scale(0.72);
		transform-origin: center center;
	}

	/* 能量链独立一栏：三条链各占一行居中，放在 hero 下方；通栏突破 720px 容器 */
	.energy-rail {
		width: 100vw;
		margin-left: calc(-50vw + 50%);
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 14px;
		padding: 14px 40px 20px;
	}

	.energy-group {
		flex: 0 0 auto;
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		gap: 2px;
	}

	/* 领域、链条、注释统一为同一套正文样式 */
	.energy-group p {
		font-size: 13px;
		line-height: 1.5;
		color: #333333;
		margin: 0;
	}

	.energy-key {
		font-weight: 600;
		color: #111111;
	}

	.energy-desc {
		color: #6b7280;
	}

	/* 手上的牌：与能量链同一栏宽，基本字体 */
	.hand-rail {
		width: 100vw;
		margin-left: calc(-50vw + 50%);
		padding: 4px 40px 28px;
	}

	.hand-grid {
		display: flex;
		justify-content: center;
		gap: 36px;
	}

	.hand-head {
		font-size: 13px;
		font-weight: 600;
		color: #111111;
		margin: 0 0 4px;
	}

	.hand-desc {
		font-size: 13px;
		line-height: 1.6;
		color: #6b7280;
		margin: 0;
	}

	/* 漩涡：单独一行居中收尾 */
	.swirl-rail {
		width: 100vw;
		margin-left: calc(-50vw + 50%);
		padding: 12px 0 56px;
		display: flex;
		justify-content: center;
	}

	.swirl {
		display: block;
		width: 128px;
		height: 128px;
	}

	.swirl-dot {
		fill: #333333;
	}

	.swirl-line {
		fill: none;
		stroke: #c4c8ce;
		stroke-width: 1.4;
		stroke-linecap: round;
	}

	.hero-question {
		position: relative;
		z-index: 2;
		width: 100%;
		height: 100%;
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		padding: 0 24px;
	}

	/* 时间与标题同一行，样式一致 */
	.title-row {
		display: flex;
		align-items: center;
		gap: 16px;
		flex-wrap: wrap;
		justify-content: center;
	}

	.hero-question h2,
	.hero-time {
		font-size: 32px;
		font-weight: 700;
		color: #111111;
		margin: 0;
		border-bottom: none;
		padding-bottom: 0;
	}

	/* 桌面端：整页恰好一屏，hero 弹性占据剩余空间 */
	@media (min-width: 901px) {
		:global(body) {
			min-height: 100vh;
			display: flex;
			flex-direction: column;
		}

		/* 覆盖 BaseLayout 的 min-height，让内容区吃掉剩余高度 */
		:global(main.container) {
			flex: 1;
			min-height: 0 !important;
			display: flex;
			flex-direction: column;
		}
	}

	@media (max-width: 900px) {
		.hero {
			height: calc(100svh - 120px);
			min-height: 420px;
		}

		/* 手机端：三条能量链改为上下堆叠，链条允许换行 */
		.energy-rail {
			flex-direction: column;
			gap: 24px;
			padding: 0 20px 32px;
		}

		/* 手机端：三张牌上下堆叠 */
		.hand-rail {
			padding: 0 20px 32px;
		}

		.hand-grid {
			flex-direction: column;
			gap: 12px;
		}

		.hero-question h2,
		.hero-time {
			width: 100%;
			font-size: 22px;
			line-height: 1.5;
			text-align: center;
			overflow-wrap: anywhere;
		}

		/* 手机端文字改为上下两行，避免横向溢出 */
		.title-row {
			width: 100%;
			max-width: 100%;
			flex-direction: column;
			gap: 8px;
		}
	}
</style>
