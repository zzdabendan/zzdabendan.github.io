---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="欢迎" description="从历史中借智，在当下解决问题">
	<!-- 半屏英雄区：左头像，右今日提问（首页特有） -->
	<section class="hero">
		<div class="hero-avatar">
			<img src="/avatar.svg" alt="个人头像" class="avatar-img" width="240" height="240" />
			<div class="gear-icon">
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100" width="56" height="56">
					<!-- 外层齿轮 -->
					<g fill="#d1d5db">
						<path d="M50 10 L55 10 L57 20 L65 22 L72 15 L76 18 L72 28 L78 34 L88 32 L90 36 L82 42 L84 50 L94 52 L94 58 L84 60 L82 68 L90 74 L88 78 L78 76 L72 82 L76 92 L72 95 L65 88 L57 90 L55 100 L50 100 L48 90 L40 88 L33 95 L29 92 L33 82 L27 76 L17 78 L15 74 L23 68 L21 60 L11 58 L11 52 L21 50 L23 42 L15 36 L17 32 L27 34 L33 28 L29 18 L33 15 L40 22 L48 20 Z"/>
					</g>
					<!-- 内层齿轮 -->
					<g fill="#9ca3af">
						<circle cx="50" cy="50" r="18"/>
						<circle cx="50" cy="50" r="8" fill="#faf8f5"/>
					</g>
				</svg>
			</div>
		</div>
		<div class="hero-question">
			<div class="title-row">
				<p id="now-time" class="hero-time"></p>
				<h2>今天想做什么？</h2>
			</div>
			<div class="search-box">
				<input
					type="text"
					id="deepseek-input"
					class="search-input"
					placeholder="每一天，解决一个真实的生活问题"
				/>
				<button class="search-btn" onclick="goDeepSeek()">提问</button>
			</div>
		</div>
	</section>

	<!-- 极简欢迎页：hero 之下仅一句站点引言，其余交给导航 -->
		<section class="welcome">
			<div class="welcome-map">
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1000 500" width="500" height="250">
					<g stroke="#9ca3af" stroke-width="1" fill="#e5e7eb" opacity="0.5">
						<!-- 北美洲 -->
						<path d="M 150 130 Q 200 90 260 100 Q 300 120 320 170 Q 300 230 260 250 Q 200 240 170 190 Z"/>
						<!-- 格陵兰 -->
						<path d="M 280 60 Q 320 50 340 80 Q 330 120 300 110 Z"/>
						<!-- 南美洲 -->
						<path d="M 240 290 Q 280 270 300 310 Q 320 380 280 430 Q 240 410 230 350 Z"/>
						<!-- 非洲 -->
						<path d="M 460 200 Q 520 180 560 220 Q 580 290 540 360 Q 480 380 440 320 Z"/>
						<!-- 欧洲 -->
						<path d="M 460 110 Q 510 90 550 120 Q 560 170 520 190 Q 470 180 450 150 Z"/>
						<!-- 亚洲 -->
						<path d="M 580 90 Q 680 60 800 80 Q 880 110 860 190 Q 830 260 730 240 Q 630 220 590 160 Z"/>
						<!-- 大洋洲 -->
						<path d="M 800 340 Q 860 320 900 360 Q 910 410 860 430 Q 810 410 800 360 Z"/>
						<!-- 东南亚群岛 -->
						<circle cx="780" cy="300" r="8"/>
						<circle cx="810" cy="320" r="6"/>
						<circle cx="760" cy="330" r="7"/>
						<!-- 日本 -->
						<path d="M 860 180 Q 870 200 860 220 Q 850 200 860 180 Z"/>
						<!-- 英国 -->
						<path d="M 460 100 Q 470 90 480 100 Q 475 115 465 110 Z"/>
					</g>
				</svg>
			</div>
			<p>从历史中借智，在当下解决问题。</p>
		</section>
</BaseLayout>

<style>
	/* ===== 半屏英雄区（全宽通栏，首页特有） ===== */
	.hero {
		position: relative;
		width: 100vw;
		margin-left: calc(-50vw + 50%);
		margin-top: -48px;
		height: 50vh;
		min-height: 340px;
		background: #f9fafb;
		border-bottom: 1px solid var(--line);
		display: flex;
	}

	.hero-avatar {
		width: 60%;
		height: 100%;
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		gap: 16px;
	}

	.avatar-img {
		width: 240px;
		height: 240px;
		border-radius: 50%;
	}

	.hero-avatar p {
		font-size: 14px;
		color: var(--muted);
	}

	.hero-question {
		width: 40%;
		height: 100%;
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		text-align: center;
		padding: 0 24px;
	}

	.hero-question h2 {
		font-size: 32px;
		font-weight: 700;
		color: #111111;
		border-bottom: none;
		padding-bottom: 0;
	}

	.hero-question p {
		font-size: 14px;
		color: var(--muted);
		margin-top: 8px;
	}

	/* 时间与标题同一行 */
	.title-row {
		display: flex;
		align-items: center;
		gap: 16px;
		justify-content: center;
	}

	.hero-time {
		font-family: 'Courier New', monospace;
		font-size: 15px;
		color: #111111;
		margin: 0;
	}

	/* 搜索输入框 */
	.search-box {
		display: flex;
		gap: 8px;
		margin-top: 16px;
		width: 100%;
		max-width: 320px;
	}

	.search-input {
		flex: 1;
		padding: 10px 14px;
		font-size: 14px;
		border: 1px solid var(--line);
		border-radius: 6px;
		background: #ffffff;
		outline: none;
		transition: border-color 0.15s;
	}

	.search-input:focus {
		border-color: #9ca3af;
	}

	.search-input::placeholder {
		color: #9ca3af;
	}

	.search-btn {
		padding: 10px 20px;
		font-size: 14px;
		font-weight: 500;
		color: #ffffff;
		background: #111111;
		border: none;
		border-radius: 6px;
		cursor: pointer;
		transition: background 0.15s;
		white-space: nowrap;
	}

	.search-btn:hover {
		background: #333333;
	}

	/* ===== 站点引言：撑满 hero 以下剩余视口，居中成满屏构图 ===== */
	.welcome {
		position: relative;
		min-height: calc(50vh - 64px); /* 视口高度 - hero半屏 - 导航64px */
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		padding: 40px 20px;
		gap: 24px;
	}

	.welcome-map {
		opacity: 0.5;
	}

	.welcome p {
		font-size: 15px;
		color: #333333;
		letter-spacing: 0.05em;
	}

	@media (max-width: 900px) {
		.hero {
			height: auto;
			min-height: 0;
			flex-direction: column;
			padding: 48px 20px;
			gap: 24px;
		}

		.hero-avatar,
		.hero-question {
			width: 100%;
			height: auto;
		}

		.avatar-img {
			width: 140px;
			height: 140px;
		}

		.hero-question h2 {
			font-size: 24px;
		}

		.welcome {
			min-height: auto;
			padding: 48px 20px;
		}
	}
</style>

<script is:inline>
		// 实时显示当前时间，每分钟更新
		function updateTime() {
			const el = document.getElementById('now-time');
			if (!el) return;
			const now = new Date();
			const y = now.getFullYear();
			const m = String(now.getMonth() + 1).padStart(2, '0');
			const d = String(now.getDate()).padStart(2, '0');
			const days = ['日', '一', '二', '三', '四', '五', '六'];
			const w = days[now.getDay()];
			const h = String(now.getHours()).padStart(2, '0');
			const min = String(now.getMinutes()).padStart(2, '0');
			el.textContent = `${y}-${m}-${d} 周${w} ${h}:${min}`;
		}

		// 跳转 DeepSeek 搜索
		function goDeepSeek() {
			const input = document.getElementById('deepseek-input');
			const q = input.value.trim();
			if (!q) return;
			window.open(`https://www.deepseek.com/search?q=${encodeURIComponent(q)}`, '_blank');
			input.value = '';
		}

		window.addEventListener('DOMContentLoaded', () => {
			updateTime();
			setInterval(updateTime, 60000);

			// 回车触发搜索
			const input = document.getElementById('deepseek-input');
			if (input) {
				input.addEventListener('keydown', (e) => {
					if (e.key === 'Enter') goDeepSeek();
				});
			}
		});
	</script>
