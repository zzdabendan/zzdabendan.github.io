---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="欢迎" description="从历史中借智，在当下解决问题">
	<!-- 半屏英雄区：左头像，右今日提问（首页特有） -->
	<section class="hero">
		<div class="hero-avatar">
			<img src="/avatar.svg" alt="个人头像" class="avatar-img" width="200" height="200" />
			<p>这里是个人形象</p>
		</div>
		<div class="hero-question">
			<h2>今天想做什么？</h2>
			<div class="search-box">
				<input
					type="text"
					id="deepseek-input"
					class="search-input"
					placeholder="每一天，解决一个真实的生活问题"
				/>
				<button class="search-btn" onclick="goDeepSeek()">提问</button>
			</div>
			<p id="now-time" class="hero-time"></p>
		</div>
	</section>

	<!-- 极简欢迎页：hero 之下仅一句站点引言，其余交给导航 -->
	<section class="welcome">
		<p>从历史中借智，在当下解决问题。</p>
	</section>
</BaseLayout>

<style>
	/* ===== 半屏英雄区（全宽通栏，首页特有） ===== */
	.hero {
		position: relative;
		width: 100vw;
		margin-left: calc(-50vw + 50%);
		margin-top: -48px;
		height: 50vh;
		min-height: 340px;
		background: #f9fafb;
		border-bottom: 1px solid var(--line);
		display: flex;
	}

	.hero-avatar {
		width: 60%;
		height: 100%;
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		gap: 16px;
	}

	.avatar-img {
		width: 200px;
		height: 200px;
		border-radius: 50%;
	}

	.hero-avatar p {
		font-size: 14px;
		color: var(--muted);
	}

	.hero-question {
		width: 40%;
		height: 100%;
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		text-align: center;
		padding: 0 24px;
	}

	.hero-question h2 {
		font-size: 32px;
		font-weight: 700;
		color: #111111;
		border-bottom: none;
		padding-bottom: 0;
	}

	.hero-question p {
		font-size: 14px;
		color: var(--muted);
		margin-top: 8px;
	}

	.hero-time {
		font-family: 'Courier New', monospace;
		font-size: 15px;
		color: #111111;
	}

	/* 搜索输入框 */
	.search-box {
		display: flex;
		gap: 8px;
		margin-top: 16px;
		width: 100%;
		max-width: 320px;
	}

	.search-input {
		flex: 1;
		padding: 10px 14px;
		font-size: 14px;
		border: 1px solid var(--line);
		border-radius: 6px;
		background: #ffffff;
		outline: none;
		transition: border-color 0.15s;
	}

	.search-input:focus {
		border-color: #9ca3af;
	}

	.search-input::placeholder {
		color: #9ca3af;
	}

	.search-btn {
		padding: 10px 20px;
		font-size: 14px;
		font-weight: 500;
		color: #ffffff;
		background: #111111;
		border: none;
		border-radius: 6px;
		cursor: pointer;
		transition: background 0.15s;
		white-space: nowrap;
	}

	.search-btn:hover {
		background: #333333;
	}

	/* ===== 站点引言：撑满 hero 以下剩余视口，居中成满屏构图 ===== */
	.welcome {
		position: relative;
		min-height: calc(50vh - 64px); /* 视口高度 - hero半屏 - 导航64px */
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 40px 20px;
	}

	.welcome::before {
		content: '';
		position: absolute;
		top: 50%;
		left: 50%;
		transform: translate(-50%, -50%);
		width: 700px;
		height: 350px;
		background: url('/world-map.svg') no-repeat center;
		background-size: contain;
		opacity: 0.15;
		pointer-events: none;
		z-index: 0;
	}

	.welcome p {
		position: relative;
		z-index: 1;
		font-size: 15px;
		color: #333333;
		letter-spacing: 0.05em;
	}

	@media (max-width: 900px) {
		.hero {
			height: auto;
			min-height: 0;
			flex-direction: column;
			padding: 48px 20px;
			gap: 24px;
		}

		.hero-avatar,
		.hero-question {
			width: 100%;
			height: auto;
		}

		.avatar-img {
			width: 140px;
			height: 140px;
		}

		.hero-question h2 {
			font-size: 24px;
		}

		.welcome {
			min-height: auto;
			padding: 48px 20px;
		}
	}
</style>

<script is:inline>
		// 实时显示当前时间，每分钟更新
		function updateTime() {
			const el = document.getElementById('now-time');
			if (!el) return;
			const now = new Date();
			const y = now.getFullYear();
			const m = String(now.getMonth() + 1).padStart(2, '0');
			const d = String(now.getDate()).padStart(2, '0');
			const days = ['日', '一', '二', '三', '四', '五', '六'];
			const w = days[now.getDay()];
			const h = String(now.getHours()).padStart(2, '0');
			const min = String(now.getMinutes()).padStart(2, '0');
			el.textContent = `${y}-${m}-${d} 周${w} ${h}:${min}`;
		}

		// 跳转 DeepSeek 搜索
		function goDeepSeek() {
			const input = document.getElementById('deepseek-input');
			const q = input.value.trim();
			if (!q) return;
			window.open(`https://www.deepseek.com/search?q=${encodeURIComponent(q)}`, '_blank');
			input.value = '';
		}

		window.addEventListener('DOMContentLoaded', () => {
			updateTime();
			setInterval(updateTime, 60000);

			// 回车触发搜索
			const input = document.getElementById('deepseek-input');
			if (input) {
				input.addEventListener('keydown', (e) => {
					if (e.key === 'Enter') goDeepSeek();
				});
			}
		});
	</script>
