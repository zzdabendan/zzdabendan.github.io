---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="欢迎" description="邹兆廷的个人主页" bare>
	<!-- 英雄区两栏：左头像，中时间+提问（首页特有） -->
	<section class="hero">
		<div class="hero-avatar">
			<img src="/avatar.svg" alt="个人头像" class="avatar-img" width="240" height="240" />
		</div>
		<div class="hero-question">
			<div class="title-row">
				<h1>你好 ^_^</h1>
			</div>
			<div class="hero-search">
				<input
					type="text"
					id="deepseek-input"
					class="search-input"
					placeholder="是否存在一件事，让所有人都开心"
				/>
				<button class="search-btn" onclick="goDeepSeek()">提问</button>
			</div>
		</div>
	</section>

	<!-- 人物轮廓：单独一行居中收尾 -->
	<section class="figure-rail" aria-hidden="true">
		<svg class="figure" viewBox="70 85 260 255" role="presentation" focusable="false">
			<circle class="figure-line" cx="200" cy="155" r="62" />
			<path class="figure-line" d="M80 330 C80 264 134 225 200 225 C266 225 320 264 320 330 Z" />
		</svg>
	</section>
</BaseLayout>

<script is:inline>
	// 跳转 DeepSeek 搜索
	function goDeepSeek() {
		const input = document.getElementById('deepseek-input');
		if (!input) return;
		const q = input.value.trim();
		if (!q) return;
		window.open(`https://www.deepseek.com/search?q=${encodeURIComponent(q)}`, '_blank');
		input.value = '';
	}

	// 回车触发搜索
	document.addEventListener('DOMContentLoaded', () => {
		const input = document.getElementById('deepseek-input');
		if (!input) return;
		input.addEventListener('keydown', (e) => {
			if (e.key === 'Enter') goDeepSeek();
		});
	});
</script>

<style>
	/* ===== 英雄区（全宽通栏，首页特有） ===== */
	.hero {
		position: relative;
		width: 100vw;
		margin-left: calc(-50vw + 50%);
		margin-top: -48px;
		height: min(58svh, 640px);
		min-height: 420px;
		overflow: hidden;
		display: flex;
	}

	/* 头像铺满整个英雄区，作为全屏背景 */
	.hero-avatar {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
	}

	.avatar-img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: contain;
		border-radius: 0;
		/* 缩小整体，避免人形过大 */
		transform: translateX(-5%) scale(0.72);
		transform-origin: center center;
	}

	/* 人物轮廓：单独一行居中收尾 */
	.figure-rail {
		width: 100vw;
		margin-left: calc(-50vw + 50%);
		padding: 12px 0 56px;
		display: flex;
		justify-content: center;
	}

	.figure {
		display: block;
		width: 112px;
		height: 110px;
	}

	.figure-line {
		fill: none;
		stroke: #b9bec5;
		stroke-width: 4;
		stroke-linejoin: round;
	}

	.hero-question {
		position: relative;
		z-index: 2;
		width: 100%;
		height: 100%;
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		padding: 0 24px;
	}

	/* 标题行：水平居中 */
	.title-row {
		display: flex;
		align-items: center;
		gap: 16px;
		flex-wrap: wrap;
		justify-content: center;
	}

	/* 页面标题：一级标题 28px（全站规范） */
	.hero-question h1 {
		font-size: 28px;
		font-weight: 700;
		line-height: 1.5;
		color: #111111;
		margin: 0;
		border-bottom: none;
		padding-bottom: 0;
	}

	/* 提问框：首页英雄区，标题下方居中 */
	.hero-search {
		display: flex;
		gap: 8px;
		width: 340px;
		max-width: 100%;
		margin-top: 24px;
	}

	.search-input {
		flex: 1;
		min-width: 0;
		padding: 8px 12px;
		font-size: 14px;
		border: 1px solid var(--line);
		border-radius: 6px;
		background: #ffffff;
		outline: none;
		transition: border-color 0.15s;
	}

	.search-input:focus {
		border-color: #9ca3af;
	}

	.search-input::placeholder {
		color: #9ca3af;
	}

	.search-btn {
		padding: 8px 16px;
		font-size: 14px;
		font-weight: 500;
		color: #ffffff;
		background: #111111;
		border: none;
		border-radius: 6px;
		cursor: pointer;
		transition: background 0.15s;
		white-space: nowrap;
	}

	.search-btn:hover {
		background: #333333;
	}

	/* 桌面端：整页恰好一屏，hero 弹性占据剩余空间 */
	@media (min-width: 901px) {
		:global(body) {
			min-height: 100vh;
			display: flex;
			flex-direction: column;
		}

		/* 覆盖 BaseLayout 的 min-height，让内容区吃掉剩余高度 */
		:global(main.container) {
			flex: 1;
			min-height: 0 !important;
			display: flex;
			flex-direction: column;
		}
	}

	@media (max-width: 900px) {
		.hero {
			height: calc(100svh - 120px);
			min-height: 420px;
		}

		.hero-question h1 {
			width: 100%;
			font-size: 28px;
			line-height: 1.5;
			text-align: center;
			overflow-wrap: anywhere;
		}

		/* 手机端提问框占满可用宽度 */
		.hero-search {
			width: 100%;
		}

		/* 手机端文字改为上下两行，避免横向溢出 */
		.title-row {
			width: 100%;
			max-width: 100%;
			flex-direction: column;
			gap: 8px;
		}
	}
</style>
