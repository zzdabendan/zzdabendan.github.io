---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="欢迎" description="邹兆廷的个人主页" bare>
	<!-- 英雄区两栏：左头像，中时间+提问（首页特有） -->
	<section class="hero">
		<div class="hero-avatar">
			<img src="/avatar.svg" alt="个人头像" class="avatar-img" width="240" height="240" />
		</div>
		<div class="hero-question">
			<div class="title-row">
				<h2>你好 ^_^</h2>
			</div>
		</div>
	</section>

	<!-- 能量链独立一栏：三条链横排并排 -->
	<section class="energy-rail">
		<div class="energy-group">
			<p>个人（每级换一种杠杆，本质是能调动多少人的时间与能量）</p>
			<p class="energy-chain">自律 → 信任 → 职位 → 资本 → 传播 → 权力</p>
		</div>
		<div class="energy-group">
			<p>国家间（每跨一级近乎碾压，本质是能量投送 × 信息控制）</p>
			<p class="energy-chain">徒手 → 石器 → 铁器 → 热武器 → 机械化 → 智能化</p>
		</div>
		<div class="energy-group">
			<p>自然界（每级损失 90%，残骸由分解者回收循环）</p>
			<p class="energy-chain">太阳能 → 植物固定 → 食草动物 → 食肉动物 → 顶级捕食者</p>
		</div>
	</section>

	<!-- 手上的牌：个人资本的三张牌 -->
	<section class="hand-rail">
		<p class="hand-label">手上的牌</p>
		<div class="hand-grid">
			<div class="hand-card">
				<p class="hand-head"><span class="hand-rank rank-silver">银牌</span>能力</p>
				<p class="hand-desc">能独立交付出来的东西：手艺、经验、拿得出手的产出。</p>
			</div>
			<div class="hand-card">
				<p class="hand-head"><span class="hand-rank rank-gold">金牌</span>人脉</p>
				<p class="hand-desc">能调动的人：不是认识多少，而是多少人愿意为你出手。</p>
			</div>
			<div class="hand-card">
				<p class="hand-head"><span class="hand-rank rank-ace">王牌</span>思维</p>
				<p class="hand-desc">看清一件事的方式：同样一副牌，决定怎么打、先出哪张。</p>
			</div>
		</div>
	</section>
</BaseLayout>

<style>
	/* ===== 英雄区（全宽通栏，首页特有） ===== */
	.hero {
		position: relative;
		width: 100vw;
		margin-left: calc(-50vw + 50%);
		margin-top: -48px;
		height: min(58svh, 640px);
		min-height: 420px;
		overflow: hidden;
		display: flex;
	}

	/* 头像铺满整个英雄区，作为全屏背景 */
	.hero-avatar {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
	}

	.avatar-img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: contain;
		border-radius: 0;
		/* 缩小整体，避免人形过大 */
		transform: translateX(-5%) scale(0.72);
		transform-origin: center center;
	}

	/* 能量链独立一栏：三条链横排并排，放在 hero 下方；通栏突破 720px 容器 */
	.energy-rail {
		width: 100vw;
		margin-left: calc(-50vw + 50%);
		display: flex;
		justify-content: center;
		align-items: flex-start;
		gap: 36px;
		padding: 14px 40px 20px;
		flex-wrap: wrap;
	}

	.energy-group {
		flex: 0 0 auto;
		display: flex;
		flex-direction: column;
		gap: 2px;
	}

	/* 领域、链条、注释统一为同一套正文样式 */
	.energy-group p {
		font-size: 13px;
		line-height: 1.5;
		color: #333333;
		margin: 0;
	}

	.energy-chain {
		white-space: nowrap;
	}

	/* 手上的牌：与能量链同一栏宽，三张牌并排 */
	.hand-rail {
		width: 100vw;
		margin-left: calc(-50vw + 50%);
		padding: 4px 40px 28px;
	}

	.hand-label {
		font-size: 13px;
		font-weight: 600;
		color: #6b7280;
		text-align: center;
		margin: 0 0 10px;
	}

	.hand-grid {
		display: flex;
		justify-content: center;
		align-items: stretch;
		gap: 16px;
		flex-wrap: wrap;
	}

	.hand-card {
		flex: 1 1 240px;
		max-width: 340px;
		padding: 10px 14px;
		background: #fafafa;
		border: 1px solid #e5e7eb;
		border-radius: 8px;
	}

	.hand-head {
		display: flex;
		align-items: center;
		gap: 8px;
		font-size: 14px;
		font-weight: 600;
		color: #111111;
		margin: 0 0 4px;
	}

	.hand-rank {
		font-size: 12px;
		font-weight: 600;
		line-height: 1.6;
		padding: 0 6px;
		border-radius: 4px;
	}

	.rank-silver {
		background: #eef0f3;
		border: 1px solid #dcdfe4;
		color: #6b7280;
	}

	.rank-gold {
		background: #fbf1d8;
		border: 1px solid #eddcb4;
		color: #96702a;
	}

	.rank-ace {
		background: #eae4fb;
		border: 1px solid #d8cdf3;
		color: #6b4fbb;
	}

	.hand-desc {
		font-size: 13px;
		line-height: 1.6;
		color: #4b5563;
		margin: 0;
	}

	.hero-question {
		position: relative;
		z-index: 2;
		width: 100%;
		height: 100%;
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		padding: 0 24px;
	}

	/* 时间与标题同一行，样式一致 */
	.title-row {
		display: flex;
		align-items: center;
		gap: 16px;
		flex-wrap: wrap;
		justify-content: center;
	}

	.hero-question h2,
	.hero-time {
		font-size: 32px;
		font-weight: 700;
		color: #111111;
		margin: 0;
		border-bottom: none;
		padding-bottom: 0;
	}

	/* 桌面端：整页恰好一屏，hero 弹性占据剩余空间 */
	@media (min-width: 901px) {
		:global(body) {
			min-height: 100vh;
			display: flex;
			flex-direction: column;
		}

		/* 覆盖 BaseLayout 的 min-height，让内容区吃掉剩余高度 */
		:global(main.container) {
			flex: 1;
			min-height: 0 !important;
			display: flex;
			flex-direction: column;
		}
	}

	@media (max-width: 900px) {
		.hero {
			height: calc(100svh - 120px);
			min-height: 420px;
		}

		/* 手机端：三条能量链改为上下堆叠，链条允许换行 */
		.energy-rail {
			flex-direction: column;
			gap: 24px;
			padding: 0 20px 32px;
		}

		.energy-chain {
			white-space: normal;
		}

		/* 手机端：三张牌上下堆叠 */
		.hand-rail {
			padding: 0 20px 32px;
		}

		.hand-card {
			flex: 1 1 100%;
			max-width: none;
		}

		.hero-question h2,
		.hero-time {
			width: 100%;
			font-size: 22px;
			line-height: 1.5;
			text-align: center;
			overflow-wrap: anywhere;
		}

		/* 手机端文字改为上下两行，避免横向溢出 */
		.title-row {
			width: 100%;
			max-width: 100%;
			flex-direction: column;
			gap: 8px;
		}
	}
</style>
