---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="欢迎" description="邹兆廷的个人主页">
	<!-- 英雄区两栏：左头像，中时间+提问（首页特有） -->
	<section class="hero">
		<div class="hero-avatar">
			<img src="/avatar.svg" alt="个人头像" class="avatar-img" width="240" height="240" />
		</div>
		<div class="hero-question">
			<div class="title-row">
				<p id="now-time" class="hero-time"></p>
				<h2>是否存在一件事，让所有人都开心 ^_^</h2>
			</div>
		</div>
	</section>

	<!-- 能量链独立一栏：三条链横排并排 -->
	<section class="energy-rail">
		<div class="energy-group">
			<p>个人</p>
			<p class="energy-chain">自律 → 信任 → 职位 → 资本 → 传播 → 权力</p>
			<p>每级换一种杠杆，本质是能调动多少人的时间与能量</p>
		</div>
		<div class="energy-group">
			<p>国家间</p>
			<p class="energy-chain">徒手 → 石器 → 铁器 → 热武器 → 机械化 → 智能化</p>
			<p>每跨一级近乎碾压，本质是能量投送 × 信息控制</p>
		</div>
		<div class="energy-group">
			<p>自然界</p>
			<p class="energy-chain">太阳能 → 植物固定 → 食草动物 → 食肉动物 → 顶级捕食者</p>
			<p>每级损失 90%，残骸由分解者回收循环</p>
		</div>
	</section>

	<!-- 黄帝内经人体阶段：男八女七，男左女右两栏 -->
	<section class="stage-rail">
		<div class="stage-group">
			<p>男（八岁一节）</p>
			<p>八岁（1×8）：肾气实，发长齿更</p>
			<p>十六岁（2×8）：肾气盛，天癸至，精气溢泻，阴阳和，故能有子</p>
			<p>二十四岁（3×8）：肾气平均，筋骨劲强，故真牙生而长极</p>
			<p>三十二岁（4×8）：筋骨隆盛，肌肉满壮</p>
			<p>四十岁（5×8）：肾气衰，发堕齿槁</p>
			<p>四十八岁（6×8）：阳气衰竭于上，面焦，发鬓颁白</p>
			<p>五十六岁（7×8）：肝气衰，筋不能动，天癸竭，精少，肾脏衰，形体皆极</p>
			<p>六十四岁（8×8）：齿发去</p>
		</div>
		<div class="stage-group">
			<p>女（七岁一节）</p>
			<p>七岁（1×7）：肾气盛，齿更发长</p>
			<p>十四岁（2×7）：天癸至，任脉通，太冲脉盛，月事以时下，故有子</p>
			<p>二十一岁（3×7）：肾气平均，故真牙生而长极</p>
			<p>二十八岁（4×7）：筋骨坚，发长极，身体盛壮</p>
			<p>三十五岁（5×7）：阳明脉衰，面始焦，发始堕</p>
			<p>四十二岁（6×7）：三阳脉衰于上，面皆焦，发始白</p>
			<p>四十九岁（7×7）：任脉虚，太冲脉衰少，天癸竭，地道不通，故形坏而无子也</p>
		</div>
	</section>
</BaseLayout>

<style>
	/* ===== 英雄区（全宽通栏，首页特有） ===== */
	.hero {
		width: 100vw;
		margin-left: calc(-50vw + 50%);
		margin-top: -48px;
		margin-bottom: -48px;
		min-height: calc(100vh - 112px);
		display: flex;
	}

	.hero-avatar {
		flex: 1;
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		padding: 24px 0;
	}

	.avatar-img {
		width: 240px;
		height: 240px;
		border-radius: 50%;
	}

	/* 能量链独立一栏：三条链横排并排，放在 hero 下方；通栏突破 720px 容器 */
	.energy-rail {
		width: 100vw;
		margin-left: calc(-50vw + 50%);
		display: flex;
		justify-content: center;
		align-items: flex-start;
		gap: 48px;
		padding: 24px 40px 48px;
		flex-wrap: wrap;
	}

	.energy-group {
		flex: 0 0 auto;
		display: flex;
		flex-direction: column;
		gap: 4px;
	}

	/* 领域、链条、注释统一为同一套正文样式 */
	.energy-group p {
		font-size: 13px;
		line-height: 1.8;
		color: #333333;
		margin: 0;
	}

	.energy-chain {
		white-space: nowrap;
	}

	/* 黄帝内经人体阶段：男左女右两栏，沿用能量链的正文样式 */
	.stage-rail {
		width: 100vw;
		margin-left: calc(-50vw + 50%);
		display: flex;
		justify-content: center;
		align-items: flex-start;
		gap: 48px;
		padding: 0 40px 48px;
		flex-wrap: wrap;
	}

	.stage-group {
		flex: 0 1 560px;
		display: flex;
		flex-direction: column;
		gap: 2px;
	}

	.stage-group p {
		font-size: 13px;
		line-height: 1.8;
		color: #333333;
		margin: 0;
	}

	.hero-question {
		flex: 1;
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		padding: 0 24px;
	}

	/* 时间与标题同一行，样式一致 */
	.title-row {
		display: flex;
		align-items: center;
		gap: 16px;
		flex-wrap: wrap;
	}

	.hero-question h2,
	.hero-time {
		font-size: 32px;
		font-weight: 700;
		color: #111111;
		margin: 0;
		border-bottom: none;
		padding-bottom: 0;
	}

	/* 桌面端：整页恰好一屏，hero 弹性占据剩余空间 */
	@media (min-width: 901px) {
		:global(body) {
			min-height: 100vh;
			display: flex;
			flex-direction: column;
		}

		/* 覆盖 BaseLayout 的 min-height，让内容区吃掉剩余高度 */
		:global(main.container) {
			flex: 1;
			min-height: 0 !important;
			display: flex;
			flex-direction: column;
		}

		.hero {
			flex: 1;
			min-height: 0;
		}
	}

	@media (max-width: 900px) {
		.hero {
			min-height: 0;
			flex-direction: column;
			padding: 48px 20px;
			gap: 24px;
		}

		.hero-avatar,
		.hero-question {
			width: 100%;
		}

		/* 手机端：三条能量链改为上下堆叠，链条允许换行 */
		.energy-rail {
			flex-direction: column;
			gap: 24px;
			padding: 0 20px 32px;
		}

		.energy-chain {
			white-space: normal;
		}

		/* 手机端：男、女两栏改为上下堆叠 */
		.stage-rail {
			flex-direction: column;
			padding: 0 20px 32px;
		}

		.avatar-img {
			width: 140px;
			height: 140px;
		}

		.hero-question h2,
		.hero-time {
			font-size: 24px;
		}
	}
</style>

<script is:inline>
	// 实时显示当前时间，每秒更新
	function updateTime() {
		const el = document.getElementById('now-time');
		if (!el) return;
		const now = new Date();
		const y = now.getFullYear();
		const m = String(now.getMonth() + 1).padStart(2, '0');
		const d = String(now.getDate()).padStart(2, '0');
		const h = String(now.getHours()).padStart(2, '0');
		const min = String(now.getMinutes()).padStart(2, '0');
		const s = String(now.getSeconds()).padStart(2, '0');
		el.textContent = `时间：${y}-${m}-${d} ${h}:${min}:${s}`;
	}

	window.addEventListener('DOMContentLoaded', () => {
		updateTime();
		setInterval(updateTime, 1000);
	});
</script>
