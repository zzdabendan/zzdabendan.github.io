---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="欢迎" description="邹兆廷的个人主页" bare>
	<!-- 英雄区：标题与提问（首页特有） -->
	<section class="hero">
		<div class="hero-question">
			<div class="title-row">
				<h1>你好 ^_^</h1>
			</div>
			<div class="hero-search">
				<input
					type="text"
					id="deepseek-input"
					class="search-input"
					placeholder="是否存在一件事，让所有人都开心"
				/>
				<button class="search-btn" onclick="goDeepSeek()">提问</button>
			</div>
		</div>
	</section>

	<!-- 漩涡：中心一点，外围一圈漩涡，单独一行收尾 -->
	<section class="swirl-rail" aria-hidden="true">
		<svg class="swirl" viewBox="0 0 120 120" role="presentation" focusable="false">
			<circle class="swirl-dot" cx="60" cy="60" r="4.5" />
			<path class="swirl-line" d="M67.5 60.0L67.9 61.4L68.0 62.9L67.8 64.5L67.3 66.1L66.4 67.7L65.2 69.1L63.8 70.3L62.0 71.3L60.0 72.0L57.8 72.3L55.6 72.2L53.3 71.7L51.0 70.7L48.9 69.3L47.0 67.5L45.5 65.3L44.3 62.8L43.5 60.0L43.3 57.1L43.6 54.0L44.5 51.0L45.9 48.1L47.8 45.5L50.3 43.2L53.2 41.3L56.5 39.9L60.0 39.1L63.7 38.9L67.5 39.4L71.2 40.6L74.7 42.4L77.9 44.9L80.7 48.0L82.9 51.7L84.5 55.7L85.4 60.0L85.5 64.5L84.8 69.0L83.3 73.4L81.0 77.6L77.9 81.4L74.2 84.6L69.9 87.1L65.1 88.9L60.0 89.9L54.7 89.9L49.4 89.0L44.3 87.2L39.5 84.4L35.2 80.8L31.5 76.4L28.6 71.4L26.7 65.9L25.6 60.0L25.7 53.9L26.8 47.9L29.0 42.1L32.2 36.6L36.3 31.8L41.3 27.7L47.1 24.4L53.3 22.2L60.0 21.2L66.8 21.3L73.6 22.6L80.2 25.1L86.2 28.7L91.7 33.4L96.2 39.1L99.8 45.5L102.2 52.6L103.3 60.0" />
			<path class="swirl-line" d="M67.5 60.0L67.9 61.4L68.0 62.9L67.8 64.5L67.3 66.1L66.4 67.7L65.2 69.1L63.8 70.3L62.0 71.3L60.0 72.0L57.8 72.3L55.6 72.2L53.3 71.7L51.0 70.7L48.9 69.3L47.0 67.5L45.5 65.3L44.3 62.8L43.5 60.0L43.3 57.1L43.6 54.0L44.5 51.0L45.9 48.1L47.8 45.5L50.3 43.2L53.2 41.3L56.5 39.9L60.0 39.1L63.7 38.9L67.5 39.4L71.2 40.6L74.7 42.4L77.9 44.9L80.7 48.0L82.9 51.7L84.5 55.7L85.4 60.0L85.5 64.5L84.8 69.0L83.3 73.4L81.0 77.6L77.9 81.4L74.2 84.6L69.9 87.1L65.1 88.9L60.0 89.9L54.7 89.9L49.4 89.0L44.3 87.2L39.5 84.4L35.2 80.8L31.5 76.4L28.6 71.4L26.7 65.9L25.6 60.0L25.7 53.9L26.8 47.9L29.0 42.1L32.2 36.6L36.3 31.8L41.3 27.7L47.1 24.4L53.3 22.2L60.0 21.2L66.8 21.3L73.6 22.6L80.2 25.1L86.2 28.7L91.7 33.4L96.2 39.1L99.8 45.5L102.2 52.6L103.3 60.0" transform="rotate(180 60 60)" />
		</svg>
	</section>
</BaseLayout>

<script is:inline>
	// 跳转 DeepSeek 搜索
	function goDeepSeek() {
		const input = document.getElementById('deepseek-input');
		if (!input) return;
		const q = input.value.trim();
		if (!q) return;
		window.open(`https://www.deepseek.com/search?q=${encodeURIComponent(q)}`, '_blank');
		input.value = '';
	}

	// 回车触发搜索
	document.addEventListener('DOMContentLoaded', () => {
		const input = document.getElementById('deepseek-input');
		if (!input) return;
		input.addEventListener('keydown', (e) => {
			if (e.key === 'Enter') goDeepSeek();
		});
	});
</script>

<style>
	/* ===== 英雄区（全宽通栏，首页特有） ===== */
	.hero {
		position: relative;
		width: 100vw;
		margin-left: calc(-50vw + 50%);
		margin-top: -48px;
		height: min(58svh, 640px);
		min-height: 420px;
		overflow: hidden;
		display: flex;
	}

	/* 漩涡：单独一行居中收尾 */
	.swirl-rail {
		width: 100vw;
		margin-left: calc(-50vw + 50%);
		padding: 12px 0 56px;
		display: flex;
		justify-content: center;
	}

	.swirl {
		display: block;
		width: 128px;
		height: 128px;
	}

	.swirl-dot {
		fill: #333333;
	}

	.swirl-line {
		fill: none;
		stroke: #c4c8ce;
		stroke-width: 1.4;
		stroke-linecap: round;
	}

	.hero-question {
		position: relative;
		z-index: 2;
		width: 100%;
		height: 100%;
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		padding: 0 24px;
	}

	/* 标题行：水平居中 */
	.title-row {
		display: flex;
		align-items: center;
		gap: 16px;
		flex-wrap: wrap;
		justify-content: center;
	}

	/* 页面标题：一级标题 28px（全站规范） */
	.hero-question h1 {
		font-size: 28px;
		font-weight: 700;
		line-height: 1.5;
		color: #111111;
		margin: 0;
		border-bottom: none;
		padding-bottom: 0;
	}

	/* 提问框：首页英雄区，标题下方居中 */
	.hero-search {
		display: flex;
		gap: 8px;
		width: 340px;
		max-width: 100%;
		margin-top: 24px;
	}

	.search-input {
		flex: 1;
		min-width: 0;
		padding: 8px 12px;
		font-size: 14px;
		border: 1px solid var(--line);
		border-radius: 6px;
		background: #ffffff;
		outline: none;
		transition: border-color 0.15s;
	}

	.search-input:focus {
		border-color: #9ca3af;
	}

	.search-input::placeholder {
		color: #9ca3af;
	}

	.search-btn {
		padding: 8px 16px;
		font-size: 14px;
		font-weight: 500;
		color: #ffffff;
		background: #111111;
		border: none;
		border-radius: 6px;
		cursor: pointer;
		transition: background 0.15s;
		white-space: nowrap;
	}

	.search-btn:hover {
		background: #333333;
	}

	/* 桌面端：整页恰好一屏，hero 弹性占据剩余空间 */
	@media (min-width: 901px) {
		:global(body) {
			min-height: 100vh;
			display: flex;
			flex-direction: column;
		}

		/* 覆盖 BaseLayout 的 min-height，让内容区吃掉剩余高度 */
		:global(main.container) {
			flex: 1;
			min-height: 0 !important;
			display: flex;
			flex-direction: column;
		}
	}

	@media (max-width: 900px) {
		.hero {
			height: calc(100svh - 120px);
			min-height: 420px;
		}

		.hero-question h1 {
			width: 100%;
			font-size: 28px;
			line-height: 1.5;
			text-align: center;
			overflow-wrap: anywhere;
		}

		/* 手机端提问框占满可用宽度 */
		.hero-search {
			width: 100%;
		}

		/* 手机端文字改为上下两行，避免横向溢出 */
		.title-row {
			width: 100%;
			max-width: 100%;
			flex-direction: column;
			gap: 8px;
		}
	}
</style>
