---
// 页面数据：以后改内容，主要改这里
import BaseLayout from '../layouts/BaseLayout.astro';

const profile = {
	name: '你好，我是小明',
	bio: '一名正在学习 Astro 的初学者，在这里记录我的学习笔记和项目作品。',
	tags: ['Astro', '前端学习', '个人主页'],
};
---

<BaseLayout title="我的个人主页" description={profile.bio}>
	<section class="hero">
		<h1>{profile.name}</h1>
		<p class="bio">{profile.bio}</p>

		<ul class="tags">
			{profile.tags.map((tag) => <li>{tag}</li>)}
		</ul>

		<div class="actions">
			<a href="/about" class="btn">了解更多 →</a>
		</div>
	</section>
</BaseLayout>

<style>
	.hero {
		padding-top: 32px;
	}

	h1 {
		font-size: 40px;
		line-height: 1.3;
		margin-bottom: 16px;
	}

	.bio {
		font-size: 18px;
		color: var(--muted);
		margin-bottom: 24px;
	}

	.tags {
		list-style: none;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
		margin-bottom: 32px;
	}

	.tags li {
		font-size: 14px;
		padding: 4px 12px;
		border-radius: 999px;
		background: #f3e8ff;
		color: var(--accent);
	}

	.btn {
		display: inline-block;
		padding: 10px 20px;
		border-radius: 8px;
		background: var(--accent);
		color: #fff;
		font-size: 15px;
	}

	.btn:hover {
		opacity: 0.9;
		color: #fff;
	}
</style>
