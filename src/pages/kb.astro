---
import BaseLayout from '../layouts/BaseLayout.astro';

// 知识库文章数据：每篇含 id、标题、分类、HTML 内容
const articles = [
	{
		id: 'astro-basics',
		title: 'Astro 框架基础',
		category: '前端',
		summary: 'Astro 是现代静态站点生成器，适合博客、文档和个人主页。',
		content: `
<h2>什么是 Astro</h2>
<p>Astro 是一个面向内容的静态站点生成器，核心特点是"零 JavaScript 默认"——页面只加载必要的 HTML 和 CSS，交互按需引入。</p>

<h2>核心概念</h2>
<h3>组件</h3>
<p><code>.astro</code> 文件是 Astro 的基本单元，由三部分组成：frontmatter（代码栅栏）、HTML 模板、style 标签。</p>

<h3>路由</h3>
<p><code>src/pages/</code> 目录下的文件自动成为路由：<code>index.astro</code> → <code>/</code>，<code>about.astro</code> → <code>/about</code>。</p>

<h3>布局</h3>
<p>布局组件放在 <code>src/layouts/</code> 下，通过 <code>&lt;slot /&gt;</code> 接收页面内容，实现多页面共用外壳。</p>

<h2>常用命令</h2>
<h3>开发</h3>
<p><code>npm run dev</code> 启动开发服务器，支持热更新。</p>
<h3>构建</h3>
<p><code>npm run build</code> 生成静态文件到 <code>dist/</code> 目录。</p>
<h3>预览</h3>
<p><code>npm run preview</code> 本地预览构建产物。</p>
`,
	},
	{
		id: 'git-guide',
		title: 'Git 版本管理入门',
		category: '工具',
		summary: 'Git 是分布式版本控制系统，记录文件变更历史，支持分支协作。',
		content: `
<h2>什么是 Git</h2>
<p>Git 是一个分布式版本控制系统，用于跟踪文件变更、协作开发、回滚历史版本。</p>

<h2>基础操作</h2>
<h3>初始化仓库</h3>
<p><code>git init</code> 在当前目录创建一个 Git 仓库。</p>

<h3>添加文件</h3>
<p><code>git add 文件名</code> 将文件加入暂存区，<code>git add .</code> 添加所有变更。</p>

<h3>提交变更</h3>
<p><code>git commit -m "描述信息"</code> 将暂存区的变更提交到仓库。</p>

<h2>分支管理</h2>
<h3>查看分支</h3>
<p><code>git branch</code> 列出所有本地分支。</p>
<h3>切换分支</h3>
<p><code>git checkout 分支名</code> 切换到指定分支。</p>
<h3>合并分支</h3>
<p><code>git merge 分支名</code> 将指定分支合并到当前分支。</p>

<h2>远程仓库</h2>
<h3>克隆</h3>
<p><code>git clone 仓库地址</code> 从远程克隆仓库到本地。</p>
<h3>推送</h3>
<p><code>git push origin 分支名</code> 将本地提交推送到远程。</p>
<h3>拉取</h3>
<p><code>git pull</code> 从远程拉取最新变更并合并。</p>
`,
	},
	{
		id: 'linux-network',
		title: 'Linux 网络基础',
		category: '运维',
		summary: 'Linux 网络配置常用命令，含 ping、ifconfig、网络排查思路。',
		content: `
<h2>网络配置查看</h2>
<h3>查看 IP 地址</h3>
<p><code>ifconfig</code> 或 <code>ip addr</code> 查看网卡 IP 地址信息。</p>

<h3>查看路由</h3>
<p><code>route -n</code> 或 <code>ip route</code> 查看路由表。</p>

<h2>网络测试</h2>
<h3>ping 测试连通性</h3>
<p><code>ping 目标IP</code> 测试与目标主机的网络连通性。</p>

<h3>端口测试</h3>
<p><code>telnet 目标IP 端口</code> 或 <code>nc -zv 目标IP 端口</code> 测试端口是否开放。</p>

<h2>DNS 解析</h2>
<h3>查看 DNS</h3>
<p><code>nslookup 域名</code> 或 <code>dig 域名</code> 查询域名解析结果。</p>
<h3>修改 DNS</h3>
<p>编辑 <code>/etc/resolv.conf</code> 添加 <code>nameserver 8.8.8.8</code>。</p>

<h2>防火墙</h2>
<h3>查看规则</h3>
<p><code>iptables -L -n</code> 查看当前防火墙规则。</p>
<h3>开放端口</h3>
<p><code>iptables -A INPUT -p tcp --dport 80 -j ACCEPT</code> 开放 80 端口。</p>
`,
	},
	{
		id: 'system-install',
		title: '系统安装入门',
		category: '运维',
		summary: '从 BIOS 设置到磁盘分区、系统安装的基础流程。',
		content: `
<h2>BIOS 与 UEFI</h2>
<h3>区别</h3>
<p>BIOS 是传统固件接口，UEFI 是新一代替代方案，支持更大磁盘、图形界面、安全启动。</p>
<h3>启动顺序</h3>
<p>开机按 Delete/F2 进入 BIOS，在 Boot 菜单设置启动顺序，选择 U 盘或光驱优先。</p>

<h2>磁盘分区</h2>
<h3>MBR 与 GPT</h3>
<p>MBR 最大支持 2TB 磁盘、4 个主分区；GPT 支持更大磁盘、更多分区，推荐使用。</p>
<h3>分区方案</h3>
<p>常见方案：系统盘(C:)、数据盘(D:)，Linux 下分 /、/home、swap。</p>

<h2>安装步骤</h2>
<h3>准备启动盘</h3>
<p>用 Rufus 或 Ventoy 将 ISO 镜像写入 U 盘。</p>
<h3>安装系统</h3>
<p>从 U 盘启动，按向导选择分区、设置用户名密码、等待安装完成。</p>
<h3>驱动安装</h3>
<p>安装完成后检查设备管理器，安装显卡、网卡、声卡等驱动。</p>
`,
	},
	{
		id: 'healthy-habits',
		title: '健康生活习惯',
		category: '生活',
		summary: '饮食、运动、作息的基本原则，从基础习惯开始改善身体。',
		content: `
<h2>饮食原则</h2>
<h3>营养均衡</h3>
<p>每餐搭配蔬菜、碳水、蛋白质，避免单一饮食。蔬菜提供维生素，碳水提供能量，蛋白质修复肌肉。</p>
<h3>控制分量</h3>
<p>早餐适量、午餐吃饱、晚餐清淡。避免暴饮暴食和宵夜。</p>
<h3>水分补充</h3>
<p>每天至少 1000ml 饮水，运动后额外补充电解质。</p>

<h2>运动计划</h2>
<h3>自重训练</h3>
<p>俯卧撑练胸肌和手臂，深蹲练腿部和核心，引体向上练背肌。每天分组练习，逐步增加数量。</p>
<h3>有氧运动</h3>
<p>跑步、骑车、跳绳，每周 3-5 次，每次 20-30 分钟。</p>

<h2>作息调整</h2>
<h3>睡眠时间</h3>
<p>晚上 10-11 点入睡，早上 6-7 点起床，保证 7-8 小时睡眠。</p>
<h3>避免熬夜</h3>
<p>熬夜打乱生物钟，影响代谢和恢复，逐步提前入睡时间。</p>

<h2>记录与复盘</h2>
<h3>每日记录</h3>
<p>记录体重、饮食、运动量、睡眠时间，观察趋势变化。</p>
<h3>定期复盘</h3>
<p>每 30 天回顾一次，调整饮食和运动强度，保持持续改进。</p>
`,
	},
];
---

<BaseLayout title="知识库 - 个人主页" description="个人知识库文章">
	<div class="kb-layout" id="kb">
		<!-- 左栏：文章列表 -->
		<aside class="kb-sidebar">
			<h2 class="kb-sidebar-title">文章列表</h2>
			<ul class="article-list" id="article-list">
				{
					articles.map((article, i) => (
						<li>
							<button
								class:list={['article-btn', { active: i === 0 }]}
								data-id={article.id}
							>
								<span class="article-cat">{article.category}</span>
								<span class="article-title">{article.title}</span>
							</button>
						</li>
					))
				}
			</ul>
		</aside>

		<!-- 中栏：文章内容 -->
		<main class="kb-content" id="kb-content">
			{articles.map((article) => (
				<div class="article-content" data-id={article.id} style={article.id !== articles[0].id ? 'display:none' : 'display:block'}>
					<h1 class="article-h1">{article.title}</h1>
					<p class="article-summary">{article.summary}</p>
					<div class="article-body" set:html={article.content} />
				</div>
			))}
		</main>

		<!-- 右栏：文章结构目录 -->
		<aside class="kb-toc" id="kb-toc">
			<h2 class="kb-toc-title">目录</h2>
			<ul class="toc-list" id="toc-list"></ul>
		</aside>
	</div>

	<script>
		// 切换文章 + 生成目录
		const buttons = document.querySelectorAll('.article-btn');
		const contents = document.querySelectorAll('.article-content');
		const tocList = document.getElementById('toc-list')!;

		function showArticle(id: string) {
			// 切换内容显示
			contents.forEach((el) => {
				const content = el as HTMLElement;
				content.style.display = content.dataset.id === id ? 'block' : 'none';
			});
			// 切换按钮高亮
			buttons.forEach((btn) => {
				btn.classList.toggle('active', (btn as HTMLElement).dataset.id === id);
			});
			// 生成目录
			const active = document.querySelector(`.article-content[data-id="${id}"]`) as HTMLElement;
			if (!active) return;
			const headings = active.querySelectorAll('h2, h3');
			tocList.innerHTML = '';
			headings.forEach((h, i) => {
				const heading = h as HTMLElement;
				heading.id = `heading-${i}`;
				const li = document.createElement('li');
				const a = document.createElement('a');
				a.href = `#heading-${i}`;
				a.textContent = heading.textContent;
				a.className = heading.tagName === 'H3' ? 'toc-h3' : 'toc-h2';
				a.addEventListener('click', (e) => {
					e.preventDefault();
					heading.scrollIntoView({ behavior: 'smooth', block: 'start' });
				});
				li.appendChild(a);
				tocList.appendChild(li);
			});
		}

		buttons.forEach((btn) => {
			btn.addEventListener('click', () => {
				const id = (btn as HTMLElement).dataset.id!;
				showArticle(id);
			});
		});

		// 初始化：显示第一篇文章的目录
		showArticle(document.querySelector('.article-btn')!.getAttribute('data-id')!);
	</script>
</BaseLayout>

<style is:global>
	/* 覆盖 BaseLayout 默认宽度，知识库三栏需要更宽 */
	.container { --content-width: 1100px; }
</style>

<style>
	.kb-layout {
		display: grid;
		grid-template-columns: 220px 1fr 200px;
		gap: 24px;
		margin: 0 auto;
		padding: 32px 20px;
	}

	/* 左栏 */
	.kb-sidebar {
		position: sticky;
		top: 70px;
		align-self: start;
	}

	.kb-sidebar-title {
		font-size: 16px;
		margin-bottom: 12px;
		color: var(--muted);
	}

	.article-list {
		list-style: none;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 4px;
	}

	.article-btn {
		display: flex;
		flex-direction: column;
		gap: 2px;
		width: 100%;
		text-align: left;
		padding: 8px 12px;
		border: none;
		border-radius: 8px;
		background: transparent;
		cursor: pointer;
		transition: background 0.15s;
	}

	.article-btn:hover {
		background: #f3f4f6;
	}

	.article-btn.active {
		background: #f3f3f3;
	}

	.article-cat {
		font-size: 11px;
		color: #555555;
		font-weight: 500;
	}

	.article-title {
		font-size: 14px;
		color: var(--text);
		line-height: 1.4;
	}

	.article-btn.active .article-title {
		font-weight: 600;
	}

	/* 中栏 */
	.kb-content {
		min-width: 0;
	}

	.article-h1 {
		font-size: 28px;
		margin-bottom: 8px;
	}

	.article-summary {
		color: var(--muted);
		font-size: 15px;
		margin-bottom: 24px;
		padding-bottom: 16px;
		border-bottom: 1px solid #e5e7eb;
	}

	.article-body :global(h2) {
		font-size: 20px;
		margin: 28px 0 12px;
		padding-left: 12px;
		border-left: 3px solid #111111;
	}

	.article-body :global(h3) {
		font-size: 16px;
		margin: 20px 0 8px;
		color: var(--text);
	}

	.article-body :global(p) {
		font-size: 15px;
		line-height: 1.9;
		margin-bottom: 12px;
		color: var(--text);
	}

	.article-body :global(code) {
		font-size: 13px;
		padding: 2px 6px;
		border-radius: 2px;
		background: #f3f3f3;
		color: #111111;
	}

	/* 右栏 */
	.kb-toc {
		position: sticky;
		top: 70px;
		align-self: start;
	}

	.kb-toc-title {
		font-size: 16px;
		margin-bottom: 12px;
		color: var(--muted);
	}

	.toc-list {
		list-style: none;
		padding: 0;
		border-left: 2px solid #e5e7eb;
	}

	.toc-list li {
		margin: 0;
	}

	.toc-list a {
		display: block;
		font-size: 13px;
		color: var(--muted);
		padding: 4px 12px;
		margin-left: -2px;
		border-left: 2px solid transparent;
		transition: all 0.15s;
	}

	.toc-list a:hover {
		color: #111111;
		border-left-color: #111111;
	}

	.toc-list a.toc-h3 {
		padding-left: 24px;
		font-size: 12px;
	}

	/* 响应式 */
	@media (max-width: 900px) {
		.kb-layout {
			grid-template-columns: 1fr;
			gap: 16px;
		}

		.kb-sidebar,
		.kb-toc {
			position: static;
		}

		.kb-sidebar {
			order: 1;
		}

		.kb-content {
			order: 2;
		}

		.kb-toc {
			order: 3;
		}

		.article-list {
			flex-direction: row;
			flex-wrap: wrap;
		}

		.article-btn {
			width: auto;
		}
	}
</style>
