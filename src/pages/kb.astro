		font-weight: 700;
		margin: 28px 0 12px;
		padding-bottom: 6px;
		border-bottom: 2px solid #555555;
	}

	.article-body :global(h3) {
		font-size: 15px;
		font-weight: 600;
		margin: 20px 0 8px;
		padding: 2px 8px;
		background: #d1d5db;
		border-radius: 4px;
		display: inline-block;
		color: var(--text);
	}

	.article-body :global(h4) {
		font-size: 14px;
		font-weight: 600;
		margin: 16px 0 6px;
		padding-bottom: 4px;
		border-bottom: 1px solid #9ca3af;
		color: var(--text);
	}

