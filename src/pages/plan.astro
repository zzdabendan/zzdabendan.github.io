---
import BaseLayout from '../layouts/BaseLayout.astro';
import VideoBili from '../components/VideoBili.astro';

// 运动示范视频：bv 留空时显示占位卡，补上 BV 号后自动变成可点击播放
type Video = { title: string; bv?: string };
type Phase = { phase: string; goal: string; items: string[]; videos?: Video[] };

// 一日计划：24 小时逐小时安排，每小时三档优先级
const priorityNames = ['首要安排', '次要安排', '其他安排'];

const dailyPlan = [
	{ time: '00:00–01:00', tasks: ['睡眠'] },
	{ time: '01:00–02:00', tasks: ['睡眠'] },
	{ time: '02:00–03:00', tasks: ['睡眠'] },
	{ time: '03:00–04:00', tasks: ['睡眠'] },
	{ time: '04:00–05:00', tasks: ['睡眠'] },
	{ time: '05:00–06:00', tasks: ['睡眠'] },
	{ time: '06:00–07:00', tasks: ['', '', '起床，洗漱'] },
	{ time: '07:00–08:00', tasks: ['', '早餐', ''] },
	{ time: '08:00–09:00', tasks: ['', '', '通勤'] },
	{ time: '09:00–10:00', tasks: ['', '', '工作'] },
	{ time: '10:00–11:00', tasks: ['', '', '工作'] },
	{ time: '11:00–12:00', tasks: ['', '', '工作'] },
	{ time: '12:00–13:00', tasks: ['', '午餐', '午休'] },
	{ time: '13:00–14:00', tasks: ['', '', '工作'] },
	{ time: '14:00–15:00', tasks: ['', '', '工作'] },
	{ time: '15:00–16:00', tasks: ['', '', '工作'] },
	{ time: '16:00–17:00', tasks: ['', '', '工作'] },
	{ time: '17:00–18:00', tasks: ['', '', '工作'] },
	{ time: '18:00–19:00', tasks: ['', '晚餐', '通勤'] },
	{ time: '19:00–20:00', tasks: ['', '', '运动：俯卧撑、深蹲、引体向上'] },
	{ time: '20:00–21:00', tasks: ['', '', '洗漱、休息'] },
	{ time: '21:00–22:00', tasks: ['', '', '学习、阅读'] },
	{ time: '22:00–23:00', tasks: ['', '', '自由安排'] },
	{ time: '23:00–24:00', tasks: ['睡眠'] },
];

// 重复出现的内容追加序号：睡眠1、工作2……只出现一次的保持原样
const taskCounts = new Map<string, number>();
for (const row of dailyPlan) {
	for (const task of row.tasks) {
		if (task) taskCounts.set(task, (taskCounts.get(task) ?? 0) + 1);
	}
}

const seen = new Map<string, number>();
const dailyRows = dailyPlan.map((row) => ({
	time: row.time,
	tasks: row.tasks.map((task) => {
		if (!task) return '';
		if ((taskCounts.get(task) ?? 0) < 2) return task;
		const n = (seen.get(task) ?? 0) + 1;
		seen.set(task, n);
		return `${task}${n}`;
	}),
}));

// 计划数据：5 个主题，每个主题含短/中/长三层
const themes: { name: string; phases: Phase[] }[] = [
	{
		name: '运动',
		phases: [
			{
				phase: '短期',
				goal: '每天按结构吃三餐，完成一次自重训练',
				items: [
					'热身 5 分钟：肩颈、手腕脚踝、开合跳、高抬腿',
					'俯卧撑：3 组，组间休息 60 秒',
					'深蹲：3 组 × 15 次',
					'引体向上：3 组，做到力竭前一次为止',
					'三餐按「蔬菜 + 主食 + 蛋白」搭配，饮水 1000ml',
					'训练后拉伸 5 分钟',
				],
				videos: [
					{ title: '热身动作' },
					{ title: '俯卧撑标准动作' },
					{ title: '深蹲标准动作' },
					{ title: '引体向上标准动作' },
					{ title: '拉伸与放松' },
				],
			},
			{
				phase: '中期',
				goal: '坚持 30 天，观察身体指数变化',
				items: [
					'BMI：记录体重与身高比例变化',
					'肌肉量：观察手臂、腿部、核心肌群围度',
					'力气：俯卧撑、深蹲、引体向上的单次最大数量增长',
					'动作质量：从借力代偿到标准发力',
				],
			},
			{
				phase: '长期',
				goal: '坚持到质变，身材明显改善',
				items: [
					'体型：从偏胖到匀称，体脂率下降',
					'体能：运动耐力与爆发力显著提升',
					'习惯：饮食与运动成为生活本能而非任务',
					'质变：身材改善达到肉眼可见的程度',
				],
			},
		],
	},
	{
		name: '家务',
		phases: [
			{ phase: '短期', goal: '待填写', items: ['待填写'] },
			{ phase: '中期', goal: '待填写', items: ['待填写'] },
			{ phase: '长期', goal: '待填写', items: ['待填写'] },
		],
	},
	{
		name: '学习',
		phases: [
			{ phase: '短期', goal: '待填写', items: ['待填写'] },
			{ phase: '中期', goal: '待填写', items: ['待填写'] },
			{ phase: '长期', goal: '待填写', items: ['待填写'] },
		],
	},
	{
		name: '娱乐',
		phases: [
			{ phase: '短期', goal: '待填写', items: ['待填写'] },
			{ phase: '中期', goal: '待填写', items: ['待填写'] },
			{ phase: '长期', goal: '待填写', items: ['待填写'] },
		],
	},
	{
		name: '工作',
		phases: [
			{ phase: '短期', goal: '待填写', items: ['待填写'] },
			{ phase: '中期', goal: '待填写', items: ['待填写'] },
			{ phase: '长期', goal: '待填写', items: ['待填写'] },
		],
	},
];
---

<BaseLayout title="谋划 - 邹兆廷" description="短期、中期、长期谋划">
	<article>
		<h1>谋划</h1>

		<p class="summary">我在每天夜晚安全安静地睡着，补充满体力的时光度过。在新的清晨起来，开始过上秩序化的生活。首先会整理我的床铺。然后再。整理好我的。其他物品。然后再整理好自身的。身体情况，衣着打扮，卫生情况。补充。身体所需要的水分和。采购每天早上所需要补充的早餐。将没来得及处理的垃圾一同清扫出门。如果时间足够，会进行简单的身体锻炼。然后，把小区门口的电动车充电器收整好，骑电动车进入公司，完成公司当天的岗位任务。中午补充好能量，完成下午的任务。晚上。结束完当天的任务之后。骑电动车离开公司，然后。回到家中，之前去商店采购明日或今日所需的物品。到达家中之后。我会。杨。继续锻炼身体。然后恢复到去兼职。的准备状态。完成兼职工作后回到家，将电动车充满电后清理身体，检查各物品状态后休息，恢复体力，等待新的一天</p>

		<div class="cols">
			<!-- 主栏：五大主题谋划 -->
			<div class="col-main">
				{
					themes.map((theme) => (
						<section class="theme-block">
							<h2 class="theme-title">{theme.name}</h2>
							{theme.phases.map((plan) => (
								<div class="phase">
									<h3 class="phase-name">{plan.phase}</h3>
									<p class="phase-goal">{plan.goal}</p>
									<ul>
										{plan.items.map((item) => (
											<li>{item}</li>
										))}
									</ul>
									{plan.videos && (
										<div class="video-grid">
											{plan.videos.map((video) =>
												video.bv ? (
													<VideoBili bvid={video.bv} title={video.title} />
												) : (
													<div class="video-placeholder">
														<span class="video-title">{video.title}</span>
														<span class="video-note">待补充视频</span>
													</div>
												)
											)}
										</div>
									)}
								</div>
							))}
						</section>
					))
				}
			</div>

			<!-- 侧栏：一日谋划（24 小时逐时安排） -->
			<aside class="col-side">
				<section class="side-daily">
					<h2 class="theme-title">一日谋划</h2>
					<table class="daily-table">
						<thead>
							<tr>
								<th class="daily-time">时间</th>
								{priorityNames.map((name) => (
									<th>{name}</th>
								))}
							</tr>
						</thead>
						<tbody>
							{dailyRows.map((row) => (
								<tr>
									<td class="daily-time">{row.time}</td>
									{priorityNames.map((_, i) => (
										<td class:list={['daily-task', { 'is-primary': i === 0 }]}>{row.tasks[i] || '—'}</td>
									))}
								</tr>
							))}
						</tbody>
					</table>
				</section>
			</aside>
		</div>

		<p class="back"><a href="/">← 返回首页</a></p>
	</article>
</BaseLayout>

<style>
	/* 谋划摘要：标题下第一段，通栏放在两栏布局上方 */
	.summary {
		font-size: 15px;
		line-height: 1.9;
		color: #444444;
		margin: 0 0 32px;
	}

	/* 两栏布局：主栏（主题谋划）+ 侧栏（一日谋划），与关于页一致 */
	:global(.container) {
		max-width: 1080px;
	}

	.cols {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 300px;
		column-gap: 48px;
		align-items: start;
	}

	/* 二级标题：主题名，和知识库 h2 一致 */
	.theme-block + .theme-block {
		margin-top: 32px;
	}

	.theme-title {
		font-size: 20px;
		font-weight: 700;
		margin: 0 0 16px;
		padding-bottom: 6px;
		border-bottom: 2px solid #555555;
	}

	/* 侧栏标题小一号，分隔线改细线（与关于页侧栏一致） */
	.col-side .theme-title {
		font-size: 15px;
		border-bottom-width: 1px;
		border-bottom-color: #bbbbbb;
	}

	/* 侧栏一日计划表：缩窄以适应 300px 栏宽 */
	.side-daily .daily-table {
		font-size: 12px;
	}

	.side-daily .daily-table th {
		padding: 6px 6px;
	}

	.side-daily .daily-table td {
		padding: 5px 6px;
		line-height: 1.6;
	}

	.side-daily .daily-time {
		width: 88px;
		font-size: 11px;
	}

	/* 一日计划表：细线分隔，纯文档流 */
	.daily-table {
		width: 100%;
		border-collapse: collapse;
		table-layout: fixed;
		font-size: 14px;
	}

	.daily-table th {
		text-align: left;
		font-weight: 600;
		padding: 8px 10px;
		color: #111111;
		background: #e5e5e5;
		border-bottom: 1px solid #999999;
	}

	.daily-table td {
		padding: 6px 10px;
		line-height: 1.7;
		vertical-align: top;
		color: #444444;
		border-bottom: 1px solid #e5e5e5;
	}

	.daily-table tbody tr:last-child td {
		border-bottom: none;
	}

	.daily-time {
		width: 110px;
		font-variant-numeric: tabular-nums;
		white-space: nowrap;
		color: #111111;
		background: #ececec;
	}

	/* 首要安排：整列加重，其余层级弱化 */
	.is-primary {
		color: #111111;
		font-weight: 500;
	}

	.phase {
		margin-bottom: 20px;
	}

	/* 三级标题：阶段名，和知识库 h3 一致 */
	.phase-name {
		font-size: 15px;
		font-weight: 600;
		margin: 0 0 8px;
		padding: 2px 8px;
		background: #d1d5db;
		border-radius: 4px;
		display: inline-block;
	}

	.phase-goal {
		display: block;
		font-size: 15px;
		line-height: 1.9;
		color: var(--muted);
		margin-bottom: 8px;
	}

	ul {
		padding-left: 20px;
	}

	li {
		margin-bottom: 6px;
		line-height: 1.8;
		font-size: 15px;
		color: #555555;
	}

	.back {
		margin-top: 40px;
	}

	/* 运动示范视频：两列 16:9，bv 为空时显示占位卡 */
	.video-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 12px;
		margin-top: 16px;
	}

	.video-grid :global(.bili-facade) {
		margin-bottom: 0;
	}

	.video-placeholder {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 4px;
		aspect-ratio: 16 / 9;
		border: 1px dashed #d1d5db;
		border-radius: 4px;
		background: #fafafa;
		text-align: center;
	}

	.video-title {
		font-size: 14px;
		color: #555555;
	}

	.video-note {
		font-size: 12px;
		color: #9ca3af;
	}

	/* 窄屏：收成单栏，一日谋划排回主题谋划之前，表格恢复原字号 */
	@media (max-width: 900px) {
		.cols {
			grid-template-columns: 1fr;
		}

		.col-side {
			order: -1;
		}

		.col-side .theme-title {
			font-size: 20px;
			border-bottom-width: 2px;
			border-bottom-color: #555555;
		}

		.side-daily .daily-table {
			font-size: 14px;
		}

		.side-daily .daily-table th {
			padding: 8px 10px;
		}

		.side-daily .daily-table td {
			padding: 6px 10px;
			line-height: 1.7;
		}

		.side-daily .daily-time {
			width: 110px;
			font-size: 14px;
		}
	}

	@media (max-width: 600px) {
		.phase-name {
			flex-direction: column;
			gap: 4px;
		}

		.video-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
