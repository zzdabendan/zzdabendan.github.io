---
import BaseLayout from '../layouts/BaseLayout.astro';

// 一日计划：24 小时逐小时安排，每小时三档优先级
const priorityNames = ['首要安排', '次要安排', '其他安排'];

const dailyPlan = [
	{ time: '00:00–01:00', tasks: ['睡眠'] },
	{ time: '01:00–02:00', tasks: ['睡眠'] },
	{ time: '02:00–03:00', tasks: ['睡眠'] },
	{ time: '03:00–04:00', tasks: ['睡眠'] },
	{ time: '04:00–05:00', tasks: ['睡眠'] },
	{ time: '05:00–06:00', tasks: ['睡眠'] },
	{ time: '06:00–07:00', tasks: ['', '', '起床，洗漱'] },
	{ time: '07:00–08:00', tasks: ['', '早餐', ''] },
	{ time: '08:00–09:00', tasks: ['', '', '通勤'] },
	{ time: '09:00–10:00', tasks: ['', '', '工作'] },
	{ time: '10:00–11:00', tasks: ['', '', '工作'] },
	{ time: '11:00–12:00', tasks: ['', '', '工作'] },
	{ time: '12:00–13:00', tasks: ['', '午餐', '午休'] },
	{ time: '13:00–14:00', tasks: ['', '', '工作'] },
	{ time: '14:00–15:00', tasks: ['', '', '工作'] },
	{ time: '15:00–16:00', tasks: ['', '', '工作'] },
	{ time: '16:00–17:00', tasks: ['', '', '工作'] },
	{ time: '17:00–18:00', tasks: ['', '', '工作'] },
	{ time: '18:00–19:00', tasks: ['', '晚餐', '通勤'] },
	{ time: '19:00–20:00', tasks: ['', '', '运动：俯卧撑、深蹲、引体向上'] },
	{ time: '20:00–21:00', tasks: ['', '', '洗漱、休息'] },
	{ time: '21:00–22:00', tasks: ['', '', '学习、阅读'] },
	{ time: '22:00–23:00', tasks: ['', '', '自由安排'] },
	{ time: '23:00–24:00', tasks: ['睡眠'] },
];

// 重复出现的内容追加序号：睡眠1、工作2……只出现一次的保持原样
const taskCounts = new Map<string, number>();
for (const row of dailyPlan) {
	for (const task of row.tasks) {
		if (task) taskCounts.set(task, (taskCounts.get(task) ?? 0) + 1);
	}
}

const seen = new Map<string, number>();
const dailyRows = dailyPlan.map((row) => ({
	time: row.time,
	tasks: row.tasks.map((task) => {
		if (!task) return '';
		if ((taskCounts.get(task) ?? 0) < 2) return task;
		const n = (seen.get(task) ?? 0) + 1;
		seen.set(task, n);
		return `${task}${n}`;
	}),
}));

// 计划数据：5 个主题，每个主题含短/中/长三层
const themes = [
	{
		name: '运动',
		phases: [
			{
				phase: '短期',
				goal: '每天做好基础饮食与肌肉运动',
				items: [
					'蔬菜：每餐搭配绿叶或根茎类蔬菜',
					'碳水：米饭、面条、红薯等主食适量摄入',
					'蛋白质：鸡蛋、鸡腿、豆腐、虾等优质蛋白',
					'水分：每天至少 1000ml 饮水',
					'俯卧撑：每天分组练习',
					'深蹲：每天分组练习',
					'引体向上：每天分组练习',
				],
			},
			{
				phase: '中期',
				goal: '坚持 30 天，观察身体指数变化',
				items: [
					'BMI：记录体重与身高比例变化',
					'肌肉量：观察手臂、腿部、核心肌群围度',
					'力气：俯卧撑、深蹲、引体向上的单次最大数量增长',
					'动作质量：从借力代偿到标准发力',
				],
			},
			{
				phase: '长期',
				goal: '坚持到质变，身材明显改善',
				items: [
					'体型：从偏胖到匀称，体脂率下降',
					'体能：运动耐力与爆发力显著提升',
					'习惯：饮食与运动成为生活本能而非任务',
					'质变：身材改善达到肉眼可见的程度',
				],
			},
		],
	},
	{
		name: '家务',
		phases: [
			{ phase: '短期', goal: '待填写', items: ['待填写'] },
			{ phase: '中期', goal: '待填写', items: ['待填写'] },
			{ phase: '长期', goal: '待填写', items: ['待填写'] },
		],
	},
	{
		name: '学习',
		phases: [
			{ phase: '短期', goal: '待填写', items: ['待填写'] },
			{ phase: '中期', goal: '待填写', items: ['待填写'] },
			{ phase: '长期', goal: '待填写', items: ['待填写'] },
		],
	},
	{
		name: '娱乐',
		phases: [
			{ phase: '短期', goal: '待填写', items: ['待填写'] },
			{ phase: '中期', goal: '待填写', items: ['待填写'] },
			{ phase: '长期', goal: '待填写', items: ['待填写'] },
		],
	},
	{
		name: '工作',
		phases: [
			{ phase: '短期', goal: '待填写', items: ['待填写'] },
			{ phase: '中期', goal: '待填写', items: ['待填写'] },
			{ phase: '长期', goal: '待填写', items: ['待填写'] },
		],
	},
];
---

<BaseLayout title="计划 - 邹兆廷" description="短期、中期、长期计划">
	<article>
		<h1>计划</h1>

		<section class="theme-block">
			<h2 class="theme-title">一日计划</h2>
			<table class="daily-table">
				<thead>
					<tr>
						<th class="daily-time">时间</th>
						{priorityNames.map((name) => (
							<th>{name}</th>
						))}
					</tr>
				</thead>
				<tbody>
					{dailyRows.map((row) => (
						<tr>
							<td class="daily-time">{row.time}</td>
							{priorityNames.map((_, i) => (
								<td class:list={['daily-task', { 'is-primary': i === 0 }]}>{row.tasks[i] || '—'}</td>
							))}
						</tr>
					))}
				</tbody>
			</table>
		</section>

		{
			themes.map((theme) => (
				<section class="theme-block">
					<h2 class="theme-title">{theme.name}</h2>
					{theme.phases.map((plan) => (
						<div class="phase">
							<h3 class="phase-name">{plan.phase}</h3>
							<p class="phase-goal">{plan.goal}</p>
							<ul>
								{plan.items.map((item) => (
									<li>{item}</li>
								))}
							</ul>
						</div>
					))}
				</section>
			))
		}

		<p class="back"><a href="/">← 返回首页</a></p>
	</article>
</BaseLayout>

<style>
	/* 二级标题：主题名，和知识库 h2 一致 */
	.theme-block + .theme-block {
		margin-top: 32px;
	}

	.theme-title {
		font-size: 20px;
		font-weight: 700;
		margin: 0 0 16px;
		padding-bottom: 6px;
		border-bottom: 2px solid #555555;
	}

	/* 一日计划表：细线分隔，纯文档流 */
	.daily-table {
		width: 100%;
		border-collapse: collapse;
		table-layout: fixed;
		font-size: 14px;
	}

	.daily-table th {
		text-align: left;
		font-weight: 600;
		padding: 8px 10px;
		color: #111111;
		background: #e8e4dc;
		border-bottom: 1px solid #999999;
		border-left: 1px solid #dddddd;
	}

	.daily-table th:first-child {
		border-left: none;
	}

	.daily-table td {
		padding: 6px 10px;
		line-height: 1.7;
		vertical-align: top;
		color: #555555;
		border-bottom: 1px solid #e5e5e5;
		border-left: 1px solid #f0f0f0;
	}

	.daily-table td:first-child {
		border-left: none;
	}

	.daily-table tbody tr:last-child td {
		border-bottom: none;
	}

	.daily-time {
		width: 110px;
		font-variant-numeric: tabular-nums;
		white-space: nowrap;
		color: #111111;
		background: #f0ece5;
	}

	/* 首要安排：整列加重，其余层级弱化 */
	.is-primary {
		color: #111111;
		font-weight: 500;
	}

	.phase {
		margin-bottom: 20px;
	}

	/* 三级标题：阶段名，和知识库 h3 一致 */
	.phase-name {
		font-size: 15px;
		font-weight: 600;
		margin: 0 0 8px;
		padding: 2px 8px;
		background: #d1d5db;
		border-radius: 4px;
		display: inline-block;
	}

	.phase-goal {
		display: block;
		font-size: 15px;
		line-height: 1.9;
		color: var(--muted);
		margin-bottom: 8px;
	}

	ul {
		padding-left: 20px;
	}

	li {
		margin-bottom: 6px;
		line-height: 1.8;
		font-size: 15px;
		color: #555555;
	}

	.back {
		margin-top: 40px;
	}

	@media (max-width: 600px) {
		.phase-name {
			flex-direction: column;
			gap: 4px;
		}
	}
</style>
