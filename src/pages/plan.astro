---
import BaseLayout from '../layouts/BaseLayout.astro';

// ===== 战术层：一日作息（折叠附录）=====
const priorityNames = ['首要安排', '次要安排', '其他安排'];

const dailyPlan = [
	{ time: '00:00–01:00', tasks: ['睡眠'] },
	{ time: '01:00–02:00', tasks: ['睡眠'] },
	{ time: '02:00–03:00', tasks: ['睡眠'] },
	{ time: '03:00–04:00', tasks: ['睡眠'] },
	{ time: '04:00–05:00', tasks: ['睡眠'] },
	{ time: '05:00–06:00', tasks: ['睡眠'] },
	{ time: '06:00–07:00', tasks: ['', '', '起床，洗漱'] },
	{ time: '07:00–08:00', tasks: ['', '早餐', ''] },
	{ time: '08:00–09:00', tasks: ['', '', '通勤'] },
	{ time: '09:00–10:00', tasks: ['', '', '工作'] },
	{ time: '10:00–11:00', tasks: ['', '', '工作'] },
	{ time: '11:00–12:00', tasks: ['', '', '工作'] },
	{ time: '12:00–13:00', tasks: ['', '午餐', '午休'] },
	{ time: '13:00–14:00', tasks: ['', '', '工作'] },
	{ time: '14:00–15:00', tasks: ['', '', '工作'] },
	{ time: '15:00–16:00', tasks: ['', '', '工作'] },
	{ time: '16:00–17:00', tasks: ['', '', '工作'] },
	{ time: '17:00–18:00', tasks: ['', '', '工作'] },
	{ time: '18:00–19:00', tasks: ['', '晚餐', '通勤'] },
	{ time: '19:00–20:00', tasks: ['', '', '运动：俯卧撑、深蹲、引体向上'] },
	{ time: '20:00–21:00', tasks: ['', '', '洗漱、休息'] },
	{ time: '21:00–22:00', tasks: ['', '', '学习、阅读'] },
	{ time: '22:00–23:00', tasks: ['', '', '自由安排'] },
	{ time: '23:00–24:00', tasks: ['睡眠'] },
];

// 重复出现的内容追加序号：睡眠1、工作2……只出现一次的保持原样
const taskCounts = new Map<string, number>();
for (const row of dailyPlan) {
	for (const task of row.tasks) {
		if (task) taskCounts.set(task, (taskCounts.get(task) ?? 0) + 1);
	}
}

const seen = new Map<string, number>();
const dailyRows = dailyPlan.map((row) => ({
	time: row.time,
	tasks: row.tasks.map((task) => {
		if (!task) return '';
		if ((taskCounts.get(task) ?? 0) < 2) return task;
		const n = (seen.get(task) ?? 0) + 1;
		seen.set(task, n);
		return `${task}${n}`;
	}),
}));

// ===== 预知层：每个时间节点的上 / 中 / 下三种未来 =====
// 上 = 最好情况；中 = 按当前节奏最可能发生；下 = 最坏情况
const foresight = [
	{ horizon: '10 年后', year: 2036, up: '', mid: '', down: '' },
	{ horizon: '5 年后', year: 2031, up: '', mid: '', down: '' },
	{ horizon: '3 年后', year: 2029, up: '', mid: '', down: '' },
	{ horizon: '1 年后', year: 2027, up: '', mid: '', down: '' },
];

// ===== 战略层：这一年要什么 =====
const strategies = [
	{
		name: '身体',
		goal: '把锻炼变成日常，体重和体能回到稳定区间',
		why: '长期目标是坚持锻炼健身，保持健康的身体。',
		check: '每周训练不少于 5 次；体重、BMI 按月记录',
	},
	{
		name: '钱',
		goal: '存到 1 万元，先让每月收支转正',
		why: '存钱是摆脱只用时间换钱的起点。',
		check: '每月存款额为正；距离 1 万元的余额',
	},
	{
		name: '能力',
		goal: '把岗位经验沉淀成能复用的文档和方法',
		why: '现在的工作以客服技术维护和客户服务为主。',
		check: '知识库新增篇数；岗位文档完成率',
	},
];

// ===== 战役层：这一季各条战线 =====
type Battle = {
	name: string;
	goal: string;
	milestones: string[];
	metrics: string[];
	risks: string[];
	plan: string;
};

const battles: Battle[] = [
	{
		name: '运动',
		goal: '连续 30 天完成自重训练与三餐结构',
		milestones: [
			'第 1 周：固定时段，19:00–20:00 只做训练',
			'第 2–3 周：动作标准度优先于数量',
			'第 4 周：量一次围度与最大次数，做第一次对比',
		],
		metrics: ['BMI、体重', '俯卧撑 / 深蹲 / 引体向上单次最大数', '每周完成训练天数'],
		risks: ['天气转冷、感冒打断节奏', '加班或兼职挤掉晚上时段'],
		plan: '中断不超过 2 天；恢复当天只做一半训练量',
	},
	{
		name: '财务',
		goal: '本月存款转正，继续推进 1 万元目标',
		milestones: ['固定支出按预算执行', '兼职按周排班，不临时加单', '月末核对存款与欠款'],
		metrics: ['每月存款额', '兼职收入', '欠款余额'],
		risks: ['单量不足、超时罚款', '临时支出打乱预算'],
		plan: '先保底支出再谈目标；罚款一周不超过 1 单',
	},
	{
		name: '工作',
		goal: '岗位任务稳定交付，文档与检查项补齐',
		milestones: ['配置文档补齐', '物品清单与安全检查项维护', '交接内容归档到知识库'],
		metrics: ['文档完成项数', '检查发现问题数'],
		risks: ['人手减少后事务集中', '临时顶班打乱节奏'],
		plan: '每天留 30 分钟写文档，不攒到检查前',
	},
];

// ===== 战术层：每周固定动作 =====
const tactics = [
	'06:00–07:00 起床、整理床铺、洗漱',
	'07:00–08:00 早餐按「蔬菜 + 主食 + 蛋白」搭配',
	'08:00–09:00 通勤，取电动车充电器，骑到公司',
	'09:00–18:00 岗位任务，中午午休 30 分钟',
	'18:00–19:00 晚餐、通勤回家',
	'19:00–20:00 自重训练：热身 5 分钟 + 俯卧撑 3 组、深蹲 3×15、引体向上 3 组 + 拉伸 5 分钟',
	'20:00–22:00 洗漱、学习或阅读',
	'22:00–23:00 自由安排，23:00 前入睡',
	'全天饮水 1000ml；每周日复盘一次存款与训练记录',
];

// 动作示范视频：补上 BV 号后可改成 VideoBili 组件
const demoVideos = ['热身动作', '俯卧撑标准动作', '深蹲标准动作', '引体向上标准动作', '拉伸与放松'];
---

<BaseLayout title="谋划 - 邹兆廷" description="战略、战役、战术三层谋划">
	<article>
		<h1>谋划</h1>

		<p class="lead">谋划最重要的是预知：先看清未来的上、中、下，再决定现在往哪用力。这一页从「预知未来 → 这一年 → 这一季 → 这一周」四层往下拆，越往下越具体。</p>

		<!-- 零、预知层 -->
		<section class="layer foresight">
			<h2 class="layer-title">零、预知层 · 未来的上中下</h2>
			<p class="layer-note">在每个时间节点上先想清楚三种情况：上是最好的，中是按当前节奏最可能发生的，下是要提前防的。看清这三条，才知道今天该把力用在哪。</p>

			{foresight.map((f) => (
				<div class="foresight-stage">
					<h3 class="foresight-horizon">{f.horizon} <span class="foresight-year">（{f.year}）</span></h3>
					<div class="foresight-grid">
						<div class="foresight-card up">
							<span class="foresight-label">上</span>
							<p class="foresight-text">{f.up || '待填写：这个时间点，最好的情况是什么？'}</p>
						</div>
						<div class="foresight-card mid">
							<span class="foresight-label">中</span>
							<p class="foresight-text">{f.mid || '待填写：按当前节奏走，最可能发生的是什么？'}</p>
						</div>
						<div class="foresight-card down">
							<span class="foresight-label">下</span>
							<p class="foresight-text">{f.down || '待填写：最坏的情况会是什么，怎么提前防？'}</p>
						</div>
					</div>
				</div>
			))}
		</section>

		<!-- 一、战略层 -->
		<section class="layer">
			<h2 class="layer-title">一、战略层 · 这一年</h2>
			<p class="layer-note">只回答一件事：这一年结束的时候，什么必须成立。</p>
			<div class="strategy-grid">
				{strategies.map((s) => (
					<div class="strategy">
						<h3>{s.name}</h3>
						<p class="strategy-goal">{s.goal}</p>
						<p class="strategy-why">{s.why}</p>
						<p class="strategy-check">判断标准：{s.check}</p>
					</div>
				))}
			</div>
		</section>

		<!-- 二、战役层 -->
		<section class="layer">
			<h2 class="layer-title">二、战役层 · 这一季</h2>
			<p class="layer-note">把年度目标拆成可验收的阶段，每条战线写清目标、里程碑、指标、风险和退路。</p>

			{battles.map((b) => (
				<div class="battle">
					<h3 class="battle-name">{b.name}</h3>
					<p class="battle-goal">{b.goal}</p>
					<dl class="battle-rows">
						<div class="row">
							<dt>里程碑</dt>
							<dd>
								<ul>
									{b.milestones.map((m) => <li>{m}</li>)}
								</ul>
							</dd>
						</div>
						<div class="row">
							<dt>指标</dt>
							<dd>
								<ul>
									{b.metrics.map((m) => <li>{m}</li>)}
								</ul>
							</dd>
						</div>
						<div class="row">
							<dt>风险</dt>
							<dd>
								<ul>
									{b.risks.map((m) => <li>{m}</li>)}
								</ul>
							</dd>
						</div>
						<div class="row">
							<dt>退路</dt>
							<dd>{b.plan}</dd>
						</div>
					</dl>
				</div>
			))}

			<p class="layer-note">家务、学习、娱乐三条战线待补，补齐后按同样格式并入本节。</p>
		</section>

		<!-- 三、战术层 -->
		<section class="layer">
			<h2 class="layer-title">三、战术层 · 这一周</h2>
			<p class="layer-note">战术只做一件事：把上面的目标变成今天就能执行的动作。</p>

			<ul class="tactics">
				{tactics.map((t) => <li>{t}</li>)}
			</ul>

			<details class="demo">
				<summary>动作示范视频（待补）</summary>
				<div class="video-grid">
					{demoVideos.map((title) => (
						<div class="video-placeholder">
							<span class="video-title">{title}</span>
							<span class="video-note">待补充视频</span>
						</div>
					))}
				</div>
			</details>

			<details class="daily">
				<summary>一日作息（24 小时逐时安排）</summary>
				<table class="daily-table">
					<thead>
						<tr>
							<th class="daily-time">时间</th>
							{priorityNames.map((name) => (
								<th>{name}</th>
							))}
						</tr>
					</thead>
					<tbody>
						{dailyRows.map((row) => (
							<tr>
								<td class="daily-time">{row.time}</td>
								{priorityNames.map((_, i) => (
									<td class:list={['daily-task', { 'is-primary': i === 0 }]}>{row.tasks[i] || '—'}</td>
								))}
							</tr>
						))}
					</tbody>
				</table>
			</details>
		</section>

		<!-- 四、复盘 -->
		<section class="layer">
			<h2 class="layer-title">四、复盘</h2>
			<p class="layer-note">每周日 30 分钟：对照上面的指标，写一条记录，答三句话——哪条推进了、哪条停了、下周改哪一步。</p>
			<p class="review-link"><a href="/reflections">去看每周记录 →</a></p>
		</section>

		<p class="back"><a href="/">← 返回首页</a></p>
	</article>
</BaseLayout>

<style>
	:global(.container) {
		max-width: 1280px;
	}

	/* 开篇：说明这一页的方法，而不是流水叙述 */
	.lead {
		font-size: 15px;
		line-height: 1.9;
		color: #444444;
		margin: 0 0 8px;
	}

	.layer {
		margin-top: 36px;
	}

	/* 二级标题：层级名，和知识库 h2 一致 */
	.layer-title {
		font-size: 20px;
		font-weight: 700;
		margin: 0 0 10px;
		padding-bottom: 6px;
		border-bottom: 2px solid #555555;
	}

	.layer-note {
		font-size: 13px;
		line-height: 1.8;
		color: #6b7280;
		margin: 0 0 16px;
	}

	/* 预知层：每个阶段一组，上中下三卡并排 */
	.foresight-stage {
		margin-bottom: 24px;
	}

	.foresight-horizon {
		font-size: 15px;
		font-weight: 700;
		margin: 0 0 10px;
		color: #111111;
	}

	.foresight-year {
		font-weight: 400;
		color: #9ca3af;
		font-size: 13px;
	}

	.foresight-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 12px;
	}

	.foresight-card {
		border: 1px solid;
		border-radius: 6px;
		padding: 12px 14px;
		display: flex;
		flex-direction: column;
		gap: 6px;
	}

	.foresight-label {
		font-size: 13px;
		font-weight: 700;
		align-self: flex-start;
		padding: 1px 10px;
		border-radius: 10px;
	}

	.foresight-text {
		font-size: 13px;
		line-height: 1.8;
		margin: 0;
	}

	/* 上：最好情况，绿色 */
	.foresight-card.up {
		background: #e8f5e9;
		border-color: #a5d6a7;
	}

	.foresight-card.up .foresight-label {
		background: #2e7d32;
		color: #ffffff;
	}

	.foresight-card.up .foresight-text {
		color: #1b5e20;
	}

	/* 中：基准，灰色 */
	.foresight-card.mid {
		background: #f5f5f5;
		border-color: #bdbdbd;
	}

	.foresight-card.mid .foresight-label {
		background: #616161;
		color: #ffffff;
	}

	.foresight-card.mid .foresight-text {
		color: #424242;
	}

	/* 下：最坏情况，红色 */
	.foresight-card.down {
		background: #fdecea;
		border-color: #ef9a9a;
	}

	.foresight-card.down .foresight-label {
		background: #c62828;
		color: #ffffff;
	}

	.foresight-card.down .foresight-text {
		color: #b3261e;
	}

	/* 战略层：三张并排卡片 */
	.strategy-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
		gap: 16px;
	}

	.strategy {
		background: #fafafa;
		border: 1px solid #e5e7eb;
		border-radius: 6px;
		padding: 16px 18px;
	}

	/* 三级标题：战线名，和知识库 h3 一致 */
	.strategy h3,
	.battle-name {
		font-size: 15px;
		font-weight: 600;
		margin: 0 0 8px;
		padding: 2px 8px;
		background: #d1d5db;
		border-radius: 4px;
		display: inline-block;
	}

	.strategy-goal {
		font-size: 15px;
		font-weight: 600;
		line-height: 1.8;
		color: #111111;
		margin: 0 0 8px;
	}

	.strategy-why {
		font-size: 14px;
		line-height: 1.8;
		color: #6b7280;
		margin: 0 0 8px;
	}

	.strategy-check {
		font-size: 13px;
		line-height: 1.7;
		color: #555555;
		margin: 0;
	}

	/* 战役层：一条战线一组，左侧细线区分 */
	.battle {
		border-left: 2px solid #e5e7eb;
		padding-left: 16px;
		margin-bottom: 28px;
	}

	.battle-goal {
		font-size: 15px;
		font-weight: 600;
		line-height: 1.8;
		color: #111111;
		margin: 0 0 8px;
	}

	.battle-rows {
		margin: 0;
	}

	.row {
		display: grid;
		grid-template-columns: 64px minmax(0, 1fr);
		gap: 10px;
		padding: 4px 0;
		font-size: 15px;
		line-height: 1.9;
	}

	.row dt {
		color: #9ca3af;
		font-size: 13px;
		padding-top: 2px;
	}

	.row dd {
		margin: 0;
		color: #333333;
	}

	.row ul {
		margin: 0;
		padding-left: 18px;
	}

	.row li {
		margin: 0;
	}

	/* 战术层：动作清单 */
	.tactics {
		margin: 0 0 20px;
		padding-left: 20px;
	}

	.tactics li {
		font-size: 15px;
		line-height: 1.9;
		color: #333333;
		margin-bottom: 6px;
	}

	/* 折叠区：示范视频与一日作息 */
	details.demo,
	details.daily {
		margin-bottom: 12px;
	}

	details summary {
		font-size: 14px;
		font-weight: 600;
		color: #333333;
		cursor: pointer;
		border-bottom: 1px solid #d1d5db;
		padding-bottom: 6px;
	}

	details summary::marker {
		color: #6b7280;
	}

	/* 运动示范视频：两列 16:9 占位 */
	.video-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 12px;
		margin-top: 12px;
	}

	.video-placeholder {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 4px;
		aspect-ratio: 16 / 9;
		border: 1px dashed #d1d5db;
		border-radius: 4px;
		background: #fafafa;
		text-align: center;
	}

	.video-title {
		font-size: 14px;
		color: #555555;
	}

	.video-note {
		font-size: 12px;
		color: #9ca3af;
	}

	/* 一日作息表：细线分隔，纯文档流 */
	.daily-table {
		width: 100%;
		border-collapse: collapse;
		table-layout: fixed;
		font-size: 13px;
		margin-top: 12px;
	}

	.daily-table th {
		text-align: left;
		font-weight: 600;
		padding: 8px 10px;
		color: #111111;
		background: #e5e5e5;
		border-bottom: 1px solid #999999;
	}

	.daily-table td {
		padding: 6px 10px;
		line-height: 1.7;
		vertical-align: top;
		color: #444444;
		border-bottom: 1px solid #e5e5e5;
	}

	.daily-table tbody tr:last-child td {
		border-bottom: none;
	}

	.daily-time {
		width: 110px;
		font-variant-numeric: tabular-nums;
		white-space: nowrap;
		color: #111111;
		background: #ececec;
	}

	/* 首要安排：整列加重，其余层级弱化 */
	.is-primary {
		color: #111111;
		font-weight: 500;
	}

	.review-link {
		font-size: 15px;
		margin: 0;
	}

	.review-link a {
		color: #2563eb;
		text-decoration: none;
	}

	.review-link a:hover {
		text-decoration: underline;
	}

	.back {
		margin-top: 40px;
	}

	@media (max-width: 600px) {
		.foresight-grid,
		.video-grid {
			grid-template-columns: 1fr;
		}

