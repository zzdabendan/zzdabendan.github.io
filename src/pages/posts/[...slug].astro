---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleBody from '../../components/ArticleBody.astro';

export async function getStaticPaths() {
	const entries = await getCollection('posts');
	// 按时间倒序：新文章在前
	const sorted = entries.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
	return sorted.map((entry, i) => ({
		params: { slug: entry.id },
		props: {
			entry,
			prev: sorted[i - 1], // 上一篇（更新）
			next: sorted[i + 1], // 下一篇（更早）
		},
	}));
}

const { entry, prev, next } = Astro.props;
const { Content } = await render(entry);
const fmt = (d: Date) => d.toISOString().slice(0, 10);
---

<BaseLayout title={`${entry.data.title} - 邹兆廷`} description={entry.data.summary}>
	<article>
		<h1 class="post-h1">{entry.data.title}</h1>
		<p class="post-meta">
			<time>{fmt(entry.data.date)}</time> · {entry.data.summary}
		</p>
		<ArticleBody>
			<Content />
		</ArticleBody>

		<!-- 上一篇 / 下一篇 -->
		<nav class="post-nav">
			<span>{prev && <a href={`/posts/${prev.id}/`}>← {prev.data.title}</a>}</span>
			<span>{next && <a href={`/posts/${next.id}/`}>{next.data.title} →</a>}</span>
		</nav>
	</article>
</BaseLayout>

<style>
	.post-h1 {
		font-size: 28px;
		margin-bottom: 8px;
	}

	.post-meta {
		color: var(--muted);
		font-size: 15px;
		margin-bottom: 24px;
		padding-bottom: 16px;
		border-bottom: 1px solid #e5e7eb;
	}

	.post-nav {
		display: flex;
		justify-content: space-between;
		gap: 16px;
		margin-top: 48px;
		padding-top: 16px;
		border-top: 1px solid #e5e7eb;
		font-size: 14px;
	}

	.post-nav a:hover {
		text-decoration: underline;
		text-decoration-color: #9ca3af;
		text-underline-offset: 2px;
	}
</style>
