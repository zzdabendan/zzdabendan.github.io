---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

// 文章首页：博客布局，按发布时间倒序
const all = await getCollection('posts');
const items = all.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const fmt = (d: Date) => d.toISOString().slice(0, 10);
---

<BaseLayout title="文章 - 邹兆廷" description="完整成篇的文章">
	<article>
		<h1>文章</h1>

		{
			items.length === 0 ? (
				<p class="intro">暂无文章，待积累后发布。</p>
			) : (
				<ul class="post-list">
					{items.map((post) => (
						<li>
								<time class="post-date">{fmt(post.data.date)}</time>
								<a href={`/posts/${post.id}/`} class="post-title">{post.data.title}</a>
							</li>
					))}
				</ul>
			)
		}

		<p class="back"><a href="/">← 返回首页</a></p>
	</article>
</BaseLayout>

<style>
	.intro {
		color: var(--text);
		margin-bottom: 12px;
	}

	.post-list {
		list-style: none;
		padding: 0;
	}

	.post-list li {
		display: flex;
		align-items: baseline;
		gap: 14px;
		margin-bottom: 10px;
	}

	.post-date {
		font-size: 13px;
		color: var(--muted);
		flex-shrink: 0;
	}

	.post-title {
		font-size: 15px;
		font-weight: 500;
		color: var(--text);
	}

	.post-title:hover {
		text-decoration: underline;
		text-decoration-color: #9ca3af;
		text-underline-offset: 2px;
	}

	.back {
		margin-top: 40px;
		font-size: 14px;
		color: var(--muted);
	}
</style>
