---
import BaseLayout from '../layouts/BaseLayout.astro';

// 财务明细（金额单位：元）
const debtRows = [
	{ label: '花呗', value: 490 },
	{ label: '白条', value: 0 },
];
const incomeRows = [
	{ label: '工资收入', value: 4100 },
	{ label: '兼职收入', value: 0 },
];
const depositRows = [
	{ label: '江西银行', value: 1500 },
	{ label: '建设银行', value: 0 },
	{ label: '工商银行', value: 0 },
	{ label: '招商银行', value: 0 },
	{ label: '农商银行', value: 0 },
	{ label: '支付宝', value: 0 },
	{ label: '微信', value: 460 },
	{ label: '定期', value: 5000 },
];

// 花费分析（横条宽度按 2852 为满幅计算百分比）
const fixedCost = {
	total: 962,
	items: [
		{ label: '房租', value: 600 },
		{ label: '水电', value: 224 },
		{ label: '话费', value: 39 },
		{ label: '宽带', value: 99 },
		{ label: '三餐', value: 0 },
		{
			label: '出行',
			value: 0,
			sub: [
				{ label: '购车车价', value: 0 },
				{ label: '过户费', value: 0 },
				{ label: '整备费', value: 0 },
				{ label: '保险费', value: 0 },
				{ label: '油费', value: 0 },
				{ label: '保养费', value: 0 },
				{ label: '停车费', value: 0 },
				{ label: '洗车杂费', value: 0 },
			],
		},
	],
};

const mealPlans = [
	{ tag: '最省', amount: 1892, note: '早包子·午外卖·晚自做', best: true },
	{ tag: '常见', amount: 1952, note: '同上（晚自做8元档）', best: false },
	{ tag: '早外卖', amount: 2252, note: '', best: false },
	{ tag: '晚外卖', amount: 2552, note: '', best: false },
	{ tag: '全外卖', amount: 2852, note: '', best: false },
];

// 场景1：财务血条（壳=月花费，填充=月收入，超出=月结余，缺口=欠款）
const totalDebt = debtRows.reduce((s, r) => s + r.value, 0);
const totalIncome = incomeRows.reduce((s, r) => s + r.value, 0);
const totalDeposit = depositRows.reduce((s, r) => s + r.value, 0);
const monthlySpend = mealPlans[0].amount; // 以最省组合为壳
const monthlyRest = totalIncome - monthlySpend; // 月结余
// 血条按最大值定标尺
const hpMax = Math.max(totalIncome, monthlySpend);
const shellPct = Math.round((monthlySpend / hpMax) * 100);
const restPct = 100 - shellPct;

const savingTips = [
	{ text: '晚餐自做比外卖省 600+', strong: true },
	{ text: '早餐包子替代外卖省 300', strong: false },
	{ text: '宽带话费融合省 40~80', strong: false },
];

// 场景3：出行方式对比（每公里成本，含折旧摊销估算）
const travelPlans = [
	{ tag: '步行', cost: 0, note: '零成本，3 公里内首选', best: true },
	{ tag: '自行车', cost: 0.02, note: '车价 + 维修摊销' },
	{ tag: '电动车', cost: 0.05, note: '电费 + 电池折旧' },
	{ tag: '公交地铁', cost: 0.3, note: '2 元起步价折算' },
	{ tag: '汽车', cost: 1.5, note: '油费 + 保险 + 停车 + 折旧' },
	{ tag: '打车', cost: 2, note: '10 元起步价折算' },
];
const travelMax = 2;

const travelTips = [
	{ text: '3 公里内：步行或自行车，成本接近于零', strong: true },
	{ text: '5 公里内：电动车最快最省，算上换电池摊销仍低于公交', strong: false },
	{ text: '10 公里以上：公交地铁，比打车省八成以上', strong: false },
	{ text: '打车与开车只在多人同行、带物或恶劣天气时划算', strong: false },
];

// 物品分类（装备→随身、出行→出行、仓库→收纳、家具→区域）
const categories = [
	{
		name: '随身物品',
		icon: '口袋',
		items: ['头部', '面部', '颈部', '手部', '上身', '下身', '腿部'],
	},
	{
		name: '出行物品',
		icon: '路途',
		items: ['背包', '手提袋', '电动车', '电动车钥匙', '电动车充电器', '电动车头盔 ×3'],
	},
	{
		name: '收纳物品',
		icon: '归整',
		zones: [
			{ name: '白箱 1', items: ['短袖上衣'] },
			{ name: '白箱 2', items: ['长袖外套'] },
			{ name: '白箱 3', items: ['裤子'] },
			{ name: '白箱 4', items: ['被子'] },
			{ name: '白箱 5', items: ['食物'] },
			{ name: '白箱 6', items: ['厨具'] },
			{ name: '白箱 7', items: ['书籍'] },
			{ name: '白箱 8', items: ['工具'] },
			{ name: '黑箱 1', items: ['旧鞋子'] },
			{ name: '黑箱 2', items: ['挡风被'] },
			{ name: '黑箱 3', items: ['健身器材'] },
			{ name: '黑箱 4', items: ['清洁工具'] },
			{ name: '黑箱 5', items: [] },
			{ name: '黑箱 6', items: [] },
			{ name: '黑箱 7', items: [] },
			{ name: '黑箱 8', items: [] },
		],
	},
	{
		name: '家具物品',
		icon: '居所',
		zones: [
			{
				name: '床铺区',
				items: [
					'枕头 ×2',
					'玩偶抱枕 ×2',
					'床单 ×2',
					'竹席 ×1',
					'眼罩 ×1',
					'毛巾 ×4',
					'春秋被 ×1',
					'空调毯 ×1',
				],
			},
			{
				name: '阳台区',
				items: [
					'晾衣架：衣物、毛巾',
					'排插1：小米智能音箱、小米台灯、手机充电器',
					'排插2：电脑主机、显示器 ×2',
					'排插3：路由器、热水壶、驱蚊器',
					'折叠桌：主机、平板、备用手机',
				],
			},
			{ name: '厨房区', items: [] },
			{ name: '厕所区', items: [] },
		],
	},
];
---

<BaseLayout title="物品 - 邹兆廷" description="我的财务状况与物品清单">
	<!-- 仪表盘通栏容器：突破 BaseLayout 的 720px -->
	<div class="dashboard">
		<h1>物品</h1>

		<!-- 财务控制台 -->
		<section class="console-card">
			<h2 class="block-title">财务</h2>

			<!-- 左右两栏：左明细，右场景 -->
			<div class="console-body">
				<!-- 左：全部明细 -->
				<div class="console-detail">
					<h3 class="console-sub">明细</h3>
					<div class="detail-grid">
						<div class="detail-group tone-spend">
							<h4>固定花费（月 · {fixedCost.total}）</h4>
							<ul>
								{fixedCost.items.map((r) => (
									<>
										<li><span>{r.label}</span><span class="num">{r.value}</span></li>
										{r.sub && (
											<li class="sub">
												<ul>
													{r.sub.map((s) => (
														<li><span>{s.label}</span><span class="num">{s.value}</span></li>
													))}
												</ul>
											</li>
										)}
									</>
								))}
							</ul>
						</div>
						<div class="detail-group tone-income">
							<h4>收入（月）</h4>
							<ul>
								{incomeRows.map((r) => (
									<li><span>{r.label}</span><span class="num">{r.value}</span></li>
								))}
							</ul>
						</div>
						<div class="detail-group tone-deposit">
							<h4>存款（存量 · {totalDeposit}）</h4>
							<ul>
								{depositRows.map((r) => (
									<li><span>{r.label}</span><span class="num">{r.value}</span></li>
								))}
							</ul>
						</div>
						<div class="detail-group tone-debt">
							<h4>欠款（{totalDebt}）</h4>
							<ul>
								{debtRows.map((r) => (
									<li><span>{r.label}</span><span class="num">{r.value}</span></li>
								))}
							</ul>
						</div>
					</div>
				</div>

				<!-- 右：场景问答 -->
				<div class="console-analysis">
					<!-- 场景1：财务血条 -->
					<section class="scene">
						<h3 class="scene-q">我的钱是什么关系？</h3>

						<!-- 血条积木：左=花费（灰底纯黑描边），右=月结余（深墨），轨道留内边距与空隙 -->
						<div class="hp">
							<div class="hp-track">
								<span class="hp-block hp-block-spend" style={`width:calc(${shellPct}% - 2px)`}></span>
								<span class="hp-block hp-block-rest" style={`width:calc(${restPct}% - 2px)`}></span>
							</div>
							<div class="hp-legend">
								<span class="lg-spend"><i class="box box-spend"></i>花费 {monthlySpend}</span>
								<span class="lg-income"><i class="box box-income"></i>收入 {totalIncome}</span>
								<span class="lg-deposit"><i class="box box-deposit"></i>月结余 {monthlyRest}</span>
							</div>
						</div>

						<ul class="scene-answers">
							<li class="tone-spend">我有多少花费？<b>{monthlySpend}/月</b><small>（最省组合，全外卖则 2852）</small></li>
							<li class="tone-income">我有多少收入？<b>{totalIncome}/月</b></li>
							<li class="tone-deposit">我有多少存款？<b>{totalDeposit}</b><small>（存量，月增 {monthlyRest}）</small></li>
							<li class="tone-debt">我有多少欠款？<b class={totalDebt === 0 ? 'zero' : ''}>{totalDebt}</b></li>
						</ul>
					</section>

					<!-- 场景2：三餐方案 -->
					<section class="scene">
						<h3 class="scene-q">三餐怎么吃最省？</h3>
						<ul class="spend-bars">
							{mealPlans.map((p) => (
								<li class:list={['spend-bar-row', { best: p.best }]}>
									<span class="spend-tag">{p.tag}</span>
									<span class="spend-track">
										<span class="spend-fill" style={`width:${Math.round((p.amount / 2852) * 100)}%`}></span>
									</span>
									<span class="spend-amount">{p.amount}</span>
									{p.note && <span class="spend-note">{p.note}</span>}
								</li>
							))}
						</ul>

						<h4 class="spend-sub">怎么省</h4>
						<ul class="spend-tips">
							{savingTips.map((t) => (
								<li class:list={{ strong: t.strong }}>{t.text}</li>
							))}
						</ul>
					</section>
					<!-- 场景3：出行方式对比 -->
					<section class="scene">
						<h3 class="scene-q">出行怎么最省？（元 / 公里）</h3>
						<ul class="spend-bars">
							{travelPlans.map((p) => (
								<li class:list={['spend-bar-row', { best: p.best }]}>
									<span class="spend-tag">{p.tag}</span>
									<span class="spend-track">
										<span class="spend-fill" style={`width:${Math.round((p.cost / travelMax) * 100)}%`}></span>
									</span>
									<span class="spend-amount">{p.cost}</span>
									{p.note && <span class="spend-note">{p.note}</span>}
								</li>
							))}
						</ul>

						<h4 class="spend-sub">怎么省</h4>
						<ul class="spend-tips">
							{travelTips.map((t) => (
								<li class:list={{ strong: t.strong }}>{t.text}</li>
							))}
						</ul>
					</section>
				</div>
			</div>
		</section>

		<!-- 物品分类：多栏网格 -->
		<div class="categories">
			{categories.map((cat) => (
				<section class="category">
					<h2 class="cat-title">{cat.name}<span class="cat-count">
						{cat.zones
							? cat.zones.reduce((s, z) => s + z.items.length, 0)
							: cat.items.length}
					</span></h2>

					{cat.zones ? (
						<div class="zone-list">
							{cat.zones.map((zone) => (
								<div class="zone">
									<h3 class="zone-title">{zone.name}<span class="zone-count">{zone.items.length}</span></h3>
									{zone.items.length > 0 ? (
										<ul class="item-list">
											{zone.items.map((item) => (
												<li>{item}</li>
											))}
										</ul>
									) : (
										<p class="zone-empty">待补充</p>
									)}
								</div>
							))}
						</div>
					) : (
						<ul class="item-list">
							{cat.items.map((item) => (
								<li>{item}</li>
							))}
						</ul>
					)}
				</section>
			))}
		</div>
	</div>
</BaseLayout>

<style>
	/* 覆盖 BaseLayout 的 --content-width，全屏无限制 */
	:global(main.container) {
		--content-width: 100vw;
		max-width: none !important;
		margin: 0;
		padding: 48px 32px;
	}

	/* 二级标题：板块名，和知识库 h2 一致 */
	.block-title {
		font-size: 20px;
		font-weight: 700;
		margin: 0 0 16px;
		padding-bottom: 6px;
		border-bottom: 2px solid #555555;
	}

	/* 财务控制台 */
	.console-card {
		margin-bottom: 40px;
	}

	/* 财务左右两栏：加宽后保持 1:1.4 比例 */
	.console-body {
		display: grid;
		grid-template-columns: 1fr 1.4fr;
		gap: 32px;
	}

	/* 明细区域的四个分组：2×2 网格平铺 */
	.detail-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 16px;
	}

	/* 三级标题：明细/场景名 */
	.console-sub {
		font-size: 15px;
		font-weight: 600;
		margin: 0 0 12px;
		padding: 2px 8px;
		background: #d1d5db;
		border-radius: 4px;
		display: inline-block;
	}

	/* 场景问答 */
	.scene {
		padding-bottom: 20px;
		margin-bottom: 20px;
		border-bottom: 1px dashed #e5e7eb;
	}

	.scene:last-child {
		border-bottom: none;
		margin-bottom: 0;
		padding-bottom: 0;
	}

	.scene-q {
		font-size: 15px;
		font-weight: 600;
		margin: 0 0 12px;
		padding: 2px 8px;
		background: #d1d5db;
		border-radius: 4px;
		display: inline-block;
	}

	/* ===== 4 级语义灰阶 ===== */
	:root {
		--c-spend: #111111;
		--c-income: #666666;
		--c-deposit: #333333;
		--c-debt: #999999;
	}

	/* 财务血条 */
	.hp {
		margin-bottom: 16px;
	}

	.hp-track {
		display: flex;
		gap: 4px;
		padding: 4px;
		background: #f3f4f6;
		border-radius: 6px;
	}

	.hp-block {
		display: block;
		height: 18px;
		border-radius: 3px;
		box-sizing: border-box;
	}

	.hp-block-spend {
		background: var(--c-income);
		border: 2px solid var(--c-spend);
	}

	.hp-block-rest {
		background: var(--c-deposit);
	}

	.hp-legend {
		display: flex;
		flex-wrap: wrap;
		gap: 6px 16px;
		margin-top: 10px;
		font-size: 12px;
	}

	.hp-legend span {
		display: inline-flex;
		align-items: center;
	}

	.hp-legend .box {
		display: inline-block;
		width: 12px;
		height: 12px;
		margin-right: 5px;
		border-radius: 2px;
	}

	.lg-spend { color: var(--c-spend); }
	.lg-income { color: var(--c-income); }
	.lg-deposit { color: var(--c-deposit); }

	.box-spend { border: 2px solid var(--c-spend); background: transparent; box-sizing: border-box; }
	.box-income { background: var(--c-income); }
	.box-deposit { background: var(--c-deposit); }

	.scene-answers {
		list-style: none;
		padding: 0;
		margin: 0;
	}

	.scene-answers li {
		display: flex;
		align-items: baseline;
		flex-wrap: wrap;
		gap: 8px;
		font-size: 15px;
		color: #555555;
		line-height: 2.1;
	}

	.scene-answers b {
		font-size: 15px;
		font-variant-numeric: tabular-nums;
	}

	.tone-spend b { color: var(--c-spend); }
	.tone-income b { color: var(--c-income); }
	.tone-deposit b { color: var(--c-deposit); }
	.tone-debt b { color: var(--c-debt); }

	.scene-answers b.zero {
		color: var(--c-debt);
	}

	.scene-answers small {
		color: #9b9b9b;
		font-size: 12px;
	}

	.detail-group {
		margin-bottom: 0;
	}

	.detail-group h4 {
		font-size: 14px;
		font-weight: 600;
		margin-bottom: 8px;
		padding-bottom: 4px;
		border-bottom: 1px solid #9ca3af;
	}

	.detail-group ul {
		list-style: none;
		padding: 0;
		margin: 0;
	}

	.detail-group li {
		display: flex;
		justify-content: space-between;
		font-size: 15px;
		line-height: 2;
	}

	.detail-group li span:first-child {
		color: #555555;
	}

	.detail-group .num {
		font-weight: 600;
		font-variant-numeric: tabular-nums;
	}

	/* 二级子项：出行下的车辆相关花费 */
	.detail-group li.sub {
		display: block;
		padding-left: 14px;
	}

	.detail-group li.sub ul {
		border-left: 1px solid #e5e0d8;
		padding-left: 10px;
	}

	.detail-group li.sub ul li {
		font-size: 14px;
		line-height: 1.9;
	}

	.detail-group li.sub ul li span:first-child {
		color: #6b6b6b;
	}

	/* 花费分析 */
	.spend-sub {
		font-size: 15px;
		font-weight: 600;
		margin: 0 0 10px;
		padding: 2px 8px;
		background: #d1d5db;
		border-radius: 4px;
		display: inline-block;
	}

	.spend-bars {
		list-style: none;
		padding: 0;
		margin: 0 0 20px;
		display: flex;
		flex-direction: column;
		gap: 6px;
	}

	.spend-bar-row {
		display: flex;
		align-items: center;
		gap: 10px;
		font-size: 13px;
	}

	.spend-tag {
		flex-shrink: 0;
		width: 52px;
		color: var(--muted);
	}

	.spend-track {
		flex-grow: 1;
		height: 10px;
		background: #f3f4f6;
		border-radius: 2px;
		overflow: hidden;
	}

	.spend-fill {
		display: block;
		height: 100%;
		background: #c9c9c9;
		border-radius: 2px;
	}

	.spend-bar-row.best .spend-tag {
		color: #111111;
		font-weight: 700;
	}

	.spend-bar-row.best .spend-fill {
		background: #111111;
	}

	.spend-amount {
		flex-shrink: 0;
		width: 44px;
		text-align: right;
		color: #444444;
		font-variant-numeric: tabular-nums;
	}

	.spend-bar-row.best .spend-amount {
		color: #111111;
		font-weight: 700;
	}

	.spend-note {
		flex-shrink: 0;
		font-size: 12px;
		color: var(--muted);
	}

	.spend-tips {
		list-style: none;
		padding: 0;
		margin: 0;
	}

	.spend-tips li {
		font-size: 15px;
		color: #555555;
		line-height: 1.9;
	}

	.spend-tips li.strong {
		color: #111111;
		font-weight: 600;
	}

	/* 物品分类：响应式多栏网格，4 个分类并排 */
	.categories {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
		gap: 24px;
	}

	.category {
		min-width: 0; /* 防止内容撑破网格 */
	}

	/* 二级标题：物品分类 */
	.cat-title {
		font-size: 20px;
		font-weight: 700;
		margin: 0 0 8px;
		padding-bottom: 6px;
