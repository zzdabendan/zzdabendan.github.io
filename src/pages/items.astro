---
import BaseLayout from '../layouts/BaseLayout.astro';

// 财务明细（金额单位：元）
const debtRows = [
	{ label: '花呗', value: 0 },
	{ label: '白条', value: 0 },
];
const incomeRows = [
	{ label: '工资收入', value: 4100 },
	{ label: '兼职收入', value: 0 },
];
const depositRows = [
	{ label: '江西银行', value: 331 },
	{ label: '建设银行', value: 0 },
	{ label: '工商银行', value: 0 },
	{ label: '招商银行', value: 0 },
	{ label: '农商银行', value: 0 },
	{ label: '支付宝', value: 0 },
	{ label: '微信', value: 0 },
	{ label: '定期', value: 2000 },
];

// 花费分析（横条宽度按 2852 为满幅计算百分比）
const fixedCost = {
	total: 962,
	items: [
		{ label: '房租', value: 600 },
		{ label: '水电', value: 224 },
		{ label: '话费', value: 39 },
		{ label: '宽带', value: 99 },
	],
};

const mealPlans = [
	{ tag: '最省', amount: 1892, note: '早包子·午外卖·晚自做', best: true },
	{ tag: '常见', amount: 1952, note: '同上（晚自做8元档）', best: false },
	{ tag: '早外卖', amount: 2252, note: '', best: false },
	{ tag: '晚外卖', amount: 2552, note: '', best: false },
	{ tag: '全外卖', amount: 2852, note: '', best: false },
];

// 场景1：财务血条（壳=月花费，填充=月收入，超出=月结余，缺口=欠款）
const totalDebt = debtRows.reduce((s, r) => s + r.value, 0);
const totalIncome = incomeRows.reduce((s, r) => s + r.value, 0);
const totalDeposit = depositRows.reduce((s, r) => s + r.value, 0);
const monthlySpend = mealPlans[0].amount; // 以最省组合为壳
const monthlyRest = totalIncome - monthlySpend; // 月结余
// 血条按最大值定标尺
const hpMax = Math.max(totalIncome, monthlySpend);
const shellPct = Math.round((monthlySpend / hpMax) * 100);
const restPct = 100 - shellPct;

const savingTips = [
	{ text: '晚餐自做比外卖省 600+', strong: true },
	{ text: '早餐包子替代外卖省 300', strong: false },
	{ text: '宽带话费融合省 40~80', strong: false },
];

// 物品分类（装备→随身、出行→出行、仓库→收纳、家具→区域）
const categories = [
	{
		name: '随身物品',
		icon: '口袋',
		items: ['装备物品1', '装备物品2', '装备物品3', '装备物品4', '装备物品5'],
	},
	{
		name: '出行物品',
		icon: '路途',
		items: ['出行物品1', '出行物品2', '出行物品3'],
	},
	{
		name: '收纳物品',
		icon: '归整',
		items: ['仓库物品1', '仓库物品2'],
	},
	{
		name: '家具物品',
		icon: '居所',
		items: ['床铺区', '阳台区', '书桌区', '厨房区', '厕所区'],
	},
];
---

<BaseLayout title="物品 - 个人主页" description="我的财务状况与物品清单">
	<h1>物品</h1>

	<!-- 财务控制台 -->
	<section class="console-card">
			<h2 class="block-title">财务</h2>

		<!-- 左右两栏：左明细，右场景 -->
		<div class="console-body">
			<!-- 左：全部明细 -->
			<div class="console-detail">
				<h3 class="console-sub">明细</h3>
				<div class="detail-group tone-spend">
					<h4>固定花费（月 · {fixedCost.total}）</h4>
					<ul>
						{fixedCost.items.map((r) => (
							<li><span>{r.label}</span><span class="num">{r.value}</span></li>
						))}
					</ul>
				</div>
				<div class="detail-group tone-income">
					<h4>收入（月）</h4>
					<ul>
						{incomeRows.map((r) => (
							<li><span>{r.label}</span><span class="num">{r.value}</span></li>
						))}
					</ul>
				</div>
				<div class="detail-group tone-deposit">
					<h4>存款（存量）</h4>
					<ul>
						{depositRows.map((r) => (
							<li><span>{r.label}</span><span class="num">{r.value}</span></li>
						))}
					</ul>
				</div>
				<div class="detail-group tone-debt">
					<h4>欠款</h4>
					<ul>
						{debtRows.map((r) => (
							<li><span>{r.label}</span><span class="num">{r.value}</span></li>
						))}
					</ul>
				</div>
			</div>

			<!-- 右：场景问答 -->
			<div class="console-analysis">
				<!-- 场景1：财务血条 -->
				<section class="scene">
					<h3 class="scene-q">我的钱是什么关系？</h3>

					<!-- 血条积木：左=花费（灰底纯黑描边），右=月结余（深墨），轨道留内边距与空隙 -->
					<div class="hp">
						<div class="hp-track">
							<span class="hp-block hp-block-spend" style={`width:calc(${shellPct}% - 2px)`}></span>
							<span class="hp-block hp-block-rest" style={`width:calc(${restPct}% - 2px)`}></span>
						</div>
						<div class="hp-legend">
							<span class="lg-spend"><i class="box box-spend"></i>花费 {monthlySpend}</span>
							<span class="lg-income"><i class="box box-income"></i>收入 {totalIncome}</span>
							<span class="lg-deposit"><i class="box box-deposit"></i>月结余 {monthlyRest}</span>
						</div>
					</div>

					<ul class="scene-answers">
						<li class="tone-spend">我有多少花费？<b>{monthlySpend}/月</b><small>（最省组合，全外卖则 2852）</small></li>
						<li class="tone-income">我有多少收入？<b>{totalIncome}/月</b></li>
						<li class="tone-deposit">我有多少存款？<b>{totalDeposit}</b><small>（存量，月增 {monthlyRest}）</small></li>
						<li class="tone-debt">我有多少欠款？<b class={totalDebt === 0 ? 'zero' : ''}>{totalDebt}</b></li>
					</ul>
				</section>

				<!-- 场景2：三餐方案 -->
				<section class="scene">
					<h3 class="scene-q">三餐怎么吃最省？</h3>
					<ul class="spend-bars">
						{mealPlans.map((p) => (
							<li class:list={['spend-bar-row', { best: p.best }]}>
								<span class="spend-tag">{p.tag}</span>
								<span class="spend-track">
									<span class="spend-fill" style={`width:${Math.round((p.amount / 2852) * 100)}%`}></span>
								</span>
								<span class="spend-amount">{p.amount}</span>
								{p.note && <span class="spend-note">{p.note}</span>}
							</li>
						))}
					</ul>

					<h4 class="spend-sub">怎么省</h4>
					<ul class="spend-tips">
						{savingTips.map((t) => (
							<li class:list={{ strong: t.strong }}>{t.text}</li>
						))}
					</ul>
				</section>
			</div>
		</div>
	</section>

	<!-- 物品分类 -->
	<div class="categories">
		{categories.map((cat) => (
				<section class="category">
					<h2 class="cat-title">{cat.name}<span class="cat-count">{cat.items.length}</span></h2>
				<ul class="item-list">
					{cat.items.map((item) => (
						<li>{item}</li>
					))}
				</ul>
			</section>
		))}
	</div>
</BaseLayout>

<style>
	h1 {
		margin-bottom: 32px;
	}

	/* 二级标题：板块名，和知识库 h2 一致 */
	.block-title {
		font-size: 20px;
		font-weight: 700;
		margin: 0 0 16px;
		padding-bottom: 6px;
		border-bottom: 2px solid #555555;
	}

	/* 财务控制台 */
	.console-card {
		background: #fff;
		border: 1px solid #e5e7eb;
		border-radius: 4px;
		padding: 24px;
		margin-bottom: 32px;
	}

	/* 左右两栏：明细 + 场景 */
	.console-body {
		display: grid;
		grid-template-columns: 1fr 1.4fr;
		gap: 28px;
	}

	/* 三级标题：明细/场景名，和知识库 h3 一致 */
	.console-sub {
		font-size: 15px;
		font-weight: 600;
		margin: 0 0 12px;
		padding: 2px 8px;
		background: #d1d5db;
		border-radius: 4px;
		display: inline-block;
	}

	/* 场景问答 */
	.scene {
		padding-bottom: 20px;
		margin-bottom: 20px;
		border-bottom: 1px dashed #e5e7eb;
	}

	.scene:last-child {
		border-bottom: none;
		margin-bottom: 0;
		padding-bottom: 0;
	}

	.scene-q {
		font-size: 15px;
		font-weight: 600;
		margin: 0 0 12px;
		padding: 2px 8px;
		background: #d1d5db;
		border-radius: 4px;
		display: inline-block;
	}

	/* ===== 4 级语义灰阶：花费纯黑 / 收入标准灰 / 存款深墨 / 欠款浅墨 ===== */
	:root {
		--c-spend: #111111;
		--c-income: #666666;
		--c-deposit: #333333;
		--c-debt: #999999;
	}

	/* 明细组：标题色 + 左边框色随语义 */
	.detail-group.tone-spend h4 { color: var(--c-spend); }
	.detail-group.tone-income h4 { color: var(--c-income); }
	.detail-group.tone-deposit h4 { color: var(--c-deposit); }
	.detail-group.tone-debt h4 { color: var(--c-debt); }

	.detail-group.tone-spend { border-left: 3px solid var(--c-spend); padding-left: 10px; }
	.detail-group.tone-income { border-left: 3px solid var(--c-income); padding-left: 10px; }
	.detail-group.tone-deposit { border-left: 3px solid var(--c-deposit); padding-left: 10px; }
	.detail-group.tone-debt { border-left: 3px solid var(--c-debt); padding-left: 10px; }

	.detail-group .num { font-weight: 600; }
	.tone-spend .num { color: var(--c-spend); }
	.tone-income .num { color: var(--c-income); }
	.tone-deposit .num { color: var(--c-deposit); }
	.tone-debt .num { color: var(--c-debt); }

	/* 财务血条 */
	.hp {
		margin-bottom: 16px;
	}

	/* 轨道：浅灰槽，带内边距，积木与槽边、积木之间都有空隙 */
	.hp-track {
		display: flex;
		gap: 4px;
		padding: 4px;
		background: #f3f4f6;
		border-radius: 6px;
	}

	/* 积木：统一高度与小圆角 */
	.hp-block {
		display: block;
		height: 18px;
		border-radius: 3px;
		box-sizing: border-box;
	}

	/* 花费积木：收入灰底 + 纯黑描边壳 */
	.hp-block-spend {
		background: var(--c-income);
		border: 2px solid var(--c-spend);
	}

	/* 结余积木：深墨实心（存款色） */
	.hp-block-rest {
		background: var(--c-deposit);
	}

	.hp-legend {
		display: flex;
		flex-wrap: wrap;
		gap: 6px 16px;
		margin-top: 10px;
		font-size: 12px;
	}

	.hp-legend span {
		display: inline-flex;
		align-items: center;
	}

	.hp-legend .box {
		display: inline-block;
		width: 12px;
		height: 12px;
		margin-right: 5px;
		border-radius: 2px;
	}

	.lg-spend { color: var(--c-spend); }
	.lg-income { color: var(--c-income); }
	.lg-deposit { color: var(--c-deposit); }

	.box-spend { border: 2px solid var(--c-spend); background: transparent; box-sizing: border-box; }
	.box-income { background: var(--c-income); }
	.box-deposit { background: var(--c-deposit); }

	/* 四问四答：数字用对应语义色 */
	.scene-answers {
		list-style: none;
		padding: 0;
		margin: 0;
	}

	.scene-answers li {
		display: flex;
		align-items: baseline;
		flex-wrap: wrap;
		gap: 8px;
		font-size: 14px;
		color: #555555;
		line-height: 2.1;
	}

	.scene-answers b {
		font-size: 15px;
		font-variant-numeric: tabular-nums;
	}

	.tone-spend b { color: var(--c-spend); }
	.tone-income b { color: var(--c-income); }
	.tone-deposit b { color: var(--c-deposit); }
	.tone-debt b { color: var(--c-debt); }

	.scene-answers b.zero {
		color: var(--c-debt);
	}

	.scene-answers small {
		color: #9b9b9b;
		font-size: 12px;
	}

	.detail-group {
		margin-bottom: 16px;
	}

	.detail-group h4 {
		font-size: 13px;
		margin-bottom: 4px;
	}

	.detail-group ul {
		list-style: none;
		padding: 0;
		margin: 0;
	}

	.detail-group li {
		display: flex;
		justify-content: space-between;
		font-size: 14px;
		line-height: 2;
	}

	.detail-group li span:first-child {
		color: #555555;
	}

	.detail-group .num {
		font-variant-numeric: tabular-nums;
	}

	/* 花费分析 */
	.spend-sub {
		font-size: 15px;
		font-weight: 600;
		margin: 0 0 10px;
		padding: 2px 8px;
		background: #d1d5db;
		border-radius: 4px;
		display: inline-block;
	}

	.spend-bars {
		list-style: none;
		padding: 0;
		margin: 0 0 20px;
		display: flex;
		flex-direction: column;
		gap: 6px;
	}

	.spend-bar-row {
		display: flex;
		align-items: center;
		gap: 10px;
		font-size: 13px;
	}

	.spend-tag {
		flex-shrink: 0;
		width: 52px;
		color: var(--muted);
	}

	.spend-track {
		flex-grow: 1;
		height: 10px;
		background: #f3f4f6;
		border-radius: 2px;
		overflow: hidden;
	}

	.spend-fill {
		display: block;
		height: 100%;
		background: #c9c9c9;
		border-radius: 2px;
	}

	.spend-bar-row.best .spend-tag {
		color: #111111;
		font-weight: 700;
	}

	.spend-bar-row.best .spend-fill {
		background: #111111;
	}

	.spend-amount {
		flex-shrink: 0;
		width: 44px;
		text-align: right;
		color: #444444;
		font-variant-numeric: tabular-nums;
	}

	.spend-bar-row.best .spend-amount {
		color: #111111;
		font-weight: 700;
	}

	.spend-note {
		flex-shrink: 0;
		font-size: 12px;
		color: var(--muted);
	}

	.spend-tips {
		list-style: none;
		padding: 0;
		margin: 0;
	}

	.spend-tips li {
		font-size: 14px;
		color: #555555;
		line-height: 1.9;
	}

	.spend-tips li.strong {
		color: #111111;
		font-weight: 600;
	}

	/* 物品分类 */
	.categories {
		display: flex;
		flex-direction: column;
		gap: 32px;
	}

	.category {
		border: 1px solid #e5e7eb;
		border-radius: 4px;
		overflow: hidden;
	}

	/* 二级标题：物品分类，和知识库 h2 一致 */
	.cat-title {
		font-size: 20px;
		font-weight: 700;
		margin: 0;
		padding: 16px 20px;
		padding-bottom: 6px;
		border-bottom: 2px solid #555555;
	}

	.cat-count {
		font-size: 14px;
		color: var(--muted);
		background: #f3f4f6;
		padding: 2px 10px;
		border-radius: 999px;
	}

	.item-list {
		list-style: none;
		padding: 0;
		margin: 0;
	}

	.item-list li {
		padding: 12px 20px;
		border-bottom: 1px solid #f3f4f6;
		font-size: 15px;
	}

	.item-list li:last-child {
		border-bottom: none;
	}

	.item-list li:hover {
		background: #fafbfc;
	}

	@media (max-width: 700px) {
		.console-body {
			grid-template-columns: 1fr;
		}
	}
</style>
