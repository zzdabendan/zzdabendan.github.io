---
import BaseLayout from '../layouts/BaseLayout.astro';

const categories = [
	{
		name: '随身物品',
		icon: '口袋',
		items: ['样品1', '样品2', '样品3', '样品4'],
	},
	{
		name: '出行物品',
		icon: '路途',
		items: ['样品1', '样品2', '样品3', '样品4'],
	},
	{
		name: '收纳物品',
		icon: '归整',
		items: ['样品1', '样品2', '样品3', '样品4'],
	},
	{
		name: '家具物品',
		icon: '居所',
		items: ['样品1', '样品2', '样品3', '样品4'],
	},
];
---

<BaseLayout title="物品 - 个人主页" description="我的物品清单">
	<h1>物品</h1>

	<div class="categories">
		{categories.map((cat) => (
			<section class="category">
				<div class="cat-head">
					<span class="cat-icon">{cat.icon}</span>
					<h2>{cat.name}</h2>
					<span class="cat-count">{cat.items.length}</span>
				</div>
				<ul class="item-list">
					{cat.items.map((item) => (
						<li>{item}</li>
					))}
				</ul>
			</section>
		))}
	</div>
</BaseLayout>

<style>
	h1 {
		margin-bottom: 32px;
	}

	.categories {
		display: flex;
		flex-direction: column;
		gap: 32px;
	}

	.category {
		border: 1px solid #e5e7eb;
		border-radius: 12px;
		overflow: hidden;
	}

	.cat-head {
		display: flex;
		align-items: center;
		gap: 12px;
		padding: 16px 20px;
		background: #f9fafb;
		border-bottom: 1px solid #e5e7eb;
	}

	.cat-icon {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 36px;
		height: 36px;
		border-radius: 8px;
		background: #f3e8ff;
		color: var(--accent);
		font-size: 12px;
		font-weight: 700;
	}

	.cat-head h2 {
		font-size: 18px;
		flex-grow: 1;
	}

	.cat-count {
		font-size: 14px;
		color: var(--muted);
		background: #f3f4f6;
		padding: 2px 10px;
		border-radius: 999px;
	}

	.item-list {
		list-style: none;
		padding: 0;
		margin: 0;
	}

	.item-list li {
		padding: 12px 20px;
		border-bottom: 1px solid #f3f4f6;
		font-size: 15px;
	}

	.item-list li:last-child {
		border-bottom: none;
	}

	.item-list li:hover {
		background: #fafbfc;
	}
</style>
