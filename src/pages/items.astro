---
import BaseLayout from '../layouts/BaseLayout.astro';

// 财务（金额单位：元，无金额的记为 null）
const finance = [
	{
		name: '欠款',
		icon: '欠',
		rows: [
			{ label: '花呗', value: 0 },
			{ label: '白条', value: 0 },
		],
	},
	{
		name: '收入',
		icon: '收',
		rows: [
			{ label: '工资收入', value: 4100 },
			{ label: '兼职收入', value: 0 },
		],
	},
	{
		name: '花费',
		icon: '花',
		rows: [
			{ label: '房租花费', value: 600 },
			{ label: '水电', value: 200 },
			{ label: '话费', value: 39 },
			{ label: '网费', value: 99 },
			{ label: '饮食', value: null },
			{ label: '外卖', value: null },
			{ label: '充电', value: null },
			{ label: '网购', value: null },
		],
	},
	{
		name: '存款',
		icon: '存',
		rows: [
			{ label: '江西银行', value: 331 },
			{ label: '建设银行', value: 0 },
			{ label: '工商银行', value: 0 },
			{ label: '招商银行', value: 0 },
			{ label: '农商银行', value: 0 },
			{ label: '支付宝', value: 0 },
			{ label: '微信', value: 0 },
			{ label: '定期', value: 2000 },
		],
	},
];

// 物品分类（装备→随身、出行→出行、仓库→收纳、家具→区域）
const categories = [
	{
		name: '随身物品',
		icon: '口袋',
		items: ['装备物品1', '装备物品2', '装备物品3', '装备物品4', '装备物品5'],
	},
	{
		name: '出行物品',
		icon: '路途',
		items: ['出行物品1', '出行物品2', '出行物品3'],
	},
	{
		name: '收纳物品',
		icon: '归整',
		items: ['仓库物品1', '仓库物品2'],
	},
	{
		name: '家具物品',
		icon: '居所',
		items: ['床铺区', '阳台区', '书桌区', '厨房区', '厕所区'],
	},
];
---

<BaseLayout title="物品 - 个人主页" description="我的财务状况与物品清单">
	<h1>物品</h1>

	<!-- 财务 -->
	<section class="finance-card">
		<div class="block-head">
			<span class="block-icon">财</span>
			<h2>财务</h2>
		</div>
		<div class="finance-grid">
			{finance.map((f) => (
				<div class="finance-group">
					<h3>
						<span class="finance-icon">{f.icon}</span>
						{f.name}
					</h3>
					<ul class="finance-list">
						{f.rows.map((r) => (
							<li>
								<span class="finance-label">{r.label}</span>
								<span class:list={['finance-value', { empty: r.value === null }]}>
									{r.value === null ? '—' : r.value}
								</span>
							</li>
						))}
					</ul>
				</div>
			))}
		</div>
	</section>

	<!-- 物品分类 -->
	<div class="categories">
		{categories.map((cat) => (
			<section class="category">
				<div class="cat-head">
					<span class="cat-icon">{cat.icon}</span>
					<h2>{cat.name}</h2>
					<span class="cat-count">{cat.items.length}</span>
				</div>
				<ul class="item-list">
					{cat.items.map((item) => (
						<li>{item}</li>
					))}
				</ul>
			</section>
		))}
	</div>
</BaseLayout>

<style>
	h1 {
		margin-bottom: 32px;
	}

	.block-head {
		display: flex;
		align-items: center;
		gap: 12px;
		margin-bottom: 16px;
	}

	.block-head h2 {
		font-size: 20px;
	}

	.block-icon {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 36px;
		height: 36px;
		border-radius: 8px;
		background: #f3e8ff;
		color: var(--accent);
		font-size: 14px;
		font-weight: 700;
	}

	/* 财务 */
	.finance-card {
		background: #fff;
		border: 1px solid #e5e7eb;
		border-radius: 12px;
		padding: 24px;
		margin-bottom: 32px;
	}

	.finance-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 20px;
	}

	.finance-group {
		border: 1px solid #f3f4f6;
		border-radius: 10px;
		padding: 16px;
		background: #fcfcfd;
	}

	.finance-group h3 {
		display: flex;
		align-items: center;
		gap: 8px;
		font-size: 15px;
		margin-bottom: 12px;
		padding-bottom: 8px;
		border-bottom: 1px dashed #e5e7eb;
	}

	.finance-icon {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 22px;
		height: 22px;
		border-radius: 6px;
		background: #f3e8ff;
		color: var(--accent);
		font-size: 12px;
		font-weight: 700;
	}

	.finance-list {
		list-style: none;
		padding: 0;
		margin: 0;
	}

	.finance-list li {
		display: flex;
		justify-content: space-between;
		font-size: 14px;
		line-height: 2;
	}

	.finance-label {
		color: var(--muted);
	}

	.finance-value {
		font-weight: 600;
		font-variant-numeric: tabular-nums;
	}

	.finance-value.empty {
		color: #c4c4c4;
		font-weight: 400;
	}

	/* 物品分类 */
	.categories {
		display: flex;
		flex-direction: column;
		gap: 32px;
	}

	.category {
		border: 1px solid #e5e7eb;
		border-radius: 12px;
		overflow: hidden;
	}

	.cat-head {
		display: flex;
		align-items: center;
		gap: 12px;
		padding: 16px 20px;
		background: #f9fafb;
		border-bottom: 1px solid #e5e7eb;
	}

	.cat-icon {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 36px;
		height: 36px;
		border-radius: 8px;
		background: #f3e8ff;
		color: var(--accent);
		font-size: 12px;
		font-weight: 700;
	}

	.cat-head h2 {
		font-size: 18px;
		flex-grow: 1;
	}

	.cat-count {
		font-size: 14px;
		color: var(--muted);
		background: #f3f4f6;
		padding: 2px 10px;
		border-radius: 999px;
	}

	.item-list {
		list-style: none;
		padding: 0;
		margin: 0;
	}

	.item-list li {
		padding: 12px 20px;
		border-bottom: 1px solid #f3f4f6;
		font-size: 15px;
	}

	.item-list li:last-child {
		border-bottom: none;
	}

	.item-list li:hover {
		background: #fafbfc;
	}

	@media (max-width: 600px) {
		.finance-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
