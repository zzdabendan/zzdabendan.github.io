];
---

<BaseLayout title="我的感悟 - 个人主页" description="生活中的个人感悟与每日记录">
	<article class="reflections-page">
		<h1>感悟</h1>
		<p class="intro">记录生活中的点滴感悟，向前走。</p>

		{
			reflections.map((entry) => (
				<section class="entry">
					<h2 class="entry-title">{entry.date} {entry.day} · {entry.city} · {entry.weather}</h2>

					{entry.records.length > 0 && (
					<h3 class="records-label">固定记录</h3>
					<div class="records">
							{entry.records.map((rec) => {
								const parts = [rec.category, rec.status, rec.detail].filter(Boolean);
								return <p class="record-line">{parts.join('，')}</p>;
							})}
						</div>
					)}

					<h3 class="insight-label">今日感悟</h3>
					<p class="insight-text">{entry.insight}</p>
				</section>
			))
		}

		<p class="back-link"><a href="/">← 返回首页</a></p>
	</article>
</BaseLayout>

<style>
	.reflections-page {
		padding-top: 16px;
	}

	h1 {
		font-size: 32px;
		margin-bottom: 8px;
	}

	.intro {
		color: var(--muted);
		font-size: 15px;
		margin-bottom: 32px;
	}

	.entry {
		background: #fff;
		border: 1px solid var(--line);
		border-radius: 4px;
		padding: 20px 24px;
		margin-bottom: 20px;
	}

	/* 二级标题：日期行，和知识库 h2 一致 */
	.entry-title {
		font-size: 20px;
		font-weight: 700;
		margin: 0 0 16px;
		padding-bottom: 6px;
		border-bottom: 2px solid #555555;
	}

	.records {
		margin-bottom: 16px;
		background: #f3f4f6;
		border-radius: 4px;
		padding: 10px 14px;
	}

	.record-line {
		font-size: 15px;
		line-height: 1.9;
		color: var(--text);
		margin-bottom: 4px;
	}

	.record-line:last-child {
		margin-bottom: 0;
	}

	/* 三级标题：固定记录/今日感悟，和知识库 h3 一致 */
	.records-label {
		font-size: 15px;
		font-weight: 600;
		margin: 0 0 8px;
		padding: 2px 8px;
		background: #d1d5db;
		border-radius: 4px;
		display: inline-block;
	}

	.insight-label {
		font-size: 15px;
		font-weight: 600;
		margin: 0 0 8px;
		padding: 2px 8px;
		background: #d1d5db;
		border-radius: 4px;
		display: inline-block;
	}

	.insight-text {
		font-size: 15px;
		line-height: 1.9;
		color: var(--text);
		white-space: pre-wrap;
	}

	.back-link {
		text-align: center;
		margin-top: 32px;
		font-size: 15px;
	}

	@media (max-width: 600px) {
		.entry {
			padding: 16px;
		}
	}
</style>
