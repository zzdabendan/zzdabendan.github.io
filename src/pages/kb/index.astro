---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleBody from '../../components/ArticleBody.astro';
import ArticleList from '../../components/ArticleList.astro';
import Toc from '../../components/Toc.astro';
import SearchBox from '../../components/SearchBox.astro';

// 知识库首页：与文章详情页一致的三栏布局
// 左栏文章列表 / 中栏导读、管理方法、分组导航 / 右栏本页目录
const all = await getCollection('kb');
const groups = ['个人', '社会'].map((category) => ({
	category,
	items: all
		.filter((a) => a.data.category === category)
		.sort((a, b) => a.data.order - b.data.order),
}));

// 左栏组件数据：只取 id 与标题
const sidebarGroups = groups.map((g) => ({
	category: g.category,
	items: g.items.map((a) => ({
		id: a.id,
		title: a.data.title,
	})),
}));

// 右栏目录
const toc = [
	...groups.map((g) => ({ id: g.category, text: g.category })),
	{ id: '管理方法', text: '知识库管理方法' },
];

// 收集全部标签（去重）
const allTags = [...new Set(all.flatMap((a) => a.data.tags ?? []))];
---

<BaseLayout title="知识库 - 邹兆廷" description="个人知识库文章导航" paper={false}>
	<div class="kb-layout">
		<!-- 左栏：文章列表 -->
		<ArticleList groups={sidebarGroups} />

		<!-- 中栏：本页目录 -->
		<Toc items={toc.map((t) => ({ href: `#${t.id}`, text: t.text }))} />

		<!-- 右栏：导读 + 管理方法 + 分组导航 + 待完善 -->
			<main class="kb-content">
				<h1 class="article-h1">知识库</h1>
				<p class="kb-stats">
					共 {all.length} 篇 · 个人 {groups[0].items.length} · 社会 {groups[1].items.length}
				</p>

				<SearchBox />

				{
					allTags.length > 0 && (
						<div class="tag-bar">
							<span class="tag-label">标签：</span>
							{allTags.map((tag) => (
								<button class="tag-btn" data-tag={tag}>
									{tag}
								</button>
							))}
							<button class="tag-btn tag-clear" data-tag="">全部</button>
						</div>
					)
				}

			<ArticleBody>
				{
					groups.map((group) => (
						<section data-group={group.category}>
							<h2 id={group.category}>{group.category}</h2>
							<p class="kb-links">
								{group.items.map((article) => (
									<a
										href={`/kb/${article.id}/`}
										class="kb-link"
										data-tags={JSON.stringify(article.data.tags ?? [])}
									>
										{article.data.title}
									</a>
								))}
							</p>
						</section>
					))
				}

				<section>
					<h2 id="管理方法">知识库管理方法</h2>
					<h3>分类原则</h3>
					<p>
						固定两个分组，不再新增：个人放日常生活方法、习惯、关系与工具；社会放学生时代的功课笔记、工作技术笔记与社会经历。新文章只归入其中一组。
					</p>
					<h3>条目管理</h3>
					<p>
						一个主题一个条目，标题用短语不用句子。内容还少时先合并进相关条目，长到能独立成篇时再拆分。占位条目先建骨架，内容逐步补充。
					</p>
					<h3>写作与维护</h3>
					<p>
						排版格式统一遵循<a href="/kb/writing-style/">写作排版规范</a>。新文章在 <code>src/content/kb/</code> 下新建
						.md 文件，frontmatter 写明标题、分组、摘要与排序号，首页导航与目录会自动生成。
					</p>
				</section>
			</ArticleBody>
		</main>
	</div>

	<script is:inline>
		// 标签筛选：点击标签显示对应文章，点击"全部"恢复
		document.addEventListener('DOMContentLoaded', () => {
			const btns = document.querySelectorAll('.tag-btn');
			const links = document.querySelectorAll('.kb-link');
			const sections = document.querySelectorAll('section[data-group]');

			btns.forEach((btn) => {
				btn.addEventListener('click', () => {
					const tag = btn.dataset.tag;
					btns.forEach((b) => b.classList.remove('active'));
					btn.classList.add('active');

					links.forEach((link) => {
						const tags = JSON.parse(link.dataset.tags || '[]');
						link.style.display = !tag || tags.includes(tag) ? '' : 'none';
					});

					// 隐藏空分组，并让每组最后一条不显示顿号
					sections.forEach((sec) => {
						const visible = [...sec.querySelectorAll('.kb-link')].filter(
							(el) => el.style.display !== 'none'
						);
						visible.forEach((el, i) => el.classList.toggle('is-last', i === visible.length - 1));
						sec.style.display = visible.length ? '' : 'none';
					});
				});
			});
		});
	</script>
</BaseLayout>

<style is:global>
	/* 三栏容器：文章列表 220 + 目录 200 + 右栏正文，与子页面文字行宽一致 */
	/* 取消容器上下留白：侧栏 sticky 从导航下沿直接开始，滚动到顶部不再位移 */
	/* 双 class 提高优先级，覆盖 BaseLayout 中带作用域的 .container[data-astro-cid-*] 的 padding */
	.container.container { --content-width: 1600px; padding: 16px 20px 40px; }

	html {
		scroll-behavior: smooth;
	}
</style>

<style>
	.kb-layout {
		display: grid;
		grid-template-columns: 220px 200px 1fr;
		gap: 16px;
		margin: 0 auto;
		min-height: calc(100vh - 180px); /* 撑满一屏：100vh - 导航约 71px - 页脚约 109px */
	}

	/* 右栏正文：独立白卡，与左侧两块灰底区分 */
	.kb-content {
		min-width: 0;
		background: #ffffff;
		border: 1px solid #e5e6eb;
		border-radius: 6px;
		padding: 20px 24px;
		color: #1f2329;
	}

	.article-h1 {
		font-size: 28px;
		margin-bottom: 8px;
	}

	.kb-stats {
		font-size: 13px;
		color: var(--muted);
		margin-bottom: 24px;
		padding-bottom: 16px;
		border-bottom: 1px solid #e5e7eb;
	}

	/* 段落式文章列表：与关于页技能标签一致 */
	.kb-links {
		margin: 8px 0 24px;
		font-size: 15px;
		line-height: 1.9;
	}

	.kb-link {
		color: #2563eb;
		text-decoration: none;
	}

	.kb-link:hover {
		text-decoration: underline;
	}

	/* 条目之间用顿号分隔 */
	.kb-link:not(:last-child)::after {
		content: '、';
		color: var(--text);
	}

	/* 标签筛选后，每组最后一条不显示顿号 */
	.kb-link.is-last::after {
		content: '';
	}

	/* 标签栏 */
	.tag-bar {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin-bottom: 24px;
		align-items: center;
	}

	.tag-label {
		font-size: 13px;
		color: var(--muted);
	}

	.tag-btn {
		font-size: 13px;
		padding: 4px 10px;
		border-radius: 4px;
		background: #ececec;
		color: var(--text);
		cursor: pointer;
		border: none;
		transition: background 0.15s;
	}

	.tag-btn:hover {
		background: #e5dfd8;
	}

	.tag-btn.active {
		background: #d1d5db;
		font-weight: 600;
	}

	.tag-clear {
		background: transparent;
		color: var(--muted);
	}

	.tag-clear:hover {
		background: #ececec;
	}

	/* 响应式 */
	@media (max-width: 900px) {
		.kb-layout {
			grid-template-columns: 1fr;
			gap: 16px;
		}

		.kb-content {
			order: 2;
		}

		.card-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
