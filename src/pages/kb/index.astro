---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleBody from '../../components/ArticleBody.astro';
import ArticleList from '../../components/ArticleList.astro';
import Toc from '../../components/Toc.astro';

// 知识库首页：与文章详情页一致的三栏布局
// 左栏文章列表 / 中栏导读、管理方法、分组导航、待完善清单 / 右栏本页目录
const all = await getCollection('kb');
const groups = ['生活', '学校', '工作'].map((category) => ({
	category,
	items: all
		.filter((a) => a.data.category === category)
		.sort((a, b) => a.data.order - b.data.order),
}));

// 左栏组件数据：只取 id 与标题
const sidebarGroups = groups.map((g) => ({
	category: g.category,
	items: g.items.map((a) => ({ id: a.id, title: a.data.title })),
}));

// 待完善：正文仍是占位状态的条目
const pending = all.filter((a) => (a.body ?? '').trim() === '待补充。');

// 右栏目录
const toc = [
	{ id: '管理方法', text: '知识库管理方法' },
	...groups.map((g) => ({ id: g.category, text: g.category })),
	...(pending.length > 0 ? [{ id: '待完善', text: '待完善' }] : []),
];
---

<BaseLayout title="知识库 - 邹兆廷" description="个人知识库文章导航">
	<div class="kb-layout">
		<!-- 左栏：文章列表 -->
		<ArticleList groups={sidebarGroups} />

		<!-- 中栏：导读 + 管理方法 + 分组导航 + 待完善 -->
		<main class="kb-content">
			<h1 class="article-h1">知识库</h1>
			<p class="kb-stats">
				共 {all.length} 篇 · 生活 {groups[0].items.length} · 学校 {groups[1].items.length} · 工作 {groups[2].items.length}
			</p>

			<ArticleBody>
				<section>
					<h2 id="管理方法">知识库管理方法</h2>
					<h3>分类原则</h3>
					<p>
						固定三个分组，不再新增：生活放日常方法、习惯与收藏；学校放学生时代的功课笔记；工作放技术笔记与工作方法。新文章只归入其中一组。
					</p>
					<h3>条目管理</h3>
					<p>
						一个主题一个条目，标题用短语不用句子。内容还少时先合并进相关条目，长到能独立成篇时再拆分。占位条目先建骨架，内容逐步补充。
					</p>
					<h3>写作与维护</h3>
					<p>
						排版格式统一遵循<a href="/kb/writing-style/">写作排版规范</a>。新文章在 <code>src/content/kb/</code> 下新建
						.md 文件，frontmatter 写明标题、分组、摘要与排序号，首页导航与目录会自动生成。
					</p>
				</section>

				{
					groups.map((group) => (
						<section>
							<h2 id={group.category}>{group.category}</h2>
							<ul class="entry-list">
								{group.items.map((article) => (
									<li>
										<a href={`/kb/${article.id}/`} class="entry-title">
											{article.data.title}
										</a>
										<p class="entry-summary">{article.data.summary}</p>
									</li>
								))}
							</ul>
						</section>
					))
				}

				{
					pending.length > 0 && (
						<section>
							<h2 id="待完善">待完善</h2>
							<p>以下条目还是占位状态，内容待补充：</p>
							<ul class="entry-list">
								{pending.map((article) => (
									<li>
										<a href={`/kb/${article.id}/`} class="entry-title">
											{article.data.title}
										</a>
										<p class="entry-summary">{article.data.category}</p>
									</li>
								))}
							</ul>
						</section>
					)
				}
			</ArticleBody>
		</main>

		<!-- 右栏：本页目录 -->
		<Toc items={toc.map((t) => ({ href: `#${t.id}`, text: t.text }))} />
	</div>
</BaseLayout>

<style is:global>
	/* 三栏容器：侧栏 220 + 目录 200 + 中栏正文 680px，与子页面文字行宽一致 */
	.container { --content-width: 1200px; }

	html {
		scroll-behavior: smooth;
	}
</style>

<style>
	.kb-layout {
		display: grid;
		grid-template-columns: 220px 1fr 200px;
		gap: 30px;
		margin: 0 auto;
		padding: 32px 0;
	}

	/* 中栏 */
	.kb-content {
		min-width: 0;
	}

	.article-h1 {
		font-size: 28px;
		margin-bottom: 8px;
	}

	.kb-stats {
		font-size: 13px;
		color: var(--muted);
		margin-bottom: 24px;
		padding-bottom: 16px;
		border-bottom: 1px solid #e5e7eb;
	}

	/* 中栏内的分组导航条目（覆盖 ArticleBody 的通用 ul/a 样式） */
	.entry-list {
		list-style: none;
		padding: 0;
		margin: 8px 0 12px;
	}

	.entry-list li {
		margin-bottom: 14px;
	}

	.entry-title {
		font-size: 15px;
		font-weight: 600;
		color: var(--text);
		text-decoration: none;
	}

	.entry-title:hover {
		text-decoration: underline;
		text-decoration-color: #9ca3af;
		text-underline-offset: 2px;
	}

	.entry-summary {
		font-size: 14px;
		color: var(--muted);
		margin: 2px 0 0;
		line-height: 1.7;
	}

	/* 响应式 */
	@media (max-width: 900px) {
		.kb-layout {
			grid-template-columns: 1fr;
			gap: 16px;
		}

		.kb-content {
			order: 2;
		}
	}
</style>
