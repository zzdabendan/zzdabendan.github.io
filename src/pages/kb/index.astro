---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleBody from '../../components/ArticleBody.astro';
import ArticleList from '../../components/ArticleList.astro';
import Toc from '../../components/Toc.astro';
import SearchBox from '../../components/SearchBox.astro';

// 知识库首页：与文章详情页一致的三栏布局
// 左栏文章列表 / 中栏导读、管理方法、分组导航 / 右栏本页目录
const all = await getCollection('kb');
const groups = ['生活', '学校', '工作'].map((category) => ({
	category,
	items: all
		.filter((a) => a.data.category === category)
		.sort((a, b) => a.data.order - b.data.order),
}));

// 左栏组件数据：取 id、标题与组内序号（补零到两位，1 → 01）
const sidebarGroups = groups.map((g) => ({
	category: g.category,
	items: g.items.map((a, i) => ({
		id: a.id,
		title: a.data.title,
		no: String(i + 1).padStart(2, '0'),
	})),
}));

// 右栏目录
const toc = [
	...groups.map((g) => ({ id: g.category, text: g.category })),
	{ id: '管理方法', text: '知识库管理方法' },
];

// 收集全部标签（去重）
const allTags = [...new Set(all.flatMap((a) => a.data.tags ?? []))];
---

<BaseLayout title="知识库 - 邹兆廷" description="个人知识库文章导航">
	<div class="kb-layout">
		<!-- 左栏：文章列表 -->
		<ArticleList groups={sidebarGroups} />

		<!-- 中栏：导读 + 管理方法 + 分组导航 + 待完善 -->
			<main class="kb-content">
				<h1 class="article-h1">知识库</h1>
				<p class="kb-stats">
					共 {all.length} 篇 · 生活 {groups[0].items.length} · 学校 {groups[1].items.length} · 工作 {groups[2].items.length}
				</p>

				<SearchBox />

				{
					allTags.length > 0 && (
						<div class="tag-bar">
							<span class="tag-label">标签：</span>
							{allTags.map((tag) => (
								<button class="tag-btn" data-tag={tag}>
									{tag}
								</button>
							))}
							<button class="tag-btn tag-clear" data-tag="">全部</button>
						</div>
					)
				}

			<ArticleBody>
				{
					groups.map((group) => (
						<section data-group={group.category}>
							<h2 id={group.category}>{group.category}</h2>
							<div class="card-grid">
								{group.items.map((article, i) => (
									<a
										href={`/kb/${article.id}/`}
										class="card-item"
										data-tags={JSON.stringify(article.data.tags ?? [])}
									>
										<span class="card-no">{String(i + 1).padStart(2, '0')}</span>
										<span class="card-title">{article.data.title}</span>
									</a>
								))}
							</div>
						</section>
					))
				}

				<section>
					<h2 id="管理方法">知识库管理方法</h2>
					<h3>分类原则</h3>
					<p>
						固定三个分组，不再新增：生活放日常方法、习惯与收藏；学校放学生时代的功课笔记；工作放技术笔记与工作方法。新文章只归入其中一组。
					</p>
					<h3>条目管理</h3>
					<p>
						一个主题一个条目，标题用短语不用句子。内容还少时先合并进相关条目，长到能独立成篇时再拆分。占位条目先建骨架，内容逐步补充。
					</p>
					<h3>写作与维护</h3>
					<p>
						排版格式统一遵循<a href="/kb/writing-style/">写作排版规范</a>。新文章在 <code>src/content/kb/</code> 下新建
						.md 文件，frontmatter 写明标题、分组、摘要与排序号，首页导航与目录会自动生成。
					</p>
				</section>
			</ArticleBody>
		</main>

		<!-- 右栏：本页目录 -->
		<Toc items={toc.map((t) => ({ href: `#${t.id}`, text: t.text }))} />
	</div>

	<script is:inline>
		// 标签筛选：点击标签显示对应文章，点击"全部"恢复
		document.addEventListener('DOMContentLoaded', () => {
			const btns = document.querySelectorAll('.tag-btn');
			const cards = document.querySelectorAll('.card-item');
			const sections = document.querySelectorAll('section[data-group]');

			btns.forEach((btn) => {
				btn.addEventListener('click', () => {
					const tag = btn.dataset.tag;
					btns.forEach((b) => b.classList.remove('active'));
					btn.classList.add('active');

					cards.forEach((card) => {
						const tags = JSON.parse(card.dataset.tags || '[]');
						card.style.display = !tag || tags.includes(tag) ? '' : 'none';
					});

					// 隐藏空分组
					sections.forEach((sec) => {
						const hasVisible = [...sec.querySelectorAll('.card-item')].some(
							(c) => c.style.display !== 'none'
						);
						sec.style.display = hasVisible ? '' : 'none';
					});
				});
			});
		});
	</script>
</BaseLayout>

<style is:global>
	/* 三栏容器：侧栏 220 + 目录 200 + 中栏正文 680px，与子页面文字行宽一致 */
	.container { --content-width: 1200px; padding-top: 20px; }

	html {
		scroll-behavior: smooth;
	}
</style>

<style>
	.kb-layout {
		display: grid;
		grid-template-columns: 220px 1fr 200px;
		gap: 30px;
		margin: 0 auto;
		padding: 0 0 32px;
		min-height: calc(100vh - 166px); /* 撑满一屏：100vh - 导航 70px - 容器上下 padding 96px */
	}

	/* 中栏 */
	.kb-content {
		min-width: 0;
	}

	.article-h1 {
		font-size: 28px;
		margin-bottom: 8px;
	}

	.kb-stats {
		font-size: 13px;
		color: var(--muted);
		margin-bottom: 24px;
		padding-bottom: 16px;
		border-bottom: 1px solid #e5e7eb;
	}

	/* 卡片网格 */
	.card-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 12px;
		margin: 8px 0 24px;
	}

	.card-item {
		display: flex;
		align-items: center;
		gap: 8px;
		padding: 16px;
		border: 1px solid var(--line);
		border-radius: 6px;
		background: #ffffff;
		text-decoration: none;
		transition: border-color 0.15s, box-shadow 0.15s;
	}

	.card-no {
		font-size: 13px;
		color: var(--muted);
		font-variant-numeric: tabular-nums;
	}

	.card-item:hover {
		border-color: #9ca3af;
		box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
	}

	.card-title {
		font-size: 15px;
		font-weight: 600;
		color: var(--text);
	}

	/* 标签栏 */
	.tag-bar {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin-bottom: 24px;
		align-items: center;
	}

	.tag-label {
		font-size: 13px;
		color: var(--muted);
	}

	.tag-btn {
		font-size: 13px;
		padding: 4px 10px;
		border-radius: 4px;
		background: #f0ece5;
		color: var(--text);
		cursor: pointer;
		border: none;
		transition: background 0.15s;
	}

	.tag-btn:hover {
		background: #e5dfd8;
	}

	.tag-btn.active {
		background: #d1d5db;
		font-weight: 600;
	}

	.tag-clear {
		background: transparent;
		color: var(--muted);
	}

	.tag-clear:hover {
		background: #f0ece5;
	}

	/* 响应式 */
	@media (max-width: 900px) {
		.kb-layout {
			grid-template-columns: 1fr;
			gap: 16px;
		}

		.kb-content {
			order: 2;
		}

		.card-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
