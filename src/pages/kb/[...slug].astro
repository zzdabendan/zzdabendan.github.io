---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import VideoBili from '../../components/VideoBili.astro';
import ArticleBody from '../../components/ArticleBody.astro';
import ArticleList from '../../components/ArticleList.astro';
import Toc from '../../components/Toc.astro';

export async function getStaticPaths() {
	const entries = await getCollection('kb');
	return entries.map((entry) => ({
		params: { slug: entry.id },
		props: { entry },
	}));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);

// 左栏：全部文章按分组列出，当前篇高亮
const all = await getCollection('kb');
const sidebarGroups = ['生活', '学校', '工作'].map((category) => ({
	category,
	items: all
		.filter((a) => a.data.category === category)
		.sort((a, b) => a.data.order - b.data.order)
		.map((a) => ({ id: a.id, title: a.data.title })),
}));

// 右栏目录：构建时从 Markdown 标题生成，只取二三四级
const toc = headings
	.filter((h) => h.depth >= 2 && h.depth <= 4)
	.map((h) => ({ href: `#${h.slug}`, text: h.text, level: h.depth }));

// 阅读时间估算：中文字符数 ÷ 400（每分钟阅读字数）
const chineseChars = (entry.body ?? '').replace(/[^\u4e00-\u9fa5]/g, '').length;
const readMinutes = Math.max(1, Math.round(chineseChars / 400));
---

<BaseLayout title={`${entry.data.title} - 邹兆廷`} description={entry.data.summary}>
	<div class="kb-layout">
		<!-- 左栏：文章列表 -->
		<ArticleList groups={sidebarGroups} activeId={entry.id} />

		<!-- 中栏：文章内容 -->
		<main class="kb-content">
			{entry.data.video && <VideoBili bvid={entry.data.video} title={entry.data.title} cover={entry.data.cover} />}
			<h1 class="article-h1">{entry.data.title}</h1>
			<p class="article-summary">{entry.data.summary}</p>
				<p class="article-meta">约 {readMinutes} 分钟</p>
				<ArticleBody>
					<div data-pagefind-body>
						<Content />
					</div>
				</ArticleBody>
		</main>

		<!-- 右栏：文章结构目录 -->
		<Toc items={toc} />
	</div>
</BaseLayout>

<style is:global>
	/* 三栏容器：侧栏 220 + 目录 200 + 中栏正文 680px，与子页面文字行宽一致 */
	.container { --content-width: 1200px; padding-top: 20px; }

	html {
		scroll-behavior: smooth;
	}
</style>

<style>
	.kb-layout {
		display: grid;
		grid-template-columns: 220px 1fr 200px;
		gap: 30px;
		margin: 0 auto;
		padding: 0 0 32px;
		min-height: calc(100vh - 166px); /* 撑满一屏：100vh - 导航 70px - 容器上下 padding 96px */
	}

	/* 中栏 */
	.kb-content {
		min-width: 0;
	}

	.article-h1 {
		font-size: 28px;
		margin-bottom: 8px;
	}

	.article-summary {
		color: var(--muted);
		font-size: 15px;
		margin-bottom: 8px;
	}

	.article-meta {
		color: var(--muted);
		font-size: 13px;
		margin-bottom: 24px;
		padding-bottom: 16px;
		border-bottom: 1px solid #e5e7eb;
	}

	/* 响应式 */
	@media (max-width: 900px) {
		.kb-layout {
			grid-template-columns: 1fr;
			gap: 16px;
		}

		.kb-content {
			order: 2;
		}
	}
</style>
