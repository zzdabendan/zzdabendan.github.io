---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import VideoBili from '../../components/VideoBili.astro';
import AudioPlayer from '../../components/AudioPlayer.astro';
import ArticleBody from '../../components/ArticleBody.astro';
import ArticleList from '../../components/ArticleList.astro';
import Toc from '../../components/Toc.astro';

export async function getStaticPaths() {
	const entries = await getCollection('kb');
	return entries.map((entry) => ({
		params: { slug: entry.id },
		props: { entry },
	}));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);

// 左栏：全部文章按分组列出，当前篇高亮，组内序号从 1 开始
const all = await getCollection('kb');
const sidebarGroups = ['个人', '社会'].map((category) => ({
	category,
	items: all
		.filter((a) => a.data.category === category)
		.sort((a, b) => a.data.order - b.data.order)
		.map((a) => ({ id: a.id, title: a.data.title })),
}));

// 当前文章在所属分组中的序号（只用于文章页标题）
const currentGroup = sidebarGroups.find((g) => g.category === entry.data.category);
const currentIndex = currentGroup?.items.findIndex((a) => a.id === entry.id) ?? -1;
const entryNo = currentIndex >= 0 ? String(currentIndex + 1).padStart(2, '0') : '';

// 右栏目录：构建时从 Markdown 标题生成，只取二三四级
const toc = headings
	.filter((h) => h.depth >= 2 && h.depth <= 4)
	.map((h) => ({ href: `#${h.slug}`, text: h.text, level: h.depth }));

// 阅读时间估算：中文字符数 ÷ 400（每分钟阅读字数）
const chineseChars = (entry.body ?? '').replace(/[^\u4e00-\u9fa5]/g, '').length;
const readMinutes = Math.max(1, Math.round(chineseChars / 400));
---

<BaseLayout title={`${entry.data.title} - 邹兆廷`} description={entry.data.summary} paper={false}>
	<div class="kb-layout">
		<!-- 左栏：文章列表 -->
		<ArticleList groups={sidebarGroups} activeId={entry.id} />

		<!-- 中栏：文章结构目录 -->
		<Toc items={toc} />

		<!-- 右栏：文章内容 -->
		<main class="kb-content">
			{entry.data.video && <VideoBili bvid={entry.data.video} title={entry.data.title} cover={entry.data.cover} />}
			<h1 class="article-h1">{entryNo && `${entryNo}. `}{entry.data.title}</h1>
			<p class="article-summary">{entry.data.summary}</p>
				<p class="article-meta">约 {readMinutes} 分钟</p>
				{entry.data.audio && <AudioPlayer src={entry.data.audio} title={entry.data.audioTitle} />}
				<ArticleBody>
					<div data-pagefind-body>
						<Content />
					</div>
				</ArticleBody>
		</main>
	</div>
</BaseLayout>

<style is:global>
	/* 三栏容器：文章列表 220 + 目录 200 + 右栏正文，与子页面文字行宽一致 */
	/* 取消容器上下留白：侧栏 sticky 从导航下沿直接开始，滚动到顶部不再位移 */
	/* 双 class 提高优先级，覆盖 BaseLayout 中带作用域的 .container[data-astro-cid-*] 的 padding */
	.container.container { --content-width: 1600px; padding: 16px 20px 40px; }

	html {
		scroll-behavior: smooth;
	}

	/* 正文内视频容器：MDX 文章里用 <div class="kb-videos"> 包裹 VideoBili */
	.kb-videos {
		display: grid;
		gap: 16px;
		margin-bottom: 12px;
	}

	.kb-videos .bili-facade {
		margin-bottom: 0;
	}

	/* 四栏并列：人员组织 / 配置文档 / 物品清单 / 安全检查 */
	.kb-four-cols {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 24px;
		margin: 16px 0;
	}

	.kb-four-cols > div {
		min-width: 0;
	}

	.kb-four-cols h3 {
		margin-top: 0;
	}

	@media (max-width: 1100px) {
		.kb-four-cols {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 600px) {
		.kb-four-cols {
			grid-template-columns: 1fr;
		}
	}
</style>

<style>
	.kb-layout {
		display: grid;
		grid-template-columns: 220px 200px 1fr;
		gap: 30px;
		margin: 0 auto;
		min-height: calc(100vh - 180px); /* 撑满一屏：100vh - 导航约 71px - 页脚约 109px */
	}

	/* 右栏正文：独立白卡，与左侧两块灰底区分 */
	.kb-content {
		min-width: 0;
		background: #fdfdfd;
		border: 1px solid #e6e6e6;
		border-radius: 6px;
		padding: 20px 24px;
	}

	.article-h1 {
		font-size: 28px;
		margin-bottom: 8px;
	}

	.article-summary {
		color: var(--muted);
		font-size: 15px;
		margin-bottom: 8px;
	}

	.article-meta {
		color: var(--muted);
		font-size: 13px;
		margin-bottom: 24px;
		padding-bottom: 16px;
		border-bottom: 1px solid #e5e7eb;
	}

	/* 响应式 */
	@media (max-width: 900px) {
		.kb-layout {
			grid-template-columns: 1fr;
			gap: 16px;
		}

		.kb-content {
			order: 2;
		}
	}
</style>
