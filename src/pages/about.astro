<BaseLayout title="关于 - 邹兆廷" description="自我介绍、财务状况、物品清单与我的经历">
	<article class="about">
		<h1>关于</h1>

		<!-- 页内锚点：长页面快速跳转 -->
		<nav class="page-toc" aria-label="页内导航">
			<a href="#intro">自我介绍</a>
			<a href="#finance">财务</a>
			<a href="#belongings">物品</a>
			<a href="#timeline">我的经历</a>
		</nav>

		<div class="cols">
			<!-- 窄栏：活动地图 + 我的经历 -->
			<div class="col-side">
				<section class="card side-map">
					<h2>活动地图</h2>
					<div class="map-facade" data-points={JSON.stringify(mapPoints)}>
						<button class="map-open" type="button">点击加载活动地图</button>
					</div>
					<p class="map-note">坐标为大致位置，仅用于示意活动范围。</p>
				</section>

				<section class="card main-timeline" id="timeline">
					<h2>我的经历</h2>
					{
						timeline.map((group, i) => (
							<div class:list={['timeline-group', { tinted: i % 2 === 1 }]}>
								<h3 class="stage-title">{group.stage}</h3>
								{group.years.map((y) => (
									<div class="year-block">
										<h4 class="year-title">{y.year}</h4>
										<ul class="month-list">
											{y.months.map((m) => (
												<li>
													{m.month && <span class="month-label">{m.month}</span>}
													{m.events && <span class="month-events">{m.events}</span>}
												</li>
											))}
										</ul>
									</div>
								))}
							</div>
						))
					}
				</section>
			</div>

			<!-- 宽栏：自我介绍 + 联系方式 + 我的技能 + 财务 + 物品 -->
			<aside class="col-main">
				<!-- 自我介绍 -->
				<section class="card intro" id="intro">
					<img src="/avatar.svg" alt="个人头像" class="intro-avatar" width="120" height="120" />
					<h2>自我介绍</h2>
					<p class="intro-text">我是邹兆廷，25 岁，身高 163cm，体重 70kg，现居江西南昌。目前在湖南德沃信息技术有限公司担任运维专员，负责客服技术维护与客户服务。毕业于江西信息应用职业技术学院计算机网络技术专业，学过组网技术、Linux 系统、无线技术、Windows 系统、综合布线等课程。</p>
					<p class="intro-text">兴趣爱好是游戏、音乐、小说、电影、漫画、直播和写作。工作之外维护这个个人主页和个人知识库，记录生活方法、学校功课与工作运维笔记，也在写博客文章和每日感悟。目前关注的学习方向是个人成长。长期目标是坚持锻炼健身，保持健康的身体。</p>

					<h3 class="sub-title">联系方式</h3>
					<div class="contact-icons">
						{[...contacts, ...socialLinks].flatMap((c) =>
							c.items.map((item) => {
								return (
									<span class="contact-icon">
										{item.url ? (
											<a href={item.url} target="_blank" rel="noopener" title={c.label}>{c.label}</a>
										) : (
											<button type="button" title={c.label} data-value={item.value} onclick="navigator.clipboard.writeText(this.dataset.value);this.classList.add('copied');setTimeout(()=>this.classList.remove('copied'),1200)">{c.label}</button>
										)}
										<span class="contact-popover">
											<span class="contact-popover-label">{c.label}</span>
											<span class="contact-popover-value">{item.value}</span>
											{item.note && <span class="contact-popover-note">{item.note}</span>}
											<span class="contact-popover-tip">{item.url ? '点击跳转' : '点击复制'}</span>
										</span>
									</span>
								);
							})
						)}
					</div>

					<h3 class="sub-title">我的技能</h3>
					<h4 class="skill-group">技术运维</h4>
					<div class="tag-cloud">
						<span class="skill-tag">网络技术</span>
						<span class="skill-tag">Linux 系统</span>
						<span class="skill-tag">Windows 系统</span>
						<span class="skill-tag">无线技术</span>
						<span class="skill-tag">综合布线</span>
						<span class="skill-tag">装机维护</span>
						<span class="skill-tag">设备维修</span>
					</div>
					<h4 class="skill-group">办公与制作</h4>
					<div class="tag-cloud">
						<span class="skill-tag">表格</span>
						<span class="skill-tag">文档</span>
						<span class="skill-tag">演示</span>
						<span class="skill-tag">函数</span>
						<span class="skill-tag">视频剪辑</span>
						<span class="skill-tag">修图</span>
						<span class="skill-tag">设计</span>
						<span class="skill-tag">制图</span>
					</div>
					<h4 class="skill-group">表达与协作</h4>
					<div class="tag-cloud">
						<span class="skill-tag">编程</span>
						<span class="skill-tag">教学</span>
						<span class="skill-tag">翻译</span>
						<span class="skill-tag">演讲</span>
						<span class="skill-tag">客户服务</span>
					</div>
				</section>

				<!-- 物品清单：按分类多栏平铺 -->
				<section class="card belongings" id="belongings">
					<h2>物品</h2>
					<div class="categories">
						{categories.map((cat) => (
							<details class="category-details">
								<summary class="cat-title">{cat.name}<span class="cat-count">
									{cat.zones
										? cat.zones.reduce((s, z) => s + z.items.length, 0)
										: cat.items.length}
								</span></summary>
								<div class="category">

								{cat.zones ? (
									<div class="zone-list">
										{cat.zones.map((zone) => (
											<div class="zone">
												<h4 class="zone-title">{zone.name}<span class="zone-count">{zone.items.length}</span></h4>
												{zone.items.length > 0 ? (
													<ul class="item-list">
														{zone.items.map((item) => (
															<li>{item}</li>
														))}
													</ul>
												) : (
													<p class="zone-empty">待补充</p>
												)}
											</div>
										))}
									</div>
								) : (
									<ul class="item-list">
										{cat.items.map((item) => (
											<li>{item}</li>
										))}
									</ul>
								)}
								</div>
							</details>
						))}
					</div>
				</section>

				<!-- 财务：明细 + 场景问答 -->
				<section class="card finance" id="finance">
					<h2>财务</h2>

					<div class="detail-grid">
						<details class="detail-group tone-spend">
							<summary>固定花费（月 · {fixedTotal}）</summary>
							<ul>
								{fixedCost.items.map((r) => (
									<>
										<li><span>{r.label}</span><span class="num">{r.value}</span></li>
										{r.sub && (
											<li class="sub">
												<ul>
													{r.sub.map((s) => (
														<li>
															<span>{s.label}<em class="unit">{s.unit}</em></span>
															<span class="num">{s.value}</span>
														</li>
													))}
												</ul>
												{r.subNote && r.subNote.map((line) => (
													<p class="sub-note">{line}</p>
												))}
											</li>
										)}
									</>
								))}
							</ul>
						</details>
						<details class="detail-group tone-income">
							<summary>收入（月）</summary>
							<ul>
								{incomeRows.map((r) => (
									<li><span>{r.label}</span><span class="num">{r.value}</span></li>
								))}
							</ul>
						</details>
						<details class="detail-group tone-deposit">
							<summary>存款（存量 · {totalDeposit}）</summary>
							<ul>
								{depositRows.map((r) => (
									<>
										<li><span>{r.label}</span><span class="num">{r.value}</span></li>
										{r.sub && (
											<li class="sub">
												<ul>
													{r.sub.map((s) => (
														<li><span>{s.label}</span><span class="num">{s.value}</span></li>
													))}
												</ul>
											</li>
										)}
									</>
								))}
							</ul>
						</details>
						<details class="detail-group tone-debt">
							<summary>欠款（{totalDebt}）</summary>
							<ul>
								{debtRows.map((r) => (
									<li><span>{r.label}</span><span class="num">{r.value}</span></li>
								))}
							</ul>
						</details>
					</div>

					<!-- 场景1：财务血条 -->
					<details class="scene-details">
						<summary class="scene-q">我的钱是什么关系？</summary>
						<section class="scene">

						<!-- 血条积木：左=花费（灰底纯黑描边），右=月结余（深墨），轨道留内边距与空隙 -->
						<div class="hp">
							<div class="hp-track">
								<span class="hp-block hp-block-spend" style={`width:calc(${shellPct}% - 2px)`}></span>
								<span class="hp-block hp-block-rest" style={`width:calc(${restPct}% - 2px)`}></span>
							</div>
							<div class="hp-legend">
								<span class="lg-spend"><i class="box box-spend"></i>花费 {monthlySpend}</span>
								<span class="lg-income"><i class="box box-income"></i>收入 {totalIncome}</span>
								<span class="lg-deposit"><i class="box box-deposit"></i>月结余 {monthlyRest}</span>
							</div>
						</div>

						<ul class="scene-answers">
							<li class="tone-spend">我有多少花费？<b>{monthlySpend}/月</b><small>（最省组合，全外卖则 2852）</small></li>
							<li class="tone-income">我有多少收入？<b>{totalIncome}/月</b></li>
							<li class="tone-deposit">我有多少存款？<b>{totalDeposit}</b><small>（存量，月增 {monthlyRest}）</small></li>
							<li class="tone-debt">我有多少欠款？<b class={totalDebt === 0 ? 'zero' : ''}>{totalDebt}</b></li>
						</ul>
					</section>
					</details>

					<!-- 场景2：三餐方案 -->
					<details class="scene-details">
						<summary class="scene-q">三餐怎么吃最省？</summary>
						<section class="scene">
						<ul class="spend-bars">
							{mealPlans.map((p) => (
								<li class:list={['spend-bar-row', { best: p.best }]}>
									<span class="spend-tag">{p.tag}</span>
									<span class="spend-track">
										<span class="spend-fill" style={`width:${Math.round((p.amount / 2852) * 100)}%`}></span>
									</span>
									<span class="spend-amount">{p.amount}</span>
									{p.note && <span class="spend-note">{p.note}</span>}
								</li>
							))}
						</ul>

						<ul class="spend-tips">
							{savingTips.map((t) => (
								<li class:list={{ strong: t.strong }}>{t.text}</li>
							))}
						</ul>
					</section>
					</details>

					<!-- 场景3：出行方式对比 -->
					<details class="scene-details">
						<summary class="scene-q">出行怎么最省？（元 / 公里）</summary>
						<section class="scene">
						<ul class="spend-bars">
							{travelPlans.map((p) => (
								<li class:list={['spend-bar-row', { best: p.best }]}>
									<span class="spend-tag">{p.tag}</span>
									<span class="spend-track">
										<span class="spend-fill" style={`width:${Math.round((p.cost / travelMax) * 100)}%`}></span>
									</span>
									<span class="spend-amount">{p.cost}</span>
									{p.note && <span class="spend-note">{p.note}</span>}
