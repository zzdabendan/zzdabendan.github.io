---

<BaseLayout title="关于我 - 我的个人主页" description="个人简介、工作经历、教育经历、基本信息与个人经历">
	<article class="about">
		<h1>关于我</h1>

		
		<!-- 基本信息 -->
		<section class="card">
			<h2>基本信息</h2>
			<div class="info-grid">
				{
					basicInfo.map((item) => (
						<div class="info-row">
							<span class="info-label">{item.label}</span>
							<span class="info-value">{item.value}</span>
						</div>
					))
				}
			</div>
			<h3 class="sub-title">社交与站点</h3>
			<div class="info-grid">
				{
					socialLinks.map((item) => (
						<div class="info-row">
							<span class="info-label">{item.label}</span>
							{item.isLink ? (
								<a class="info-value" href={item.value} target="_blank" rel="noopener">
									{item.value}
								</a>
							) : (
								<span class="info-value">{item.value}</span>
							)}
						</div>
					))
				}
			</div>
		</section>

		<!-- 个人能力 -->
		<section class="card">
			<h2>个人能力</h2>
			<div class="ability-list">
				{
					abilities.map((ab) => (
						<div class="ability-item">
							<div class="ability-head">
								<span class="ability-name">{ab.name}</span>
								<span class="ability-dots">
									{Array.from({ length: 8 }).map((_, i) => (
										<span class:list={['dot', { filled: i < ab.filled }]}></span>
									))}
								</span>
								<span class="ability-percent">{ab.percent}</span>
							</div>
							<div class="ability-groups">
								{ab.groups.map((g) => (
									<div class="ability-group">
										<span class="group-title">{g.title}</span>
										<div class="tag-cloud">
											{g.tags.map((t) => (
												<span class="skill-tag">{t}</span>
											))}
										</div>
									</div>
								))}
							</div>
						</div>
					))
				}
			</div>
		</section>

		<!-- 个人简介（求职意向） -->
		<section class="card">
			<h2>个人简介</h2>
			<div class="info-grid">
				{
					jobIntention.map((item) => (
						<div class="info-row">
							<span class="info-label">{item.label}</span>
							<span class="info-value">{item.value}</span>
						</div>
					))
				}
			</div>
		</section>

		<!-- 工作经历 -->
		<section class="card">
			<h2>工作经历</h2>
			<div class="timeline-list">
				{
					workExperience.map((job) => (
						<div class="job-entry">
							<h3 class="job-title">{job.period} · {job.industry} · {job.company} · {job.role}</h3>
							<p class="job-sub">工作内容</p>
							<p class="job-detail">{job.duties}</p>
						</div>
					))
				}
			</div>
		</section>

		<!-- 教育经历 -->
		<section class="card">
			<h2>教育经历</h2>
			<div class="timeline-list">
				{
					education.map((edu) => (
						<div class="job-entry">
							<h3 class="job-title">{edu.period} · {edu.school} · {edu.major}</h3>
							<p class="job-sub">专科课程</p>
							<p class="job-detail">{edu.courses}</p>
						</div>
					))
				}
			</div>
		</section>


		<!-- 个人经历时间线 -->
		<section class="card">
			<h2>个人经历</h2>
			{
				timeline.map((group) => (
					<div class="timeline-group">
						<h3 class="stage-title">{group.stage}</h3>
						{group.years.map((y) => (
							<div class="year-block">
								<h4 class="year-title">{y.year}</h4>
								<ul class="month-list">
									{y.months.map((m) => (
										<li>
											{m.month && <span class="month-label">{m.month}</span>}
											{m.events && <span class="month-events">{m.events}</span>}
										</li>
									))}
								</ul>
							</div>
						))}
					</div>
				))
			}
		</section>

		<p class="back-link"><a href="/">← 返回首页</a></p>
	</article>
</BaseLayout>

<style>
	.about {
		padding-top: 16px;
	}

	h1 {
		font-size: 32px;
		margin-bottom: 24px;
	}

	.card {
		background: #fff;
		border: 1px solid var(--line);
		border-radius: 4px;
		padding: 24px;
		margin-bottom: 24px;
	}

	/* 二级标题：各板块，和知识库 h2 一致 */
	.card h2 {
		font-size: 20px;
		font-weight: 700;
		margin: 0 0 16px;
		padding-bottom: 6px;
		border-bottom: 2px solid #555555;
	}

	/* 三级标题：子板块，和知识库 h3 一致 */
	.sub-title {
		font-size: 15px;
		font-weight: 600;
		margin: 20px 0 12px;
		padding: 2px 8px;
		background: #d1d5db;
		border-radius: 4px;
		display: inline-block;
	}

	/* 个人能力 */
	.ability-list {
		display: flex;
		flex-direction: column;
		gap: 24px;
	}

	.ability-item {
		padding-bottom: 20px;
		border-bottom: 1px dashed #e5e7eb;
	}

	.ability-item:last-child {
		padding-bottom: 0;
		border-bottom: none;
	}

	.ability-head {
		display: flex;
		align-items: center;
		gap: 12px;
		margin-bottom: 12px;
	}

	.ability-name {
		font-size: 16px;
		font-weight: 700;
		color: #111111;
		min-width: 72px;
	}

	.ability-dots {
		display: inline-flex;
		gap: 4px;
		letter-spacing: 0;
	}

	.dot {
		width: 10px;
		height: 10px;
		border-radius: 50%;
		border: 1.5px solid #bbbbbb;
		background: transparent;
		display: inline-block;
	}

	.dot.filled {
		background: #111111;
		border-color: #111111;
	}

	.ability-percent {
		margin-left: auto;
		font-size: 14px;
		font-weight: 600;
		color: var(--muted);
	}

	.ability-groups {
		display: flex;
		flex-direction: column;
		gap: 10px;
	}

	.ability-group {
		display: flex;
		gap: 12px;
		align-items: flex-start;
	}

	.group-title {
		flex-shrink: 0;
		width: 72px;
		font-size: 13px;
		color: var(--muted);
		line-height: 26px;
	}

	.tag-cloud {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
		flex: 1;
	}

	.skill-tag {
		font-size: 13px;
		line-height: 1;
		padding: 5px 10px;
		border-radius: 2px;
		border: 1px solid #dddddd;
		background: #fafafa;
		color: #444444;
		white-space: nowrap;
	}

	/* 信息网格 */
	.info-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 10px 24px;
	}

	.info-row {
		display: flex;
		gap: 8px;
		font-size: 15px;
		line-height: 2;
	}

	.info-label {
		color: var(--muted);
		white-space: nowrap;
		min-width: 70px;
	}

	.info-value {
		color: var(--text);
		word-break: break-all;
	}

	/* 工作/教育经历列表 */
	.timeline-list {
		display: flex;
		flex-direction: column;
		gap: 20px;
	}

	.job-entry {
		padding-bottom: 16px;
		border-bottom: 1px dashed #e5e7eb;
	}

	.job-entry:last-child {
		padding-bottom: 0;
