---

<BaseLayout title="关于我 - 我的个人主页" description="个人简介、工作经历、教育经历、基本信息与个人经历">
	<article class="about">
		<h1>关于我</h1>

		<!-- 个人简介（求职意向） -->
		<section class="card">
			<h2>个人简介</h2>
			<div class="info-grid">
				{
					jobIntention.map((item) => (
						<div class="info-row">
							<span class="info-label">{item.label}</span>
							<span class="info-value">{item.value}</span>
						</div>
					))
				}
			</div>
		</section>

		<!-- 工作经历 -->
		<section class="card">
			<h2>工作经历</h2>
			<div class="timeline-list">
				{
					workExperience.map((job) => (
						<div class="timeline-item">
							<div class="timeline-period">{job.period}</div>
							<div class="timeline-body">
								<h3>
									<span class="tag">{job.industry}</span>
									{job.role}
								</h3>
								<p class="company">{job.company}</p>
								<p class="duties">工作内容：{job.duties}</p>
							</div>
						</div>
					))
				}
			</div>
		</section>

		<!-- 教育经历 -->
		<section class="card">
			<h2>教育经历</h2>
			<div class="timeline-list">
				{
					education.map((edu) => (
						<div class="timeline-item">
							<div class="timeline-period">{edu.period}</div>
							<div class="timeline-body">
								<h3>{edu.school}</h3>
								<p class="major">专业：{edu.major}</p>
								<p class="duties">专科课程：{edu.courses}</p>
							</div>
						</div>
					))
				}
			</div>
		</section>

		<!-- 基本信息 -->
		<section class="card">
			<h2>基本信息</h2>
			<div class="info-grid">
				{
					basicInfo.map((item) => (
						<div class="info-row">
							<span class="info-label">{item.label}</span>
							<span class="info-value">{item.value}</span>
						</div>
					))
				}
			</div>
			<h3 class="sub-title">社交与站点</h3>
			<div class="info-grid">
				{
					socialLinks.map((item) => (
						<div class="info-row">
							<span class="info-label">{item.label}</span>
							{item.isLink ? (
								<a class="info-value" href={item.value} target="_blank" rel="noopener">
									{item.value}
								</a>
							) : (
								<span class="info-value">{item.value}</span>
							)}
						</div>
					))
				}
			</div>
		</section>

		<!-- 个人经历时间线 -->
		<section class="card">
			<h2>个人经历</h2>
			{
				timeline.map((group) => (
					<div class="timeline-group">
						<h3 class="stage-title">{group.stage}</h3>
						{group.items.length > 0 && group.items.every((i) => i.event !== '') ? (
							<ul class="event-list">
								{group.items.map((item) => (
									<li>
										<span class="event-date">{item.date}</span>
										{item.event && <span class="event-text"> — {item.event}</span>}
									</li>
								))}
							</ul>
						) : (
							<ul class="event-list">
								{group.items.map((item) => (
									<li>
										<span class="event-date">{item.date}</span>
										{item.event && <span class="event-text"> — {item.event}</span>}
									</li>
								))}
							</ul>
						)}
					</div>
				))
			}
		</section>

		<p class="back-link"><a href="/">← 返回首页</a></p>
	</article>
</BaseLayout>

<style>
	.about {
		padding-top: 16px;
	}

	h1 {
		font-size: 32px;
		margin-bottom: 24px;
	}

	.card {
		background: #fff;
		border: 1px solid #e5e7eb;
		border-radius: 12px;
		padding: 24px;
		margin-bottom: 24px;
	}

	.card h2 {
		font-size: 20px;
		margin-bottom: 16px;
		padding-bottom: 8px;
		border-bottom: 2px solid var(--accent);
	}

	.sub-title {
		font-size: 16px;
		margin-top: 20px;
		margin-bottom: 12px;
		color: var(--muted);
	}

	/* 信息网格 */
	.info-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 10px 24px;
	}

	.info-row {
		display: flex;
		gap: 8px;
		font-size: 15px;
		line-height: 2;
	}

	.info-label {
		color: var(--muted);
		white-space: nowrap;
		min-width: 70px;
	}

	.info-value {
		color: var(--text);
		word-break: break-all;
	}

	/* 时间线列表 */
	.timeline-list {
		display: flex;
		flex-direction: column;
		gap: 20px;
	}

	.timeline-item {
		display: flex;
		gap: 16px;
	}

	.timeline-period {
		min-width: 180px;
		font-size: 14px;
		color: var(--muted);
		padding-top: 2px;
		flex-shrink: 0;
	}

	.timeline-body h3 {
		font-size: 16px;
		margin-bottom: 4px;
		display: flex;
		align-items: center;
		gap: 8px;
	}

	.tag {
		font-size: 12px;
		padding: 2px 8px;
		border-radius: 4px;
		background: #f3e8ff;
		color: var(--accent);
	}

	.company {
		font-size: 14px;
		color: var(--muted);
		margin-bottom: 4px;
	}

	.duties {
		font-size: 14px;
		color: var(--text);
	}

	/* 个人经历 */
	.timeline-group {
		margin-bottom: 24px;
	}

	.stage-title {
		font-size: 16px;
		color: var(--accent);
		margin-bottom: 12px;
		padding-left: 12px;
		border-left: 3px solid var(--accent);
	}

	.event-list {
		list-style: none;
		padding-left: 0;
	}

	.event-list li {
		font-size: 14px;
		line-height: 2.2;
		padding-left: 12px;
		position: relative;
	}

	.event-list li::before {
		content: '·';
		position: absolute;
		left: 0;
		color: var(--accent);
		font-weight: bold;
	}

	.event-date {
		color: var(--muted);
		font-weight: 500;
	}

	.event-text {
		color: var(--text);
	}

	.back-link {
		text-align: center;
		margin-top: 32px;
		font-size: 15px;
	}

	@media (max-width: 600px) {
		.info-grid {
			grid-template-columns: 1fr;
		}

		.timeline-item {
			flex-direction: column;
			gap: 4px;
		}

		.timeline-period {
			min-width: auto;
		}
	}
</style>
