<BaseLayout title="关于 - 邹兆廷" description="自我介绍、我的技能与我的经历">
	<article>
		<h1>关于</h1>

		<!-- 自我介绍（文档式） -->
		<section class="card">
			<h2>自我介绍</h2>
			<p class="intro-text">我是邹兆廷，25 岁，身高 163cm，体重 70kg，现居江西南昌。目前在湖南德沃信息技术有限公司担任运维专员，负责客服技术维护与客户服务。</p>
			<p class="intro-text">毕业于江西信息应用职业技术学院计算机网络技术专业，学过组网技术、Linux 系统、无线技术、Windows 系统、综合布线等课程。</p>
			<p class="intro-text">兴趣爱好是游戏、音乐、小说、电影、漫画、直播和写作。</p>
			<p class="intro-text">工作之外维护这个个人主页和个人知识库，记录生活方法、学校功课与工作运维笔记，也在写博客文章和每日感悟。目前关注的学习方向是个人成长。</p>
			<p class="intro-text">长期目标是坚持锻炼健身，保持健康的身体。</p>

			<h3 class="sub-title">联系方式</h3>
			<div class="contact-list">
				{
					contacts.map((c) => (
						<div class="contact-row">
							<span class="contact-label">{c.label}</span>
							<div class="contact-values">
								{c.items.map((item) => (
									<span>
										{item.url ? (
											<a href={item.url} target="_blank" rel="noopener">
												{item.value}
											</a>
										) : (
											item.value
										)}
										{item.note && <span class="contact-note">（{item.note}）</span>}
									</span>
								))}
							</div>
						</div>
					))
				}
				{
					socialLinks.map((c) => (
						<div class="contact-row">
							<span class="contact-label">{c.label}</span>
							<div class="contact-values">
								{c.items.map((item) => (
									<span>
										{item.url ? (
											<a href={item.url} target="_blank" rel="noopener">
												{item.value}
											</a>
										) : (
											item.value
										)}
										{item.note && <span class="contact-note">（{item.note}）</span>}
									</span>
								))}
							</div>
						</div>
					))
				}
			</div>
		</section>

		<!-- 活动地图 -->
		<section class="card">
			<h2>活动地图</h2>
			<div class="map-facade" data-points={JSON.stringify(mapPoints)}>
				<button class="map-open" type="button">点击加载活动地图</button>
			</div>
			<p class="map-note">坐标为大致位置，仅用于示意活动范围。</p>
		</section>

		<!-- 我的技能 -->
		<section class="card">
			<h2>我的技能</h2>
			<h3 class="sub-title">技术运维</h3>
			<div class="tag-cloud">
				<span class="skill-tag">网络技术</span>
				<span class="skill-tag">Linux 系统</span>
				<span class="skill-tag">Windows 系统</span>
				<span class="skill-tag">无线技术</span>
				<span class="skill-tag">综合布线</span>
				<span class="skill-tag">装机维护</span>
				<span class="skill-tag">设备维修</span>
			</div>
			<h3 class="sub-title">办公与制作</h3>
			<div class="tag-cloud">
				<span class="skill-tag">表格</span>
				<span class="skill-tag">文档</span>
				<span class="skill-tag">演示</span>
				<span class="skill-tag">函数</span>
				<span class="skill-tag">视频剪辑</span>
				<span class="skill-tag">修图</span>
				<span class="skill-tag">设计</span>
				<span class="skill-tag">制图</span>
			</div>
			<h3 class="sub-title">表达与协作</h3>
			<div class="tag-cloud">
				<span class="skill-tag">编程</span>
				<span class="skill-tag">教学</span>
				<span class="skill-tag">翻译</span>
				<span class="skill-tag">演讲</span>
				<span class="skill-tag">客户服务</span>
			</div>
		</section>

		<!-- 我的经历时间线 -->
		<section class="card">
			<h2>我的经历</h2>
			{
				timeline.map((group) => (
					<div class="timeline-group">
						<h3 class="stage-title">{group.stage}</h3>
						{group.years.map((y) => (
							<div class="year-block">
								<h4 class="year-title">{y.year}</h4>
								<ul class="month-list">
									{y.months.map((m) => (
										<li>
											{m.month && <span class="month-label">{m.month}</span>}
											{m.events && <span class="month-events">{m.events}</span>}
										</li>
									))}
								</ul>
							</div>
						))}
					</div>
				))
			}
		</section>

		<p class="back-link"><a href="/">← 返回首页</a></p>
	</article>
</BaseLayout>

<script is:inline>
	// 点击后再加载 Leaflet，避免首屏加载第三方资源
	document.querySelectorAll('.map-facade').forEach((box) => {
		const trigger = box.querySelector('.map-open');
		if (!trigger) return;

		trigger.addEventListener('click', () => {
			trigger.textContent = '地图加载中…';

			const css = document.createElement('link');
			css.rel = 'stylesheet';
			css.href = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.css';
			document.head.appendChild(css);

			const script = document.createElement('script');
			script.src = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.js';
			script.onload = () => {
				const points = JSON.parse(box.dataset.points || '[]');
				box.replaceChildren();

				const canvas = document.createElement('div');
				canvas.style.height = '420px';
				canvas.style.borderRadius = '3px';
				box.appendChild(canvas);

				const map = L.map(canvas, { scrollWheelZoom: false }).setView([28.6825, 115.8917], 11);
				L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
					maxZoom: 18,
					attribution: '© OpenStreetMap contributors',
				}).addTo(map);

				const bounds = [];
				points.forEach((p) => {
					L.marker([p.lat, p.lng])
						.addTo(map)
						.bindPopup(`<strong>${p.name}</strong><br>${p.desc}`);
					bounds.push([p.lat, p.lng]);
				});

				if (bounds.length > 1) {
					map.fitBounds(bounds, { padding: [30, 30] });
				}
			};
			script.onerror = () => {
				trigger.textContent = '地图加载失败，请检查网络后重试';
			};
			document.head.appendChild(script);
		});
	});
</script>

