<script is:inline>
	// WGS-84 转 GCJ-02：高德瓦片用国测局坐标，直接叠加会偏移几百米
	function wgs84ToGcj02(lat, lng) {
		const a = 6378245.0;
		const ee = 0.00669342162296594323;

		const outOfChina = lng < 72.004 || lng > 137.8347 || lat < 0.8293 || lat > 55.8271;
		if (outOfChina) return [lat, lng];

		const transformLat = (x, y) => {
			let ret = -100.0 + 2.0 * x + 3.0 * y + 0.2 * y * y + 0.1 * x * y + 0.2 * Math.sqrt(Math.abs(x));
			ret += ((20.0 * Math.sin(6.0 * x * Math.PI) + 20.0 * Math.sin(2.0 * x * Math.PI)) * 2.0) / 3.0;
			ret += ((20.0 * Math.sin(y * Math.PI) + 40.0 * Math.sin((y / 3.0) * Math.PI)) * 2.0) / 3.0;
			ret += ((160.0 * Math.sin((y / 12.0) * Math.PI) + 320 * Math.sin((y * Math.PI) / 30.0)) * 2.0) / 3.0;
			return ret;
		};

		const transformLng = (x, y) => {
			let ret = 300.0 + x + 2.0 * y + 0.1 * x * x + 0.1 * x * y + 0.1 * Math.sqrt(Math.abs(x));
			ret += ((20.0 * Math.sin(6.0 * x * Math.PI) + 20.0 * Math.sin(2.0 * x * Math.PI)) * 2.0) / 3.0;
			ret += ((20.0 * Math.sin(x * Math.PI) + 40.0 * Math.sin((x / 3.0) * Math.PI)) * 2.0) / 3.0;
			ret += ((150.0 * Math.sin((x / 12.0) * Math.PI) + 300.0 * Math.sin((x / 30.0) * Math.PI)) * 2.0) / 3.0;
			return ret;
		};

		let dLat = transformLat(lng - 105.0, lat - 35.0);
		let dLng = transformLng(lng - 105.0, lat - 35.0);
		const radLat = (lat / 180.0) * Math.PI;
		let magic = Math.sin(radLat);
		magic = 1 - ee * magic * magic;
		const sqrtMagic = Math.sqrt(magic);
		dLat = (dLat * 180.0) / (((a * (1 - ee)) / (magic * sqrtMagic)) * Math.PI);
		dLng = (dLng * 180.0) / ((a / sqrtMagic) * Math.cos(radLat) * Math.PI);
		return [lat + dLat, lng + dLng];
	}

	// 点击后再加载 Leaflet，避免首屏加载第三方资源
	document.querySelectorAll('.map-facade').forEach((box) => {
		const trigger = box.querySelector('.map-open');
		if (!trigger) return;

		trigger.addEventListener('click', () => {
			trigger.textContent = '地图加载中…';

			const css = document.createElement('link');
			css.rel = 'stylesheet';
			css.href = '/vendor/leaflet/leaflet.css';
			document.head.appendChild(css);

			const script = document.createElement('script');
			script.src = '/vendor/leaflet/leaflet.js';
			script.onload = () => {
				const points = JSON.parse(box.dataset.points || '[]');
				box.classList.add('is-open');
				box.replaceChildren();

				const canvas = document.createElement('div');
				canvas.style.width = '100%';
				canvas.style.height = '260px';
				canvas.style.borderRadius = '3px';
				box.appendChild(canvas);

				const map = L.map(canvas, { scrollWheelZoom: false }).setView([28.6825, 115.8917], 11);
				const markerLayer = L.layerGroup().addTo(map);
				let useGcj = true;

				const drawMarkers = () => {
					markerLayer.clearLayers();
					const bounds = [];
					points.forEach((p) => {
						// 点位按 WGS-84 记录，高德瓦片需转 GCJ-02
						const [lat, lng] = useGcj ? wgs84ToGcj02(p.lat, p.lng) : [p.lat, p.lng];
						L.marker([lat, lng])
							.addTo(markerLayer)
							.bindPopup(`<strong>${p.name}</strong><br>${p.desc}`);
						bounds.push([lat, lng]);
					});
					if (bounds.length > 1) {
						map.fitBounds(bounds, { padding: [30, 30] });
					}
				};

				// 高德瓦片：国内访问稳定，坐标系为 GCJ-02
				const tile = L.tileLayer(
					'https://webrd0{s}.is.autonavi.com/appmaptile?lang=zh_cn&size=1&scale=1&style=8&x={x}&y={y}&z={z}',
					{ subdomains: '1234', maxZoom: 18, attribution: '© 高德地图' }
				).addTo(map);

				// 高德瓦片若被拦截或返回空白，自动回退到 OSM（WGS-84 坐标）
				let fallback = false;
				tile.on('tileerror', () => {
					if (fallback) return;
					fallback = true;
					map.removeLayer(tile);
					useGcj = false;
					L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
						maxZoom: 18,
						attribution: '© OpenStreetMap contributors',
					}).addTo(map);
					drawMarkers();
				});

				drawMarkers();
			};
			script.onerror = () => {
				trigger.textContent = '地图加载失败，请检查网络后重试';
			};
			document.head.appendChild(script);
		});
	});
</script>

