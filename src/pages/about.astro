// 物品条目形如「名称（数值）」，拆成名称与数值两段，与存款行统一为左右两栏
const splitItem = (raw) => {
	const end = raw.lastIndexOf('（');
	if (end > 0 && raw.endsWith('）')) {
		return { name: raw.slice(0, end), value: raw.slice(end + 1, -1) };
	}
	return { name: raw, value: '' };
};
