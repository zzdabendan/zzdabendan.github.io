---
// ① 代码栅栏：这里可以接收页面传进来的参数（Props）
import Nav from '../components/Nav.astro';

interface Props {
	title?: string;
	description?: string;
	/** 首页等通栏页面：不加纸张卡片，保持白底整屏 */
	bare?: boolean;
}

// 给 title 和 description 设置默认值
const { title = '邹兆廷 - 个人主页', description = '邹兆廷的个人主页，基于 Astro 构建。', bare = false } = Astro.props;
---

<!-- ② HTML 模板：每个页面共用的“外壳” -->
<!doctype html>
<html lang="zh-CN">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Noto+Sans+SC:wght@400;500;700&family=Noto+Serif+SC:wght@400;600&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
	</head>
	<body class:list={[{ bare }]}>
		<Nav />
		<!-- slot 是“占位符”：各页面的内容会被放到这里 -->
		<main class:list={['container', { bare }]}>
			{bare ? <slot /> : <div class="paper"><slot /></div>}
		</main>
		<footer class="site-footer">
			<div class="footer-map" aria-hidden="true">
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1000 500" preserveAspectRatio="xMidYMid slice">
					<g stroke="#9ca3af" stroke-width="1" fill="#e5e7eb">
						<!-- 北美洲 -->
						<path d="M 150 130 Q 200 90 260 100 Q 300 120 320 170 Q 300 230 260 250 Q 200 240 170 190 Z"/>
						<!-- 格陵兰 -->
						<path d="M 280 60 Q 320 50 340 80 Q 330 120 300 110 Z"/>
						<!-- 南美洲 -->
						<path d="M 240 290 Q 280 270 300 310 Q 320 380 280 430 Q 240 410 230 350 Z"/>
						<!-- 非洲 -->
						<path d="M 460 200 Q 520 180 560 220 Q 580 290 540 360 Q 480 380 440 320 Z"/>
						<!-- 欧洲 -->
						<path d="M 460 110 Q 510 90 550 120 Q 560 170 520 190 Q 470 180 450 150 Z"/>
						<!-- 亚洲 -->
						<path d="M 580 90 Q 680 60 800 80 Q 880 110 860 190 Q 830 260 730 240 Q 630 220 590 160 Z"/>
						<!-- 大洋洲 -->
						<path d="M 800 340 Q 860 320 900 360 Q 910 410 860 430 Q 810 410 800 360 Z"/>
						<!-- 东南亚群岛 -->
						<circle cx="780" cy="300" r="8"/>
						<circle cx="810" cy="320" r="6"/>
						<circle cx="760" cy="330" r="7"/>
						<!-- 日本 -->
						<path d="M 860 180 Q 870 200 860 220 Q 850 200 860 180 Z"/>
						<!-- 英国 -->
						<path d="M 460 100 Q 470 90 480 100 Q 475 115 465 110 Z"/>
					</g>
				</svg>
			</div>
			<p>© 2026 邹兆廷 · 使用 Astro 构建</p>
			<div class="beian">
				<a href="https://beian.miit.gov.cn/" target="_blank" rel="noopener noreferrer">赣ICP备2026004967号-1</a>
				<a href="https://beian.mps.gov.cn/#/query/webSearch?code=36011102001239" target="_blank" rel="noopener noreferrer">
					<img width="17" height="17" src="/beian.png" alt="公安备案图标" />
					赣公网安备36011102001239号
				</a>
			</div>
		</footer>
	</body>
</html>

<!-- ③ 全局基础样式（is:global 表示不做作用域隔离，对所有页面生效） -->
<style is:global>
	:root {
		--accent: #111111; /* 朴素纸张风：主色为墨黑 */
		--text: #333333;
		--muted: #888888;
		--line: #e6e6e6; /* 细分隔线 */
		--content-width: 720px; /* 正文阅读宽度，宽布局页面自行覆盖 */
	}

	* {
		box-sizing: border-box;
		margin: 0;
	}

	/* 裁掉 100vw 通栏元素因滚动条宽度产生的横向溢出（clip 不产生滚动容器，不影响 sticky） */
	html {
		overflow-x: clip;
	}

	body {
		font-family:
			'Noto Sans SC', 'PingFang SC', 'Microsoft YaHei', system-ui, -apple-system, sans-serif;
		color: var(--text);
		line-height: 1.7;
		background: #f0f0f0; /* 淡灰底：子页面内容像白纸浮在上面 */
	}

	/* 首页等通栏页面：保持纯白整屏，不受纸张风影响 */
	body.bare {
		background: #ffffff;
	}

	h1, h2, h3, h4, h5, h6,
	p, li, td, th, blockquote,
	input, textarea, select, button {
		font-family: inherit;
	}

	a {
		color: var(--text);
		text-decoration: none;
	}

	/* 页面标题（子页面 h1）：全站统一字号与下间距 */
	h1 {
		font-size: 28px;
		margin-bottom: 32px;
	}
</style>

<!-- 布局自身的样式仍然保持作用域隔离 -->
<style>
	.container {
		max-width: var(--content-width, 720px);
		margin: 0 auto;
		padding: 28px 20px 56px;
		min-height: calc(100vh - 120px);
	}

	/* 首页等通栏页面沿用原来的上下留白 */
	.container.bare {
		padding: 48px 20px;
	}

	/* 纸张卡片：淡灰背景上的一张白纸，内容全部在纸内 */
	.paper {
		background: #ffffff;
		border: 1px solid #e4e4e4;
		border-radius: 3px;
		box-shadow:
			0 1px 2px rgba(0, 0, 0, 0.04),
			0 10px 28px rgba(0, 0, 0, 0.05);
		padding: 44px 48px;
	}

	.site-footer {
		position: relative;
		overflow: hidden;
		text-align: center;
		color: var(--muted);
		font-size: 13px;
		padding: 28px 20px;
		background: #f0f0f0; /* 页脚与页面底色一致，让白纸更突出 */
		border-top: 1px solid var(--line);
	}

	/* 世界地图背景：铺满页脚裁切显示，正文浮在其上 */
	.footer-map {
		position: absolute;
		inset: 0;
		pointer-events: none;
	}

	.footer-map svg {
		width: 100%;
		height: 100%;
		display: block;
		opacity: 0.4;
	}

	.site-footer p,
	.site-footer .beian {
		position: relative;
	}

	.beian {
		display: flex;
		justify-content: center;
		flex-wrap: wrap;
		gap: 8px 24px;
		margin-top: 8px;
	}

	.beian a {
		display: inline-flex;
		align-items: center;
		gap: 4px;
		color: var(--muted);
	}

	.beian a:hover {
		color: var(--accent);
	}

	/* 手机端：纸张铺满两侧，内边距收紧 */
	@media (max-width: 700px) {
		.container {
			padding: 12px 10px 32px;
		}

		.paper {
			padding: 24px 18px;
		}
	}
</style>
