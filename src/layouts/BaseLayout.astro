---
// ① 代码栅栏：这里可以接收页面传进来的参数（Props）
import Nav from '../components/Nav.astro';

interface Props {
	title?: string;
	description?: string;
	/** 首页等通栏页面：不加纸张卡片，保持白底整屏 */
	bare?: boolean;
	/** 分栏页面：去掉外层白纸，由各栏目自带底色 */
	paper?: boolean;
}

// 给 title 和 description 设置默认值
const {
	title = '邹兆廷 - 个人主页',
	description = '邹兆廷的个人主页，基于 Astro 构建。',
	bare = false,
	paper = true,
} = Astro.props;
---

<!-- ② HTML 模板：每个页面共用的“外壳” -->
<!doctype html>
<html lang="zh-CN">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Noto+Sans+SC:wght@400;500;700&family=Noto+Serif+SC:wght@400;600&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
	</head>
	<body class:list={[{ bare }]}>
		<Nav />
		<!-- slot 是“占位符”：各页面的内容会被放到这里 -->
		<main class:list={['container', { bare }]}>
			{bare || !paper ? <slot /> : <div class="paper"><slot /></div>}
		</main>
		<footer class="site-footer">
			<p>© 2026 邹兆廷 · 使用 Astro 构建</p>
			<div class="beian">
				<a href="https://beian.miit.gov.cn/" target="_blank" rel="noopener noreferrer">赣ICP备2026004967号-1</a>
				<a href="https://beian.mps.gov.cn/#/query/webSearch?code=36011102001239" target="_blank" rel="noopener noreferrer">
					<img width="17" height="17" src="/beian.png" alt="公安备案图标" />
					赣公网安备36011102001239号
				</a>
			</div>
		</footer>
	</body>
</html>

<!-- ③ 全局基础样式（is:global 表示不做作用域隔离，对所有页面生效） -->
<style is:global>
	:root {
		--accent: #111111; /* 朴素纸张风：主色为墨黑 */
		--text: #333333;
		--muted: #888888;
		--line: #e6e6e6; /* 细分隔线 */
		--bg-page: #f4f4f4; /* 页面底色：衬托纸面 */
		--surface: #ffffff; /* 纸面、正文 */
		--surface-header: #e9e9e9; /* 页头：比纸面深一档，形成分区 */
		--surface-muted: #f7f7f7; /* 列表等次级栏目底 */
		--surface-soft: #fafafa; /* 目录等更轻的栏目底 */
		--content-width: 720px; /* 正文阅读宽度，宽布局页面自行覆盖 */
	}

	* {
		box-sizing: border-box;
		margin: 0;
	}

	/* 裁掉 100vw 通栏元素因滚动条宽度产生的横向溢出（clip 不产生滚动容器，不影响 sticky） */
	html {
		overflow-x: clip;
	}

	body {
		font-family:
			'Noto Sans SC', 'PingFang SC', 'Microsoft YaHei', system-ui, -apple-system, sans-serif;
		color: var(--text);
		line-height: 1.7;
		background: var(--bg-page); /* 淡灰底：子页面内容像白纸浮在上面 */
	}

	/* 首页等通栏页面：保持纯白整屏，不受纸张风影响 */
	body.bare {
		background: var(--surface);
	}

	h1, h2, h3, h4, h5, h6,
	p, li, td, th, blockquote,
	input, textarea, select, button {
		font-family: inherit;
	}

	a {
		color: var(--text);
		text-decoration: none;
	}

	/* 页面标题（子页面 h1）：全站统一字号与下间距 */
	h1 {
		font-size: 28px;
		margin-bottom: 32px;
	}
</style>

<!-- 布局自身的样式仍然保持作用域隔离 -->
<style>
	.container {
		max-width: var(--content-width, 720px);
		margin: 0 auto;
		padding: 28px 20px 56px;
		min-height: calc(100vh - 120px);
	}

	/* 首页等通栏页面沿用原来的上下留白 */
	.container.bare {
		padding: 48px 20px;
	}

	/* 纸张卡片：淡灰背景上的一张白纸，内容全部在纸内 */
	.paper {
		background: var(--surface);
		border: 1px solid #e8e8e8;
		border-radius: 6px;
		box-shadow: 0 1px 2px rgba(0, 0, 0, 0.03);
		padding: 44px 48px;
	}

	/* 页脚：与页面同色，仅用一条上边框收尾，避免与正文争夺注意力 */
	.site-footer {
		text-align: center;
		color: var(--muted);
		font-size: 13px;
		padding: 28px 20px;
		background: var(--bg-page);
		border-top: 1px solid var(--line);
	}

	.beian {
		display: flex;
		justify-content: center;
		flex-wrap: wrap;
		gap: 8px 24px;
		margin-top: 8px;
	}

	.beian a {
		display: inline-flex;
		align-items: center;
		gap: 4px;
		color: var(--muted);
	}

	.beian a:hover {
		color: var(--accent);
	}

	/* 手机端：纸张铺满两侧，内边距收紧 */
	@media (max-width: 700px) {
		.container {
			padding: 12px 10px 32px;
		}

		.paper {
			padding: 24px 18px;
		}
	}
</style>
