---
// ① 代码栅栏：这里可以接收页面传进来的参数（Props）
import Nav from '../components/Nav.astro';

interface Props {
	title?: string;
	description?: string;
}

// 给 title 和 description 设置默认值
const { title = '我的个人主页', description = '这是我的个人主页，基于 Astro 构建。' } = Astro.props;
---

<!-- ② HTML 模板：每个页面共用的“外壳” -->
<!doctype html>
<html lang="zh-CN">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<Nav />
		<!-- slot 是“占位符”：各页面的内容会被放到这里 -->
		<main class="container">
			<slot />
		</main>
		<footer class="site-footer">
			<p>© 2026 我的个人主页 · 使用 Astro 构建</p>
		</footer>
	</body>
</html>

<!-- ③ 全局基础样式（is:global 表示不做作用域隔离，对所有页面生效） -->
<style is:global>
	:root {
		--accent: #6d28d9; /* 主题色，改这一处就能换整站配色 */
		--text: #1f2937;
		--muted: #6b7280;
		--content-width: 720px; /* 默认内容宽度，宽布局页面可覆盖 */
	}

	* {
		box-sizing: border-box;
		margin: 0;
	}

	body {
		font-family:
			'PingFang SC', 'Microsoft YaHei', system-ui, -apple-system, sans-serif;
		color: var(--text);
		line-height: 1.7;
		background: #fafaf9;
	}

	a {
		color: var(--accent);
		text-decoration: none;
	}
</style>

<!-- 布局自身的样式仍然保持作用域隔离 -->
<style>
	.container {
		max-width: var(--content-width, 720px);
		margin: 0 auto;
		padding: 48px 20px;
		min-height: calc(100vh - 120px);
	}

	.site-footer {
		text-align: center;
		color: var(--muted);
		font-size: 14px;
		padding: 24px 20px;
		border-top: 1px solid #e5e7eb;
	}
</style>
