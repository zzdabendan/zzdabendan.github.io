---
// 搜索组件：基于 pagefind 的静态搜索
// 构建后运行 `npx pagefind --site dist` 生成索引
// dev 模式下 pagefind 不存在，显示占位提示
const isDev = import.meta.env.DEV;
---

{isDev ? (
	<div class="search-wrap">
		<div class="search-placeholder">
			<span class="search-icon">🔍</span>
			搜索功能在构建后可用
		</div>
	</div>
) : (
	<div class="search-wrap">
		<div id="search"></div>
	</div>
	<link href="/pagefind/pagefind-ui.css" rel="stylesheet">
	<script src="/pagefind/pagefind-ui.js" defer></script>
	<script is:inline>
		window.addEventListener('DOMContentLoaded', () => {
			if (typeof PagefindUI === 'undefined') return;
			new PagefindUI({
				element: '#search',
				showSubResults: true,
				showImages: false,
				translations: {
					placeholder: '搜索知识库文章…',
					clear_search: '清除',
					load_more: '加载更多',
					search_label: '搜索',
					filters_label: '筛选',
					zero_results: '未找到相关内容',
					many_results: '找到 [COUNT] 个结果',
					one_result: '找到 1 个结果',
					alt_search: '未找到，显示相关结果',
				},
			});
		});
	</script>
)}

<style>
	.search-wrap {
		margin-bottom: 24px;
	}

	.search-placeholder {
		display: flex;
		align-items: center;
		gap: 8px;
		padding: 12px 16px;
		border: 1px solid var(--line);
		border-radius: 6px;
		background: #ffffff;
		color: var(--muted);
		font-size: 14px;
	}

	.search-icon {
		font-size: 16px;
	}
</style>
