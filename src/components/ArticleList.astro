---
// 知识库左栏：按分组列出全部文章，分组默认全部展开，传入 activeId 时高亮当前篇
interface Props {
	groups: { category: string; items: { id: string; title: string }[] }[];
	activeId?: string;
}

const { groups, activeId } = Astro.props;
---

<aside class="kb-sidebar" aria-label="文章列表">
	<ul class="article-list">
		{
			groups.map((group) => (
				<li class="article-group">
					<details open>
						<summary class="article-group-title">
							<span class="group-name">{group.category}</span>
							<span class="group-count">{group.items.length}</span>
						</summary>
						<ul class="article-sublist">
							{group.items.map((article) => (
								<li>
									<a
										href={`/kb/${article.id}/`}
										class:list={['article-link', { active: article.id === activeId }]}
									>
										{article.title}
									</a>
								</li>
							))}
						</ul>
					</details>
				</li>
			))
		}
	</ul>
</aside>

<style>
	/* 不限制高度：列表按内容自然撑开，随页面一起滚动 */
	.kb-sidebar {
		align-self: start;
		background: var(--surface-muted, #f7f7f7);
		border: 1px solid var(--line, #e6e6e6);
		border-radius: 6px;
		padding: 8px;
	}

	.article-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 2px;
	}

	/* 分组：无底色小标题，点击折叠 */
	.article-group-title {
		display: flex;
		align-items: baseline;
		gap: 6px;
		padding: 10px 6px 6px;
		font-size: 13px;
		font-weight: 600;
		color: #6b7280;
		cursor: pointer;
		list-style: none;
		user-select: none;
	}

	.article-group-title::-webkit-details-marker {
		display: none;
	}

	/* 折叠指示：收起时向右，展开时向下 */
	.article-group-title::before {
		content: '▸';
		font-size: 10px;
		color: #9ca3af;
		transition: transform 0.15s;
	}

	details[open] > .article-group-title::before {
		transform: rotate(90deg);
	}

	.group-count {
		font-size: 12px;
		font-weight: 400;
		color: #9ca3af;
		font-variant-numeric: tabular-nums;
	}

	.article-sublist {
		list-style: none;
		margin: 0 0 4px;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 1px;
	}

	/* 条目：相对分组缩进，形成父子层级 */
	.article-link {
		position: relative;
		display: block;
		padding: 7px 12px 7px 24px;
		border-radius: 6px;
		font-size: 15px;
		line-height: 1.4;
		color: var(--text);
		transition: background 0.15s;
	}

	.article-link:hover {
		background: #ececec;
	}

	/* 当前篇：左侧黑条 + 加粗，比底色更明确 */
	.article-link.active {
		background: #e8e8e8;
		font-weight: 600;
	}

	.article-link.active::before {
		content: '';
		position: absolute;
		left: 10px;
		top: 50%;
		transform: translateY(-50%);
		width: 2px;
		height: 14px;
		border-radius: 1px;
		background: #111111;
	}

	/* 窄屏：单列排在正文之前 */
	@media (max-width: 900px) {
		.kb-sidebar {
			order: 1;
		}
	}
</style>
