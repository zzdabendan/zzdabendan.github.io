---
// 知识库左栏：按分组列出全部文章，传入 activeId 时高亮当前篇并只展开所在分组
interface Props {
	groups: { category: string; items: { id: string; title: string }[] }[];
	activeId?: string;
}

const { groups, activeId } = Astro.props;

// 当前文章所在分组：默认展开它，其余分组折叠
const activeGroup = groups.find((g) => g.items.some((a) => a.id === activeId))?.category;
---

<aside class="kb-sidebar" aria-label="文章列表">
	<ul class="article-list">
		{
			groups.map((group) => (
				<li class="article-group">
					<details open={!activeId || group.category === activeGroup}>
						<summary class="article-group-title">
							<span class="group-name">{group.category}</span>
							<span class="group-count">{group.items.length}</span>
						</summary>
						<ul class="article-sublist">
							{group.items.map((article) => (
								<li>
									<a
										href={`/kb/${article.id}/`}
										class:list={['article-link', { active: article.id === activeId }]}
									>
										{article.title}
									</a>
								</li>
							))}
						</ul>
					</details>
				</li>
			))
		}
	</ul>
</aside>

<style>
	.kb-sidebar {
		position: sticky;
		top: 70px; /* 与导航高度对齐，避免滚动起始时出现位移 */
		align-self: start;
		/* 高度上限预留页脚（约 109px）与底部留白（20px） */
		max-height: calc(100vh - 199px);
		overflow-y: auto;
		background: #f2f2f2;
		border-radius: 6px;
		padding: 8px;
		scrollbar-width: thin;
		scrollbar-color: #d1d5db transparent;
	}

	/* 细滚动条：Chrome / Edge */
	.kb-sidebar::-webkit-scrollbar {
		width: 6px;
	}

	.kb-sidebar::-webkit-scrollbar-thumb {
		background: #d1d5db;
		border-radius: 3px;
	}

	.kb-sidebar::-webkit-scrollbar-track {
		background: transparent;
	}

	.article-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 2px;
	}

	/* 分组：无底色小标题，点击折叠 */
	.article-group-title {
		display: flex;
		align-items: baseline;
		gap: 6px;
		padding: 10px 6px 6px;
		font-size: 13px;
		font-weight: 600;
		color: #6b7280;
		cursor: pointer;
		list-style: none;
		user-select: none;
	}

	.article-group-title::-webkit-details-marker {
		display: none;
	}

	/* 折叠指示：收起时向右，展开时向下 */
	.article-group-title::before {
		content: '▸';
		font-size: 10px;
		color: #9ca3af;
		transition: transform 0.15s;
	}

	details[open] > .article-group-title::before {
		transform: rotate(90deg);
	}

	.group-count {
		font-size: 12px;
		font-weight: 400;
		color: #9ca3af;
		font-variant-numeric: tabular-nums;
	}

	.article-sublist {
		list-style: none;
		margin: 0 0 4px;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 1px;
	}

	/* 条目：相对分组缩进，形成父子层级 */
	.article-link {
		position: relative;
		display: block;
		padding: 7px 12px 7px 24px;
		border-radius: 6px;
		font-size: 15px;
		line-height: 1.4;
		color: var(--text);
		transition: background 0.15s;
	}

	.article-link:hover {
		background: #ececec;
	}

	/* 当前篇：左侧黑条 + 加粗，比底色更明确 */
	.article-link.active {
		background: #e8e8e8;
		font-weight: 600;
	}

	.article-link.active::before {
		content: '';
		position: absolute;
		left: 10px;
		top: 50%;
		transform: translateY(-50%);
		width: 2px;
		height: 14px;
		border-radius: 1px;
		background: #111111;
	}

	/* 窄屏：回到文档流，取消内部滚动 */
	@media (max-width: 900px) {
		.kb-sidebar {
			position: static;
			max-height: none;
			overflow-y: visible;
			order: 1;
		}
	}
</style>
