---
// 知识库右栏：章节目录，level 决定缩进层级（2 平铺、3 缩进 30px、4 缩进 48px）
interface Props {
	items: { href: string; text: string; level?: number }[];
}

const { items } = Astro.props;
---

<aside class="kb-toc">
	<h2 class="kb-toc-title">目录</h2>
	<ul class="toc-list">
		{
			items.map((item) => (
				<li>
					<a href={item.href} class={`toc-h${item.level ?? 2}`}>{item.text}</a>
				</li>
			))
		}
	</ul>
</aside>

<style>
	.kb-toc {
		position: sticky;
		top: 70px;
		align-self: start;
		max-height: calc(100vh - 94px);
		overflow-y: auto;
		scrollbar-width: none;
	}

	.kb-toc::-webkit-scrollbar {
		display: none;
	}

	.kb-toc-title {
		font-size: 15px;
		margin-bottom: 12px;
		color: #666666;
	}

	.toc-list {
		list-style: none;
		padding: 0;
		border-left: 2px solid #e5e7eb;
	}

	.toc-list a {
		display: block;
		font-size: 13px;
		color: #555555;
		padding: 4px 12px;
		margin-left: -2px;
		border-left: 2px solid transparent;
		transition: all 0.15s;
	}

	.toc-list a:hover {
		color: #111111;
		border-left-color: #111111;
	}

	.toc-list a.toc-h3 {
		padding-left: 30px;
		font-size: 12px;
	}

	.toc-list a.toc-h4 {
		padding-left: 48px;
		font-size: 12px;
		color: #777777;
	}

	/* 窄屏：回到文档流 */
	@media (max-width: 900px) {
		.kb-toc {
			position: static;
			max-height: none;
			overflow-y: visible;
			order: 3;
		}
	}
</style>
